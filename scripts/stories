#!/usr/bin/env bash
# Runs the stories: the relay starts on this machine, the stories run in the capped dev container and reach the
# journal through it, and the relay stops with the run, whatever ends it.
#
#   scripts/stories                 every story
#   scripts/stories ./stories/workers/ -run TestAFreshWorktree
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

[ -x "$root/.journal/bin/journal" ] || { echo "stories need this project's journal at .journal/bin/journal" >&2; exit 1; }

scratch="$(mktemp -d)"
port_file="$scratch/port"
python3 -I story/relay.py "$root" "$port_file" &
relay=$!
trap 'kill "$relay" 2>/dev/null; wait "$relay" 2>/dev/null; rm -rf "$scratch"' EXIT

for _ in $(seq 50); do
    [ -s "$port_file" ] && break
    sleep 0.1
done
[ -s "$port_file" ] || { echo "the story relay did not start" >&2; exit 1; }

packages=("${@:-./stories/...}")
scripts/dev env STORY_RELAY="host.docker.internal:$(cat "$port_file")" STORY_PROJECT="$root" \
    GOMEMLIMIT=3GiB GOMAXPROCS=2 go test -tags story -p 1 -count=1 "${packages[@]}"
