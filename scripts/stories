#!/usr/bin/env bash
# Runs the stories: the relay starts on this machine, the stories run in the capped dev container and reach the
# journal through it, and the relay stops with the run, whatever ends it.
#
#   scripts/stories                 every story
#   scripts/stories ./stories/workers/ -run TestAFreshWorktree
#   scripts/stories --tiny ./stories/edits/ -run TestAnEdit     on the tiny project scripts/story-lab builds
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

# A worker's worktree has no journal of its own: the journal belongs to the project, the folder above the shared .git.
project="$(cd "$(git rev-parse --git-common-dir)/.." && pwd -P)"

if [ "${1:-}" = --tiny ]; then
    shift
    project="$root/bin/story-lab"
    unset JOURNAL_ENV AGENT_JOURNAL_ACTIVE JOURNAL_AGENT_SESSION JOURNAL_LAUNCH JOURNAL_PROCESS JOURNAL_RUNNER_PROCESS
fi

[ -x "$project/.journal/bin/journal" ] || { echo "stories need a journal at $project/.journal/bin/journal; for --tiny, run scripts/story-lab" >&2; exit 1; }

export JOURNAL_HOME="$project/.journal"

scratch="$(mktemp -d "${TMPDIR:-/tmp}/stories.XXXXXX")"
port_file="$scratch/port"
python3 -I story/relay.py "$project" "$port_file" &
relay=$!
trap 'kill "$relay" 2>/dev/null; wait "$relay" 2>/dev/null; rm -rf "$scratch"' EXIT

for _ in $(seq 50); do
    [ -s "$port_file" ] && break
    sleep 0.1
done
[ -s "$port_file" ] || { echo "the story relay did not start" >&2; exit 1; }

packages=("${@:-./stories/...}")
mounts=()
case "$project/" in
    "$root"/*) ;;
    *) mounts=(--mount "$project") ;;
esac

chosen=.
previous=
for argument in "${packages[@]}"; do
    case "$argument" in -run=*) chosen=${argument#-run=} ;; esac
    [ "$previous" = -run ] && chosen=$argument
    previous=$argument
done

total=$(scripts/dev ${mounts[@]+"${mounts[@]}"} go test -tags story -list "$chosen" "${packages[@]}" | grep -c '^Test')
echo "running $total stories"

scripts/dev ${mounts[@]+"${mounts[@]}"} env STORY_RELAY="host.docker.internal:$(cat "$port_file")" STORY_PROJECT="$project" STORY_BINARY="${STORY_BINARY:-}" \
    GOMEMLIMIT=3GiB GOMAXPROCS=2 go test -v -tags story -p 1 -count=1 -timeout 120m "${packages[@]}" |
    awk -v total="$total" '{ print; fflush() } /^--- (PASS|FAIL|SKIP): Test/ { done++; printf "story %d/%d\n", done, total; fflush() }'
exit "${PIPESTATUS[0]}"
