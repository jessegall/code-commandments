#!/usr/bin/env bash
# Runs the tests of the packages named, in the capped dev container, and says how far along it is: `-list` says how
# many tests there are before any of them runs, `-v` says a line as each one ends, and this prefixes those lines
# with the count, so a card watching a long run shows a bar instead of sitting silent until a whole package ends.
# It ends by naming how many ran and how many failed. Scoped by argument on purpose: the whole tree is a release
# gate, never a habit.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd -P)"
cd "$root"

if [ "$#" -eq 0 ]; then
    echo "scripts/tested: name the packages to test, such as scripts/tested ./cli/hooks/ ./cli/git/" >&2
    exit 2
fi

exec scripts/dev bash -c '
    total=$(go test -list . "$@" 2>/dev/null | grep -c "^\(Test\|Example\|Fuzz\)" || true)
    finished=0
    failed=0
    status=0

    # A subtest prints its own `---` line, indented, so only the unindented ones are counted: those are the tests
    # `-list` counted. The run goes through a process substitution and not a pipe, so the counts belong to this
    # shell and the last line can tell the whole story.
    while IFS= read -r line; do
        case "$line" in
            "go-test-status:"*)
                status=${line#go-test-status:}
                ;;
            "--- PASS: "*|"--- SKIP: "*|"--- FAIL: "*)
                finished=$((finished + 1))
                case "$line" in
                    "--- FAIL: "*) failed=$((failed + 1)) ;;
                esac
                printf "%s/%s tests %s\n" "$finished" "$total" "$line"
                ;;
            *)
                printf "%s\n" "$line"
                ;;
        esac
    done < <(env GOMEMLIMIT=3GiB GOMAXPROCS=2 go test -v -p 2 -parallel 2 "$@" 2>&1; echo "go-test-status:$?")

    printf "%s tests, %s failed\n" "$finished" "$failed"

    exit "$status"
' tested "$@"
