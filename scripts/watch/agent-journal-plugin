#!/bin/sh
# Whether the code-commandments plugin in the agent-journal project is answering, not merely running.
journal=/Users/jessegall/projects/agent-journal/.journal
plugin=$journal/plugins/code-commandments
data=$journal/plugin-data/code-commandments

if [ ! -d "$plugin" ]; then
    echo "the plugin is not installed in agent-journal, so there is nothing to answer for"
    exit 0
fi

version=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$plugin/journal-plugin.json" | head -1)

# A plugin the journal has switched off runs no service by design, so there is nothing here to answer for: the
# journal starts a service only for a plugin it has enabled, and the switch back on is the person's, never ours.
# Reported as a dead service, it sent a reader hunting our own binary every ten minutes for a switch in the
# journal's viewer. Its own rule switches it off when the three files it digests look changed, and an upgrade
# saving that digest after a hook had already compared it is enough to do that with nothing really changed.
# The row is read from the newest database the journal keeps, since the live one is named for its version.
for db in $(ls -t "$journal"/version-*.db "$journal"/journal.db 2>/dev/null); do
    enabled=$(sqlite3 "file:$db?mode=ro" "select enabled from plugins where name = 'code-commandments'" 2>/dev/null)
    [ -n "$enabled" ] && break
done

if [ "$enabled" = "0" ]; then
    echo "plugin $version is switched off in agent-journal's journal, so it runs no service and no edit there is judged: it is switched on again in the journal's viewer, under Settings, Plugins"
    exit 0
fi

# The process is matched by the plugin's own folder and the binary alone, never by the verb or the exact path it
# was launched with: the journal launches it from .journal-plugin/../bin and the verb is the protocol's own
# (plugin-hook today, journal4-hook before it, journal-serve before it), so naming either made this check report a fault that was not
# there while the service judged every edit.
# Looked for twice, because the journal restarts its plugins' services and a look that lands in the gap is no
# fault: a single absence used to report a dead service while the next second had it serving again.
serving=""
for look in 1 2; do
    if pgrep -f "agent-journal/.journal/plugins/code-commandments/.*commandments-release" >/dev/null; then
        serving="yes"
        break
    fi
    [ "$look" = 1 ] && sleep 3
done

if [ -z "$serving" ]; then
    echo "the hook service of plugin $version is not running, so no edit there is judged"
    exit 1
fi

# A service that has been restarted says so by warming again, and the failures before that warm are history. So
# only what a service wrote SINCE its last warm says whether it is answering now.
for log in "$data"/*.log; do
    [ -f "$log" ] || continue
    since=$(awk '/is warm:/ { kept = ""; next } { kept = kept $0 "\n" } END { printf "%s", kept }' "$log")
    if printf '%s' "$since" | grep -q "broken pipe"; then
        echo "$(basename "$log") holds unanswered requests since its bridge last warmed: the service is not replacing a bridge that has gone"
        exit 1
    fi
done

echo "plugin $version is up and every service has answered since it last warmed"
