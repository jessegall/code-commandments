#!/usr/bin/env bash
# Builds the tiny project a story can be debugged on: a few files under a journal of their own with this checkout's
# plugin, so a run waits on milliseconds of judging and not on this repository's tree. Run it again to refresh the plugin.
#
#   scripts/story-lab
#   scripts/stories --tiny ./stories/edits/ -run TestAnEdit
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
lab="$root/bin/story-lab"
journal_source="${JOURNAL_SOURCE:-$(cd "$root/.." && pwd -P)/agent-journal}"

export JOURNAL_HOME="$lab/.journal"
unset JOURNAL_ENV AGENT_JOURNAL_ACTIVE JOURNAL_AGENT_SESSION JOURNAL_LAUNCH JOURNAL_PROCESS JOURNAL_RUNNER_PROCESS

[ -f "$journal_source/install.sh" ] || { echo "no journal source at $journal_source: set JOURNAL_SOURCE" >&2; exit 1; }

if [ ! -d "$lab/.git" ]; then
    mkdir -p "$lab"
    cp -R "$root/stories/tiny/." "$lab/"
    git -C "$lab" init -q -b main
    git -C "$lab" add -A
    git -C "$lab" -c user.name=stories -c user.email=stories@localhost commit -q -m "The tiny project"
fi

cp -R "$root/stories/tiny/.commandments/." "$lab/.commandments/"

if [ ! -x "$lab/.journal/bin/journal" ]; then
    (cd "$lab" && sh "$journal_source/install.sh")
fi

bash "$root/scripts/plugin-local"
plugin="$root/bin/plugin-local/plugin"
journal="$lab/.journal/bin/journal"

if (cd "$lab" && "$journal" plugin list) | grep -q code-commandments; then
    (cd "$lab" && "$journal" plugin upgrade code-commandments --from "$plugin" --yes --reason "the tiny project follows this checkout")
else
    (cd "$lab" && "$journal" plugin install "$plugin" --yes --reason "the tiny project runs this checkout's plugin")
fi

(cd "$lab" && "$journal" plugin configure code-commandments judge_workers true --reason "the stories of workers, hand-ins and merges need workers judged, and a fresh install judges none")

(cd "$lab" && "$journal" plugin configure code-commandments judge_hand_ins true --reason "the stories of hand-ins read what a hand-in is told")

(cd "$lab" && "$journal" plugin configure code-commandments judge_merges true --reason "the stories of merges read what a merge brings in")

(cd "$lab" && "$journal" plugin configure code-commandments judge_worker_edits true --reason "a story's agents are workers, and the stories read what they are told")

(cd "$lab" && "$journal" plugin configure code-commandments judge_edit_window 1 --reason "a story waits on what it is told, so the window for gathering edits stays short")

checkout="$lab/.journal/worktrees/story-engine"
[ -d "$checkout" ] || git -C "$lab" worktree add -q -b story-engine/spike "$checkout"

if ! (cd "$lab" && "$journal" environment list) | grep -q story-engine; then
    (cd "$lab" && "$journal" environment make story-engine "$checkout" --branch story-engine/spike --test --reason "the stories run in an environment of their own")
fi

echo "ready: scripts/stories --tiny ./stories/<category>/ -run TestName"
