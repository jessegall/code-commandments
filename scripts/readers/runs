#!/bin/sh
# What a long run wrote as it went: each step it finished, the errors that stopped it, and the line it ends on.
#
# A line that names the run's result is kept to that result: the sync line says what was published and then
# which agents read it, which is true and not news, so the card shows the first clause and the output behind
# it keeps the rest. Any line still over 110 characters is cut there.
grep -E 'regenerated|written|^↻|^✓|^⚠|rror|^#|panic:|cannot|refus|[0-9]+/[0-9]+ ' \
  | sed -E 's/^(↻ [^,]*), read by .*$/\1/' \
  | cut -c1-110
