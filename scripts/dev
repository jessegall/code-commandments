#!/usr/bin/env bash
# Runs one command in the capped dev container: scripts/dev go test ./cli/...
# --mount <path> (repeatable, before the command) also mounts a folder outside the checkout, read-only at its
# own path: scripts/dev --mount ../some-app go run ./engine/frontend/parity ../some-app
#
# The machine enforces the cap (3 GB, no swap, 2 CPUs); GOMEMLIMIT is only a target inside it, set per process
# at 1200MiB so the two a go test -p 2 runs feel the GC's pressure well before the kernel kills.
# The checkout is mounted at its own path, so the paths the Roslyn bridge hands to the host's
# docker (through the mounted socket) resolve there too: COMMANDMENTS_ROSLYN=docker runs the C# bridge in its capped
# image, never .NET in the dev container or on the host. Go's module and build caches live in
# named volumes shared by every checkout, so only the first run is slow; every other cache (the Python
# bridge's venv among them) has a volume per image, so it never outlives the interpreter it was built by.
set -euo pipefail

memory=3g
cpus=2

fail() {
    echo "scripts/dev: $*" >&2
    exit 1
}

extra=()
while [ $# -gt 0 ] && [ "$1" = --mount ]; do
    [ $# -gt 1 ] && [ -d "$2" ] || fail "--mount needs a folder, not '${2:-}'"
    folder=$(cd "$2" && pwd -P)
    extra+=(-v "$folder:$folder:ro")
    shift 2
done

[ $# -gt 0 ] || fail "usage: scripts/dev [--mount <path>]... <command> [args...]   e.g. scripts/dev go test ./cli/..."
command -v docker > /dev/null || fail "docker is not installed; agent Go runs happen only in the capped dev container"
docker info > /dev/null 2>&1 || fail "docker is not running; start it — there is no host fallback"

here=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
root=$(git -C "$here" rev-parse --show-toplevel)
common=$(cd "$root" && cd "$(git rev-parse --git-common-dir)" && pwd -P)
cwd=$(pwd -P)

case "$cwd/" in
    "$root"/*) ;;
    *) fail "run it from inside the checkout ($root), not $cwd" ;;
esac

mypy=$(tr -d '[:space:]' < "$root/bridge/mypy/requirements.txt")
tag=$({ cat "$root/docker/dev/Dockerfile"; echo "$mypy"; } | shasum -a 256 | cut -c1-16)
image="code-commandments/dev:$tag"

if ! docker image inspect "$image" > /dev/null 2>&1; then
    echo "scripts/dev: building $image (once per change to docker/dev/Dockerfile)" >&2
    docker build --quiet --build-arg MYPY="$mypy" -t "$image" - < "$root/docker/dev/Dockerfile" > /dev/null
    # The image it replaces goes, with the cache volume only that image used, and the build's own cache.
    for old in $(docker images --format '{{.Tag}}' code-commandments/dev | grep -vx "$tag"); do
        docker rmi "code-commandments/dev:$old" > /dev/null 2>&1
        docker volume rm "code-commandments-cache-$old" > /dev/null 2>&1
    done
    docker builder prune --force > /dev/null 2>&1
fi

mounts=(-v "$root:$root" -v /var/run/docker.sock:/var/run/docker.sock ${extra[@]+"${extra[@]}"})
case "$common/" in
    "$root"/*) ;;
    *) mounts+=(-v "$common:$common") ;;
esac

# A temp folder the host sees at the same path: a test hands its temp files to the Roslyn bridge, whose
# container the host's docker mounts them into.
scratch=$(cd "$(mktemp -d "${TMPDIR:-/tmp}/commandments-dev.XXXXXX")" && pwd -P)
trap 'rm -rf "$scratch"' EXIT
mounts+=(-v "$scratch:$scratch")

# The host's zone file, so a time a test sets and prints reads as it does on the host, even where a test
# clears the environment.
if [ -e /etc/localtime ]; then
    mounts+=(-v "$(readlink -f /etc/localtime):/etc/localtime:ro")
fi

run() {
    local terminal=-i
    [ -t 0 ] && [ -t 1 ] && terminal=-it

    docker run --rm "$terminal" --init \
        --memory="$memory" --memory-swap="$memory" --cpus="$cpus" \
        --label code-commandments.dev=run \
        "${mounts[@]}" \
        -v code-commandments-gomod:/root/go/pkg/mod \
        -v code-commandments-gobuild:/root/go/build \
        -v "code-commandments-cache-$tag:/root/.cache" \
        -e GOCACHE=/root/go/build \
        -e GOMEMLIMIT=1200MiB -e GOMAXPROCS=2 -e GOFLAGS="-p=2 -parallel=2" \
        -e TMPDIR="$scratch" \
        -e COMMANDMENTS_ROSLYN=docker \
        -w "$cwd" \
        "$image" "$@"
}

# Go's build cache only grows, an entry for every build of every checkout and clone; once a day it is emptied
# when it has passed its bound (in MB), and the next run builds what it needs again. The day is kept beside the
# repository's own git data, so a run on any other day starts no extra container.
cacheBound=4096
trimmed="$common/commandments-dev-trimmed"
if [ -z "$(find "$trimmed" -mmin -1440 2>/dev/null)" ]; then
    run sh -c "[ \"\$(du -sm /root/go/build | cut -f1)\" -le $cacheBound ] || go clean -cache" > /dev/null 2>&1 || true
    touch "$trimmed"
fi

run "$@"
