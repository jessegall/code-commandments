#!/usr/bin/env bash
# Builds the release: one static binary per platform, stamped with the version, then checked and summed by
# scripts/release/check with whatever C# bridges scripts/release/roslyn already put in the folder — nothing is tagged,
# pushed or published here. Runs Go, so only in the dev container:
#   scripts/dev scripts/release/build v5.0.0 [out] [--tool-only]
# --tool-only builds and checks the tool's binaries alone, as CI's trial build does; a release holds its bridges too.
set -euo pipefail

only=()
arguments=()
for argument in "$@"; do
    if [ "$argument" = --tool-only ]; then only=(--tool-only); else arguments+=("$argument"); fi
done
version="${arguments[0]:?usage: scripts/release/build <version> [out] [--tool-only]}"
out="${arguments[1]:-dist}"
root="$(cd "$(dirname "$0")/../.." && pwd -P)"
platforms=(linux/amd64 linux/arm64 darwin/amd64 darwin/arm64)
build_tag=commandments_release

cd "$root"
mkdir -p "$out"
for platform in "${platforms[@]}"; do
    os="${platform%/*}"
    arch="${platform#*/}"
    binary="$out/commandments-$os-$arch"
    (
        export CGO_ENABLED=0 GOOS="$os" GOARCH="$arch" GOFLAGS=-p=2
        sources=$(go list -tags "$build_tag" -f '{{range .GoFiles}}{{println .}}{{end}}' ./bridge/gotree)
        source_digest=$(
            while IFS= read -r source; do
                sha256sum "bridge/gotree/$source" || exit 1
            done <<<"$sources" | sha256sum
        )
        source_digest=${source_digest%% *}
        go build -tags "$build_tag" -trimpath \
            -ldflags "-s -w -X main.version=$version -X github.com/jessegall/code-commandments/bridge/gotree.releaseSourceDigest=$source_digest" \
            -o "$binary" ./cmd/commandments
    )
done
go run ./scripts/release/check "${only[@]}" "$out"
