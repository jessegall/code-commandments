#!/usr/bin/env php
<?php

declare(strict_types=1);

use JesseGall\CodeCommandments\Cli\Kernel;

$toBytes = static function (string $limit): int {
    $limit = trim($limit);
    $value = (int) $limit;

    return match (strtolower(substr($limit, -1))) {
        'g' => $value * 1024 * 1024 * 1024,
        'm' => $value * 1024 * 1024,
        'k' => $value * 1024,
        default => $value,
    };
};

(static function (array $argv) use ($toBytes): void {
    // Parsing a whole codebase into ASTs (and bucketing its nodes) is memory-hungry;
    // lift the default 128M ceiling so a large source tree doesn't abort mid-scan.
    // Default 2G; override with `--memory=4G` (or `--memory=-1` for no limit). An
    // operator's already-higher limit (or an unlimited -1) is respected.
    $requested = '2G';
    foreach ($argv as $arg) {
        if (str_starts_with($arg, '--memory=')) {
            $requested = trim(substr($arg, 9)) ?: $requested;
        }
    }

    $current = trim((string) ini_get('memory_limit'));
    if ($requested === '-1') {
        ini_set('memory_limit', '-1');
    } elseif ($current !== '-1' && $toBytes($current) < $toBytes($requested)) {
        ini_set('memory_limit', $requested);
    }

    foreach ([
        __DIR__ . '/../vendor/autoload.php',   // run from the package
        __DIR__ . '/../../../autoload.php',     // run as vendor/bin in a consumer
    ] as $autoload) {
        if (is_file($autoload)) {
            require $autoload;
            break;
        }
    }

    exit(new Kernel()->run($argv));
})($argv);
