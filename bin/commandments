#!/usr/bin/env php
<?php

declare(strict_types=1);

use JesseGall\CodeCommandments\Cli\Kernel;

$toBytes = static function (string $limit): int {
    $limit = trim($limit);
    $value = (int) $limit;

    return match (strtolower(substr($limit, -1))) {
        'g' => $value * 1024 * 1024 * 1024,
        'm' => $value * 1024 * 1024,
        'k' => $value * 1024,
        default => $value,
    };
};

// COMMANDMENTS_ENGINE=go hands the whole run to the Go binary, its streams and exit code the run's own:
// $COMMANDMENTS_GO_BINARY when set, else bin/commandments-go beside this script, else `go run` over the
// checkout's cmd/commandments. The package's own checkout (the one with scripts/dev) never runs Go on the
// host: without a built binary it stops and names the capped build that makes one.
if (getenv('COMMANDMENTS_ENGINE') === 'go') {
    $binary = getenv('COMMANDMENTS_GO_BINARY') ?: __DIR__ . '/commandments-go';

    if (! is_file($binary) && is_file(dirname(__DIR__) . '/scripts/dev')) {
        $os = strtolower(PHP_OS_FAMILY);
        $arch = ['x86_64' => 'amd64', 'aarch64' => 'arm64'][php_uname('m')] ?? php_uname('m');
        fwrite(STDERR, "No Go binary at {$binary}, and Go never runs on the host here. Build it in the capped dev container:\n"
            . "  scripts/dev env GOOS={$os} GOARCH={$arch} CGO_ENABLED=0 go build -o bin/commandments-go ./cmd/commandments\n");
        exit(1);
    }

    $command = is_file($binary)
        ? [$binary, ...array_slice($argv, 1)]
        : ['go', 'run', dirname(__DIR__) . '/cmd/commandments', ...array_slice($argv, 1)];
    $process = proc_open($command, [STDIN, STDOUT, STDERR], $pipes);

    exit($process === false ? 1 : proc_close($process));
}

(static function (array $argv) use ($toBytes): void {
    // Parsing a whole codebase into ASTs (and bucketing its nodes) is memory-hungry;
    // lift the default 128M ceiling so a large source tree doesn't abort mid-scan.
    // Default 2G; override with `--memory=4G` (or `--memory=-1` for no limit). An
    // operator's already-higher limit (or an unlimited -1) is respected.
    $requested = '2G';
    foreach ($argv as $arg) {
        if (str_starts_with($arg, '--memory=')) {
            $requested = trim(substr($arg, 9)) ?: $requested;
        }
    }

    $current = trim((string) ini_get('memory_limit'));
    if ($requested === '-1') {
        ini_set('memory_limit', '-1');
    } elseif ($current !== '-1' && $toBytes($current) < $toBytes($requested)) {
        ini_set('memory_limit', $requested);
    }

    foreach ([
        __DIR__ . '/../vendor/autoload.php',   // run from the package
        __DIR__ . '/../../../autoload.php',     // run as vendor/bin in a consumer
    ] as $autoload) {
        if (is_file($autoload)) {
            require $autoload;
            break;
        }
    }

    exit(new Kernel()->run($argv));
})($argv);
