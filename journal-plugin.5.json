{
  "name": "code-commandments",
  "version": "7.18.123",
  "title": "Code Commandments",
  "description": "The static code checker judges the codebase, its hooks run inside the journal, and every rule and language is a switch in its settings",
  "journal": "5.0.0",
  "fits": {
    "languages": [
      "PHP",
      "Python",
      "TypeScript",
      "Vue",
      "C#",
      "Go"
    ]
  },
  "protocol": 1,
  "program": ".journal-plugin/hook",
  "hook_stamp": "@code-commandments-managed",
  "project_reads": [
    ".commandments"
  ],
  "injected_instructions": [
    "instructions/briefing.md"
  ],
  "instruction_blocks": [
    {
      "key": "briefing",
      "title": "Code Commandments briefing",
      "file": "instructions/worker-briefing.md",
      "default": true
    }
  ],
  "config": {
    "file": ".commandments/config.json",
    "schema": ".commandments/config.schema.json"
  },
  "hears": [
    "command_starting",
    "file_edited",
    "tool_starting",
    "idle",
    "session_started",
    "ticked"
  ],
  "holds": [
    {
      "event": "command_starting",
      "window_ms": 1000
    }
  ],
  "processes": [
    {
      "kind": "judge",
      "title": "Judging the project against its commandments",
      "category": "check",
      "at_once": "judge_at_once"
    }
  ],
  "reaches": {
    "file_edited": [
      "workers"
    ],
    "command_starting": [
      "workers",
      "helpers"
    ],
    "tool_starting": [
      "workers"
    ],
    "idle": [
      "workers"
    ]
  },
  "listen": [
    {
      "event": "suites.coding.workers.worker_worktree.merge",
      "commit": ".journal-plugin/hook"
    },
    {
      "event": "core.plugins.plugin.updated",
      "commit": ".journal-plugin/hook"
    },
    {
      "event": "core.agents.agent.created",
      "commit": ".journal-plugin/hook"
    },
    {
      "event": "suites.coding.workers.worker_worktree.cut",
      "commit": ".journal-plugin/hook"
    },
    {
      "event": "suites.coding.workers.merge_request.created",
      "guard": ".journal-plugin/hook",
      "window_ms": 30000
    },
    {
      "event": "suites.coding.workers.worker_delivering",
      "guard": ".journal-plugin/hook",
      "window_ms": 180000
    },
    {
      "event": "core.plugins.plugin.config_changed",
      "commit": ".journal-plugin/hook"
    }
  ],
  "aliases": [
    {
      "name": "sins",
      "description": "Judge the project against its commandments and show each sin as it is found",
      "line": "bin/commandments-release judge {args}",
      "env": {
        "COMMANDMENTS_PLAIN_PROGRESS": "1"
      },
      "args": [
        "--changes",
        "--branch",
        "<path>"
      ],
      "reader": "judge",
      "category": "check",
      "background": true,
      "workers": true
    },
    {
      "name": "commandments-judge-changes",
      "description": "Judge what changed since the last commit against the project's commandments and show each sin as it is found",
      "line": "bin/commandments-release judge --changes",
      "env": {
        "COMMANDMENTS_PLAIN_PROGRESS": "1"
      },
      "reader": "judge",
      "category": "check",
      "background": true,
      "workers": true
    },
    {
      "name": "rules",
      "description": "Work on a rule of the project's own: try it on a path, prove it against the samples that mark it, or read a file's tree",
      "line": "bin/commandments-release rule {args}",
      "args": [
        "try <Rule> <path>",
        "prove",
        "explain <file>",
        "schema"
      ],
      "reader": "rule",
      "category": "check"
    },
    {
      "name": "commandments",
      "description": "Run any code-commandments verb through the binary this plugin fetched: report, info, repent, exemptions, make",
      "line": "bin/commandments-release {args}",
      "args": [
        "report follow",
        "report forget <issue>",
        "report --detector=<rule> --reason=<why> --ref=<path:line>",
        "info <sin>",
        "repent --dry-run",
        "judge --changes"
      ]
    }
  ],
  "cards": [
    {
      "type": "sin-found",
      "kind": "sin-found",
      "label": "Sins in a file",
      "tone": "warn",
      "icon": "warn",
      "collapsed": true
    },
    {
      "type": "sin-resolved",
      "kind": "sin-resolved",
      "label": "File repented",
      "tone": "good",
      "icon": "check",
      "collapsed": true
    },
    {
      "type": "configured",
      "kind": "configured",
      "label": "Settings applied",
      "tone": "good",
      "icon": "check",
      "collapsed": true
    }
  ],
  "requires": {
    "curl": {
      "check": "curl --version",
      "hint": "curl fetches the checker's release binary into the plugin's own folder"
    },
    "python3": {
      "check": "python3 -c 'import sys; sys.exit(sys.version_info < (3, 9))'",
      "hint": "python3, 3.9 or newer, runs the plugin's script for every event the journal hands it"
    },
    "sha256sum": {
      "check": "command -v sha256sum || command -v shasum",
      "hint": "sha256sum or shasum checks the fetched binary against its release's SHA256SUMS"
    }
  },
  "setup": [
    {
      "name": "Fetch the checker's release binary, checked against its SHA256SUMS",
      "run": "COMMANDMENTS_RELEASE=v7.18.123 sh .journal-plugin/fetch"
    },
    {
      "name": "Write the chosen switches into config.json",
      "run": "bin/commandments-release journal-config --keep-folders"
    },
    {
      "name": "Check for sins, on demand",
      "run": "journal check list | grep -q \"Check for sins\" || journal check create \"Check for sins\" --command \"$JOURNAL_PLUGIN_DIR/bin/commandments-release judge\" --every 0 --brief \"Judges the whole project against its commandments; a failure lists each sin found, grouped by the skill that fixes it\""
    }
  ],
  "installed": "bin/commandments-release journal-scan --settings-only",
  "settings": ".journal-plugin/settings.json",
  "skills": "journal-skills/.agents/skills",
  "dashboard": {
    "name": "sins",
    "title": "Sins"
  }
}
