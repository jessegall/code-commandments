# Dependencies
/vendor/
/node/node_modules/

# Composer
composer.phar
composer.lock

# PHPUnit
.phpunit.result.cache
.phpunit.cache/
coverage/
coverage.xml

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.*
!.env.example

# Claude Code (generated per-project) — but the dev skills are part of the package
.claude/*
!.claude/skills/
CLAUDE.md

# Package development
/storage/
*.log

# Build artifacts
/build/
/dist/

# Testing artifacts
/tests/Fixtures/temp/
.php-cs-fixer.cache
phpstan.neon
phpcs.xml

# code-commandments self-judgment runtime artifacts — the folder carries its own .gitignore,
# which keeps config.php and custom/ tracked and everything generated out. A fixture's own
# folder has no such file, so it stays tracked whole: it IS the spec the harness proves.
.ast-cache/

# code-commandments skill library (regenerated on composer update)
.agents/skills/commandments-*/

# code-commandments published skills (regenerated on composer update)
.claude/skills/commandments-*

# Worktrees a lane is opened in — checkouts of this repo, never content of it.
.lanes/
/journal-skills/

# The agent journal's own runtime, installed and updated by the journal itself — never our source.
# What IS ours is .journal-plugin/, the manifest that makes this package one of its plugins.
/.journal/
# The skills and agent files the journal publishes into our tree are that same runtime: it
# rewrites them on every upgrade, so they are never ours to carry.
.agents/skills/journal-*/
.claude/skills/journal*/
/.codex/
/.mcp.json
__pycache__/

# The Go binary, built with `go build -o bin/commandments-go ./cmd/commandments`.
/bin/commandments-go
# The binary the shim last ran, recorded for bin/hook.
/bin/.binary
# The release binary the journal plugin's .journal-plugin/fetch writes.
/bin/commandments-release

# What scripts/memory/judge.sh keeps while it runs, inside the checkout the dev container sees.
/.memory-scratch/

# What scripts/plugin/prove builds and installs from.
/.plugin-proof/
/.journal
