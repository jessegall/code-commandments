#!/bin/sh
set -eu

refuse() {
    echo "fetch: $*" >&2
    exit 1
}

version="${COMMANDMENTS_RELEASE:-}"
case "$version" in
    v[0-9]*.[0-9]*.[0-9]*) ;;
    *) refuse "COMMANDMENTS_RELEASE names no release (${version:-nothing}); pin a tagged version such as v5.0.0" ;;
esac

machine="$(uname -m)"
case "$(uname -s)" in
    Darwin) os=darwin ;;
    Linux) os=linux ;;
    CYGWIN*|MINGW*|MSYS*) refuse "Windows is not supported; run the journal under WSL, which is Linux" ;;
    *) refuse "no release is built for $(uname -s)" ;;
esac
case "$machine" in
    x86_64|amd64|AMD64) arch=amd64 ;;
    arm64|aarch64|ARM64) arch=arm64 ;;
    *) refuse "no release is built for $machine" ;;
esac
name="commandments-$os-$arch"

command -v curl >/dev/null 2>&1 || refuse "curl is not on the PATH, so the $version release cannot be fetched"
if command -v sha256sum >/dev/null 2>&1; then
    digest() { sha256sum "$1"; }
elif command -v shasum >/dev/null 2>&1; then
    digest() { shasum -a 256 "$1"; }
else
    refuse "neither sha256sum nor shasum is on the PATH, so the fetched binary cannot be checked"
fi

root="$(cd "$(dirname "$0")/.." && pwd -P)"
base="${COMMANDMENTS_RELEASES:-https://github.com/jessegall/code-commandments/releases/download}"
base="${base%/}/$version"
target="$root/bin/commandments-release"
draft="$target.$$"
expanded="$draft.expanded"
trap 'rm -f "$draft" "$expanded"' EXIT

fetched() {
    curl -fsSL --connect-timeout 20 -o "$2" "$base/$1" && return 0
    [ -z "${COMMANDMENTS_RELEASES:-}" ] && command -v gh >/dev/null 2>&1 &&
        gh release download "$version" --repo jessegall/code-commandments --pattern "$1" --output "$2" --clobber
}

fetched SHA256SUMS "$draft" || refuse "could not fetch $base/SHA256SUMS"
sums="$(cat "$draft")"
listed_checksum() {
    printf '%s\n' "$sums" | awk -v name="$1" '$2 == name || $2 == "*" name { print $1; exit }'
}

asset="$name.gz"
wanted="$(listed_checksum "$asset")"
if [ -z "$wanted" ]; then
    asset="$name"
    wanted="$(listed_checksum "$asset")"
fi
[ -n "$wanted" ] || refuse "the $version release lists no $name or $name.gz"

fetched "$asset" "$draft" || refuse "could not fetch $base/$asset"
[ "$(digest "$draft" | awk '{ print $1 }')" = "$wanted" ] ||
    refuse "the $asset fetched for $version does not match its SHA256SUMS, so it is not installed"

if [ "$asset" = "$name.gz" ]; then
    python3 -c 'import gzip, shutil, sys
with gzip.open(sys.argv[1], "rb") as archive:
    shutil.copyfileobj(archive, sys.stdout.buffer)' "$draft" > "$expanded" ||
        refuse "could not unpack $asset for $version"
    mv -f "$expanded" "$draft"
fi

chmod 755 "$draft"
mv -f "$draft" "$target"
echo "fetched $asset $version, checked against its SHA256SUMS"
