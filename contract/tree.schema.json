{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jessegall/code-commandments/contract/tree.schema.json",
  "title": "One line of a generic tree stream, version 1",
  "description": "contract/CONTRACT.md is the prose form of this schema; the two say the same thing.",
  "oneOf": [
    {"type": "object", "properties": {"header": {"$ref": "#/$defs/header"}}, "required": ["header"], "additionalProperties": false},
    {"type": "object", "properties": {"file": {"$ref": "#/$defs/file"}}, "required": ["file"], "additionalProperties": false},
    {"type": "object", "properties": {"program": {"$ref": "#/$defs/program"}}, "required": ["program"], "additionalProperties": false},
    {"type": "object", "properties": {"trailer": {"$ref": "#/$defs/trailer"}}, "required": ["trailer"], "additionalProperties": false}
  ],
  "$defs": {
    "language": {"enum": ["php", "vue", "typescript", "python", "csharp"]},
    "count": {"type": "integer", "minimum": 0},
    "id": {"type": "integer", "minimum": 0},
    "symbolId": {"type": "string", "minLength": 1},
    "absolutePath": {"type": "string", "pattern": "^(/|[A-Za-z]:[\\\\/])"},
    "names": {"type": "array", "items": {"type": "string", "minLength": 1}},

    "header": {
      "type": "object",
      "properties": {
        "contract": {"const": "tree"},
        "version": {"type": "integer", "minimum": 1},
        "language": {"$ref": "#/$defs/language"},
        "bridge": {
          "type": "object",
          "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}},
          "required": ["name", "version"],
          "additionalProperties": false
        },
        "roots": {"type": "array", "items": {"$ref": "#/$defs/absolutePath"}}
      },
      "required": ["contract", "version", "language", "bridge", "roots"],
      "additionalProperties": false
    },

    "file": {
      "type": "object",
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "language": {"$ref": "#/$defs/language"},
        "errors": {"$ref": "#/$defs/count"},
        "context": {"const": true},
        "test": {"const": true},
        "module": {"type": "string", "minLength": 1},
        "resolver": {
          "type": "object",
          "properties": {"tool": {"enum": ["roslyn", "mypy", "tsc"]}, "ran": {"type": "boolean"}},
          "required": ["tool", "ran"],
          "additionalProperties": false
        },
        "root": {"$ref": "#/$defs/node"},
        "comments": {"type": "array", "items": {"$ref": "#/$defs/comment"}},
        "types": {"type": "array", "items": {"$ref": "#/$defs/type"}}
      },
      "required": ["path", "language", "errors", "root", "comments"],
      "additionalProperties": false
    },

    "span": {
      "type": "array",
      "prefixItems": [{"$ref": "#/$defs/count"}, {"$ref": "#/$defs/count"}, {"type": "integer", "minimum": 1}],
      "minItems": 3,
      "maxItems": 3
    },

    "node": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"type": "string", "minLength": 1},
        "role": {"enum": ["statement", "expression", "member", "type", "pattern", "markup", "other"]},
        "is": {"type": "array", "uniqueItems": true, "items": {"enum": [
          "function", "type-declaration", "parameter", "block", "branch", "loop", "return", "throw", "bail-out",
          "expression-statement", "call", "construction", "member-access", "null-safe", "self-reference",
          "identifier", "assignment", "comparison", "literal", "import", "catch"
        ]}},
        "span": {"$ref": "#/$defs/span"},
        "field": {"type": "string", "minLength": 1},
        "children": {"type": "array", "items": {"$ref": "#/$defs/node"}},
        "name": {"type": "string", "minLength": 1},
        "literal": {"enum": ["string", "int", "float", "bool", "null", "undefined", "bytes", "ellipsis", "interpolated", "format"]},
        "value": {"type": ["string", "boolean", "null"]},
        "operator": {"type": "string", "minLength": 1},
        "modifiers": {"$ref": "#/$defs/names"},
        "flags": {"type": "array", "uniqueItems": true, "items": {"enum": [
          "variadic", "keywords", "by-ref", "promoted", "keyword-only", "optional", "spread", "named", "async",
          "generator", "short-ternary", "shorthand", "nullable-sugar", "group", "step", "elif", "component"
        ]}},
        "declared": {"$ref": "#/$defs/type"},
        "returns": {"$ref": "#/$defs/type"},
        "resolved": {"$ref": "#/$defs/type"},
        "resolvedType": {"type": "integer", "minimum": 0},
        "symbol": {"$ref": "#/$defs/symbolId"},
        "refers": {"$ref": "#/$defs/symbolId"},
        "target": {"$ref": "#/$defs/target"},
        "resolves": {"$ref": "#/$defs/absolutePath"},
        "constant": {"const": true},
        "inherited": {"const": true},
        "extras": {"$ref": "#/$defs/nodeExtras"}
      },
      "required": ["id", "kind", "role", "span"],
      "additionalProperties": false
    },

    "type": {
      "type": "object",
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "kind": {"enum": ["named", "keyword", "parameter", "union", "intersection", "array", "tuple", "object", "function", "literal", "opaque"]},
        "name": {"type": "string", "minLength": 1},
        "args": {"type": "array", "items": {"$ref": "#/$defs/type"}},
        "members": {"type": "array", "items": {"$ref": "#/$defs/type"}},
        "fields": {"type": "array", "items": {
          "type": "object",
          "properties": {"name": {"type": "string"}, "type": {"$ref": "#/$defs/type"}, "optional": {"const": true}},
          "required": ["name", "type"],
          "additionalProperties": false
        }},
        "parameters": {"type": "array", "items": {"$ref": "#/$defs/type"}},
        "returns": {"$ref": "#/$defs/type"},
        "value": {"type": ["string", "boolean", "null"]},
        "nullable": {"const": true},
        "valueType": {"const": true},
        "element": {"$ref": "#/$defs/type"},
        "constructs": {"$ref": "#/$defs/symbolId"},
        "origin": {"enum": ["written", "docblock", "attribute", "inferred", "compiler"]}
      },
      "required": ["text", "kind", "origin"],
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"kind": {"enum": ["named", "keyword", "parameter"]}}}, "then": {"required": ["name"]}},
        {"if": {"properties": {"kind": {"enum": ["union", "intersection", "tuple"]}}}, "then": {"required": ["members"]}},
        {"if": {"properties": {"kind": {"const": "literal"}}}, "then": {"required": ["value"]}},
        {"if": {"properties": {"kind": {"const": "opaque"}}}, "then": {"properties": {"text": {}, "kind": {}, "origin": {}, "nullable": {}, "valueType": {}, "constructs": {}}, "additionalProperties": false}}
      ]
    },

    "target": {
      "type": "object",
      "properties": {
        "symbol": {"$ref": "#/$defs/symbolId"},
        "type": {"$ref": "#/$defs/symbolId"},
        "name": {"type": "string", "minLength": 1},
        "parameters": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "required": ["symbol", "name"],
      "additionalProperties": false
    },

    "comment": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["line", "block", "doc", "markup"]},
        "text": {"type": "string"},
        "span": {"$ref": "#/$defs/span"},
        "attached": {"$ref": "#/$defs/id"},
        "trailing": {"const": true},
        "refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
        "extras": {"$ref": "#/$defs/commentExtras"}
      },
      "required": ["id", "kind", "text", "span"],
      "additionalProperties": false
    },

    "ref": {
      "type": "object",
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "symbol": {"$ref": "#/$defs/symbolId"},
        "owner": {"$ref": "#/$defs/symbolId"},
        "ownedHere": {"type": "boolean"},
        "blind": {"const": true}
      },
      "required": ["text"],
      "additionalProperties": false
    },

    "nodeExtras": {
      "type": "object",
      "properties": {
        "csharp": {
          "type": "object",
          "properties": {"forgivesNull": {"const": true}},
          "additionalProperties": false,
          "minProperties": 1
        },
        "python": {
          "type": "object",
          "properties": {
            "operators": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "level": {"type": "integer", "minimum": 1},
            "as": {"type": "string", "minLength": 1},
            "names": {"$ref": "#/$defs/names", "minItems": 1}
          },
          "additionalProperties": false,
          "minProperties": 1
        },
        "vue": {
          "type": "object",
          "properties": {
            "directive": {
              "type": "object",
              "properties": {"name": {"type": "string", "minLength": 1}, "modifiers": {"$ref": "#/$defs/names"}},
              "required": ["name", "modifiers"],
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        },
        "typescript": {
          "type": "object",
          "properties": {"typeOnly": {"const": true}},
          "additionalProperties": false,
          "minProperties": 1
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },

    "commentExtras": {
      "type": "object",
      "properties": {
        "csharp": {
          "type": "object",
          "properties": {"code": {"const": true}},
          "additionalProperties": false,
          "minProperties": 1
        },
        "php": {
          "type": "object",
          "properties": {"code": {"const": true}},
          "additionalProperties": false,
          "minProperties": 1
        },
        "python": {
          "type": "object",
          "properties": {"code": {"const": true}},
          "additionalProperties": false,
          "minProperties": 1
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },

    "program": {
      "type": "object",
      "properties": {
        "symbols": {"type": "array", "items": {"$ref": "#/$defs/outsideSymbol"}},
        "unreadable": {"type": "array", "items": {
          "type": "object",
          "properties": {"symbol": {"$ref": "#/$defs/symbolId"}, "reason": {"type": "string"}},
          "required": ["symbol", "reason"],
          "additionalProperties": false
        }},
        "packages": {"type": "array", "items": {"$ref": "#/$defs/absolutePath"}},
        "aliases": {"type": "array", "items": {
          "type": "object",
          "properties": {"prefix": {"type": "string", "minLength": 1}, "path": {"$ref": "#/$defs/absolutePath"}},
          "required": ["prefix", "path"],
          "additionalProperties": false
        }}
      },
      "additionalProperties": false
    },

    "outsideSymbol": {
      "type": "object",
      "properties": {
        "symbol": {"$ref": "#/$defs/symbolId"},
        "kind": {"enum": ["class", "interface", "trait", "enum", "struct"]},
        "name": {"type": "string", "minLength": 1},
        "extends": {"type": "array", "items": {"$ref": "#/$defs/symbolId"}},
        "implements": {"type": "array", "items": {"$ref": "#/$defs/symbolId"}},
        "uses": {"type": "array", "items": {"$ref": "#/$defs/symbolId"}},
        "modifiers": {"$ref": "#/$defs/names"},
        "members": {"type": "array", "items": {"$ref": "#/$defs/outsideMember"}}
      },
      "required": ["symbol", "kind", "name"],
      "additionalProperties": false
    },

    "outsideMember": {
      "type": "object",
      "properties": {
        "symbol": {"$ref": "#/$defs/symbolId"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["method", "property", "field", "constant"]},
        "modifiers": {"$ref": "#/$defs/names"},
        "declared": {"$ref": "#/$defs/type"},
        "returns": {"$ref": "#/$defs/type"},
        "documented": {"$ref": "#/$defs/type"},
        "parameters": {"type": "array", "items": {
          "type": "object",
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "declared": {"$ref": "#/$defs/type"},
            "flags": {"$ref": "#/$defs/node/properties/flags"}
          },
          "required": ["name"],
          "additionalProperties": false
        }}
      },
      "required": ["symbol", "name", "kind"],
      "additionalProperties": false
    },

    "trailer": {
      "type": "object",
      "properties": {
        "files": {"$ref": "#/$defs/count"},
        "resolution": {
          "type": "object",
          "properties": {
            "expressions": {"$ref": "#/$defs/count"},
            "typed": {"$ref": "#/$defs/count"},
            "calls": {"$ref": "#/$defs/count"},
            "resolved": {"$ref": "#/$defs/count"},
            "unjoined": {"$ref": "#/$defs/count"}
          },
          "additionalProperties": false
        }
      },
      "required": ["files"],
      "additionalProperties": false
    }
  }
}
