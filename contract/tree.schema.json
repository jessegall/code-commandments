{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jessegall/code-commandments/contract/tree.schema.json",
  "title": "The generic tree contract, version 5",
  "description": "contract/CONTRACT.md as data. The envelope is JSON Schema; kinds, facts and categories are the one table every node is checked against.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "header": {
          "$ref": "#/$defs/header"
        }
      },
      "required": [
        "header"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "file": {
          "$ref": "#/$defs/file"
        }
      },
      "required": [
        "file"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "program": {
          "$ref": "#/$defs/program"
        }
      },
      "required": [
        "program"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "trailer": {
          "$ref": "#/$defs/trailer"
        }
      },
      "required": [
        "trailer"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "language": {
      "enum": [
        "php",
        "vue",
        "typescript",
        "python",
        "csharp",
        "go"
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "id": {
      "type": "integer",
      "minimum": 0
    },
    "symbolId": {
      "type": "string",
      "minLength": 1
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^(/|[A-Za-z]:[\\\\/])"
    },
    "names": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "span": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/count"
        },
        {
          "$ref": "#/$defs/count"
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "type": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "named",
            "keyword",
            "parameter",
            "union",
            "intersection",
            "array",
            "tuple",
            "object",
            "function",
            "literal",
            "pointer",
            "map",
            "opaque"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/type"
          }
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/type"
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "$ref": "#/$defs/type"
              },
              "optional": {
                "const": true
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/type"
          }
        },
        "returns": {
          "$ref": "#/$defs/type"
        },
        "value": {
          "type": [
            "string",
            "boolean",
            "null"
          ]
        },
        "nullable": {
          "type": "boolean",
          "description": "Whether the type admits no value, when the bridge knows; absent when it does not."
        },
        "valueType": {
          "type": "boolean",
          "description": "Whether the type is copied by value, when the bridge knows; absent when it does not."
        },
        "element": {
          "$ref": "#/$defs/type"
        },
        "constructs": {
          "$ref": "#/$defs/symbolId"
        },
        "origin": {
          "enum": [
            "written",
            "docblock",
            "attribute",
            "inferred",
            "compiler"
          ]
        }
      },
      "required": [
        "text",
        "kind",
        "origin"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "named",
                  "keyword",
                  "parameter"
                ]
              }
            }
          },
          "then": {
            "required": [
              "name"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "union",
                  "intersection",
                  "tuple"
                ]
              }
            }
          },
          "then": {
            "required": [
              "members"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "literal"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "pointer"
              }
            }
          },
          "then": {
            "required": [
              "element"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "map"
              }
            }
          },
          "then": {
            "required": [
              "element"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "opaque"
              }
            }
          },
          "then": {
            "properties": {
              "text": {},
              "kind": {},
              "origin": {},
              "nullable": {},
              "valueType": {},
              "constructs": {}
            },
            "additionalProperties": false
          }
        }
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "symbol": {
          "$ref": "#/$defs/symbolId"
        },
        "type": {
          "$ref": "#/$defs/symbolId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "symbol",
        "name"
      ],
      "additionalProperties": false
    },
    "ref": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "$ref": "#/$defs/symbolId"
        },
        "owner": {
          "$ref": "#/$defs/symbolId"
        },
        "ownedHere": {
          "type": "boolean"
        },
        "blind": {
          "const": true
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "outsideSymbol": {
      "type": "object",
      "properties": {
        "symbol": {
          "$ref": "#/$defs/symbolId"
        },
        "kind": {
          "enum": [
            "class",
            "interface",
            "trait",
            "enum",
            "struct"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "internal": {
          "type": "boolean"
        },
        "extends": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/symbolId"
          }
        },
        "implements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/symbolId"
          }
        },
        "uses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/symbolId"
          }
        },
        "modifiers": {
          "$ref": "#/$defs/names"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outsideMember"
          }
        }
      },
      "required": [
        "symbol",
        "kind",
        "name"
      ],
      "additionalProperties": false
    },
    "outsideMember": {
      "type": "object",
      "properties": {
        "symbol": {
          "$ref": "#/$defs/symbolId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "method",
            "property",
            "field",
            "constant"
          ]
        },
        "modifiers": {
          "$ref": "#/$defs/names"
        },
        "declared": {
          "$ref": "#/$defs/type"
        },
        "returns": {
          "$ref": "#/$defs/type"
        },
        "documented": {
          "$ref": "#/$defs/type"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "declared": {
                "$ref": "#/$defs/type"
              },
              "flags": {
                "type": "array",
                "items": {
                  "enum": [
                    "variadic",
                    "by-ref",
                    "promoted"
                  ]
                },
                "uniqueItems": true
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "symbol",
        "name",
        "kind"
      ],
      "additionalProperties": false
    },
    "trailer": {
      "type": "object",
      "properties": {
        "files": {
          "$ref": "#/$defs/count"
        },
        "resolution": {
          "type": "object",
          "properties": {
            "expressions": {
              "$ref": "#/$defs/count"
            },
            "typed": {
              "$ref": "#/$defs/count"
            },
            "calls": {
              "$ref": "#/$defs/count"
            },
            "resolved": {
              "$ref": "#/$defs/count"
            },
            "unjoined": {
              "$ref": "#/$defs/count"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "files"
      ],
      "additionalProperties": false
    },
    "header": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "tree"
        },
        "version": {
          "const": 5
        },
        "language": {
          "$ref": "#/$defs/language"
        },
        "bridge": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "reads": {
              "const": true
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/absolutePath"
          }
        }
      },
      "required": [
        "contract",
        "version",
        "language",
        "bridge",
        "roots"
      ],
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/absolutePath"
        },
        "language": {
          "$ref": "#/$defs/language"
        },
        "errors": {
          "$ref": "#/$defs/count"
        },
        "context": {
          "const": true
        },
        "test": {
          "const": true
        },
        "module": {
          "type": "string",
          "minLength": 1
        },
        "publishedBy": {
          "type": "string",
          "minLength": 1,
          "description": "the dependency that ships this file, when the project holds a copy of a file a package publishes (a Laravel config file published from vendor)"
        },
        "reads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/absolutePath"
          }
        },
        "resolver": {
          "type": "object",
          "properties": {
            "tool": {
              "enum": [
                "php-parser",
                "roslyn",
                "mypy",
                "tsc",
                "go/types"
              ]
            },
            "ran": {
              "type": "boolean"
            }
          },
          "required": [
            "tool",
            "ran"
          ],
          "additionalProperties": false
        },
        "root": {
          "$ref": "#/$defs/node"
        },
        "comments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/comment"
          }
        },
        "types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/type"
          }
        }
      },
      "required": [
        "path",
        "language",
        "errors",
        "root",
        "comments"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "description": "One operation of the language. Its kind, roles, links and facts are checked against the kinds table of this schema.",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "access",
            "alias",
            "annotation",
            "argument",
            "arm",
            "assignment",
            "attribute",
            "await",
            "binary",
            "binding",
            "block",
            "break",
            "call",
            "cast",
            "collection",
            "comparison",
            "comprehension",
            "comprehension-clause",
            "conditional",
            "constant",
            "construction",
            "continue",
            "declarator",
            "default-value",
            "defer",
            "directive",
            "dispatch",
            "element",
            "embedded-expression",
            "entry",
            "enum-case",
            "expression-statement",
            "fallback",
            "field",
            "file",
            "function",
            "goto",
            "handler",
            "if",
            "import",
            "import-binding",
            "index",
            "interpolation",
            "label",
            "literal",
            "logical",
            "loop",
            "module",
            "no-op",
            "parameter",
            "pattern",
            "reference",
            "resource-scope",
            "return",
            "scope-declaration",
            "select",
            "select-arm",
            "text",
            "throw",
            "try",
            "tuple-element",
            "tuple-type",
            "type",
            "type-expression",
            "type-parameter",
            "type-test",
            "unary",
            "unsupported",
            "variable",
            "yield"
          ]
        },
        "span": {
          "$ref": "#/$defs/span"
        },
        "parts": {
          "type": "object"
        },
        "links": {
          "type": "object"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "$ref": "#/$defs/symbolId"
        },
        "refers": {
          "$ref": "#/$defs/symbolId"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "resolvedType": {
          "$ref": "#/$defs/count"
        },
        "constantValue": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": [
                "string",
                "boolean"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        "modifiers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "effective": {
          "type": "object",
          "properties": {
            "visibility": {
              "enum": [
                "public",
                "protected",
                "private",
                "internal",
                "package"
              ]
            },
            "static": {
              "type": "boolean"
            },
            "abstract": {
              "type": "boolean"
            },
            "final": {
              "type": "boolean"
            },
            "readonly": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "obligations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "symbol": {
                "$ref": "#/$defs/symbolId"
              },
              "origin": {
                "enum": [
                  "project",
                  "external"
                ]
              }
            },
            "required": [
              "symbol",
              "origin"
            ],
            "additionalProperties": false
          }
        },
        "incomplete": {
          "const": true
        },
        "source": {
          "type": "string"
        },
        "form": {
          "type": "string",
          "minLength": 1
        },
        "typeOnly": {
          "type": "boolean"
        },
        "relativeLevel": {
          "$ref": "#/$defs/count"
        },
        "resolves": {
          "$ref": "#/$defs/absolutePath"
        },
        "async": {
          "type": "boolean"
        },
        "generator": {
          "type": "boolean"
        },
        "passing": {
          "enum": [
            "value",
            "reference",
            "out",
            "in"
          ]
        },
        "collects": {
          "enum": [
            "none",
            "rest",
            "keywords"
          ]
        },
        "position": {
          "enum": [
            "either",
            "positional",
            "keyword"
          ]
        },
        "optional": {
          "type": "boolean"
        },
        "evaluated": {
          "enum": [
            "call",
            "definition"
          ]
        },
        "exhaustive": {
          "type": "boolean"
        },
        "default": {
          "type": "boolean"
        },
        "fallsThrough": {
          "type": "boolean"
        },
        "depth": {
          "type": "integer",
          "minimum": 1
        },
        "catchForm": {
          "enum": [
            "typed",
            "catch-all"
          ]
        },
        "group": {
          "type": "boolean"
        },
        "namedResults": {
          "type": "boolean"
        },
        "nullConditional": {
          "type": "boolean"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "spread": {
          "enum": [
            "none",
            "positional",
            "keyed"
          ]
        },
        "mode": {
          "enum": [
            "assign",
            "define",
            "compound",
            "fallback",
            "increment",
            "decrement"
          ]
        },
        "operator": {
          "type": "string",
          "minLength": 1
        },
        "operators": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "prefix": {
          "type": "boolean"
        },
        "trigger": {
          "enum": [
            "null",
            "falsy"
          ]
        },
        "negated": {
          "type": "boolean"
        },
        "delegates": {
          "type": "boolean"
        },
        "literalKind": {
          "enum": [
            "string",
            "integer",
            "float",
            "boolean",
            "null",
            "undefined",
            "bytes",
            "character",
            "ellipsis"
          ]
        },
        "value": {
          "type": [
            "string",
            "boolean"
          ]
        },
        "expansion": {
          "enum": [
            "none",
            "positional",
            "keyed"
          ]
        },
        "conversion": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "shorthand": {
          "type": "boolean"
        },
        "construct": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "kind",
        "span"
      ],
      "additionalProperties": false
    },
    "fragment": {
      "type": "object",
      "properties": {
        "context": {
          "type": "string",
          "minLength": 1
        },
        "diagnostics": {
          "$ref": "#/$defs/count"
        },
        "statements": {
          "$ref": "#/$defs/count"
        },
        "expressionKind": {
          "enum": [
            "access",
            "alias",
            "annotation",
            "argument",
            "arm",
            "assignment",
            "attribute",
            "await",
            "binary",
            "binding",
            "block",
            "break",
            "call",
            "cast",
            "collection",
            "comparison",
            "comprehension",
            "comprehension-clause",
            "conditional",
            "constant",
            "construction",
            "continue",
            "declarator",
            "default-value",
            "defer",
            "directive",
            "dispatch",
            "element",
            "embedded-expression",
            "entry",
            "enum-case",
            "expression-statement",
            "fallback",
            "field",
            "file",
            "function",
            "goto",
            "handler",
            "if",
            "import",
            "import-binding",
            "index",
            "interpolation",
            "label",
            "literal",
            "logical",
            "loop",
            "module",
            "no-op",
            "parameter",
            "pattern",
            "reference",
            "resource-scope",
            "return",
            "scope-declaration",
            "select",
            "select-arm",
            "text",
            "throw",
            "try",
            "tuple-element",
            "tuple-type",
            "type",
            "type-expression",
            "type-parameter",
            "type-test",
            "unary",
            "unsupported",
            "variable",
            "yield"
          ]
        }
      },
      "required": [
        "context",
        "diagnostics",
        "statements"
      ],
      "additionalProperties": false
    },
    "comment": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "form": {
          "enum": [
            "line",
            "block",
            "doc",
            "markup"
          ]
        },
        "text": {
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/span"
        },
        "attached": {
          "$ref": "#/$defs/id"
        },
        "trailing": {
          "const": true
        },
        "refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "fragment": {
          "$ref": "#/$defs/fragment"
        },
        "description": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/docTag"
          }
        }
      },
      "required": [
        "id",
        "form",
        "text",
        "span"
      ],
      "additionalProperties": false
    },
    "program": {
      "type": "object",
      "properties": {
        "symbols": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outsideSymbol"
          }
        },
        "unreadable": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "symbol": {
                "$ref": "#/$defs/symbolId"
              },
              "reason": {
                "type": "string"
