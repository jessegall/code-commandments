        "sin/python-dict-bag": {
            "title": "python-dict-bag",
            "view": {
                "type": "stack",
                "gap": 16,
                "children": [
                    {
                        "type": "heading",
                        "text": "python-dict-bag",
                        "level": 1
                    },
                    {
                        "type": "card",
                        "title": "About this rule",
                        "children": [
                            {
                                "type": "fact",
                                "label": "What it is",
                                "body": "A parameter typed as a dict read by string keys — `row[\"sku\"]`, `row.get(\"quantity\")` — a record nobody declared"
                            },
                            {
                                "type": "fact",
                                "label": "The rule",
                                "body": "Give a record a type — a frozen dataclass — instead of a dict read by string keys."
                            },
                            {
                                "type": "fact",
                                "label": "How to fix it",
                                "body": "Declare the keys as fields of a frozen dataclass, build it where the data enters (a `from_payload` classmethod), and take that type as the parameter."
                            }
                        ]
                    },
                    {
                        "type": "code",
                        "text": "commandments info python-dict-bag"
                    },
                    {
                        "type": "table",
                        "columns": [
