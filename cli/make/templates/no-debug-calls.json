{
    "summary": "a debugging call left in the code: dd() and dump(), print() and breakpoint(), console.log(), Console.WriteLine()",
    "sin": {
        "description": "A debugging call is left in the code.",
        "rule": "Remove the call; log through the project's logger when the output is wanted."
    },
    "find": {
        "backend": {"select": "call", "where": [{"nameIn": ["dd", "dump", "ddd", "var_dump", "print_r", "ray"]}]},
        "python": {"select": "call", "where": [{"nameIn": ["print", "breakpoint", "set_trace"]}]},
        "typescript": {"select": "call", "where": [{"nameIn": ["log", "debug", "trace", "dir"]}, {"descendant": {"name": "console"}, "of": "child:expression"}]},
        "frontend": {"select": "call", "where": [{"nameIn": ["log", "debug", "trace", "dir"]}, {"descendant": {"name": "console"}, "of": "child:expression"}]},
        "csharp": {"select": "call", "where": [{"nameIn": ["WriteLine", "Write"]}, {"descendant": {"name": "Console"}, "of": "child:Expression"}]}
    }
}
