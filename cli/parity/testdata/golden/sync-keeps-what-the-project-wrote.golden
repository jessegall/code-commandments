                                "description": "guard at the top and leave, keep the body flat, no `else` after a branch that already left, and a switch over a defined type rather than a ladder of comparisons on one subject, which no rule enforces and the skill says so."
                            },
                            {
                                "description": "A rule of the project's own, by name.",
                                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                            }
                        ],
                        "type": "string"
                    },
                    "type": "array",
                    "uniqueItems": true
                }
            },
            "type": "object"
        },
        "exclude": {
            "description": "Paths judge does not read at all, so nothing in them is reported on or rewritten. A path is read against the project; a pattern holding `*` or `?` matches as fnmatch does, and one opening with `**/` names that folder wherever it lies, at the top of the project included, so `**/dist` covers every module's own. One rule may be let in anyway with a `judges` call under it in `configure`.",
            "items": {
                "type": "string"
            },
            "type": "array",
            "uniqueItems": true
        },
        "hooks": {
            "description": "Hooks turned on beyond the ones every project runs, by name.",
            "items": {
                "type": "string"
            },
            "type": "array",
            "uniqueItems": true
        },
        "packages": {
            "description": "The project's own exemption packages in .commandments/custom/, by name.",
            "items": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                "type": "string"
            },
            "type": "array",
            "uniqueItems": true
        },
        "parallel": {
            "description": "How many detectors judge runs at once when no --parallel says; more use more cores and memory. Left out, judge runs 2.",
            "minimum": 1,
            "type": "integer"
        },
        "paths": {
            "description": "The source roots judge scans when it is given no path, relative to the project.",
            "items": {
                "type": "string"
            },
            "type": "array",
            "uniqueItems": true
        }
    },
    "title": "code-commandments project config",
    "type": "object"
}

