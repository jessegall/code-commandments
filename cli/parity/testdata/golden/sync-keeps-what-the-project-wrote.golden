{
    "$defs": {
        "literal": {
            "anyOf": [
                {
                    "type": [
                        "string",
                        "integer",
                        "boolean",
                        "null"
                    ]
                },
                {
                    "items": {
                        "$ref": "#/$defs/literal"
                    },
                    "type": "array"
                }
            ],
            "description": "A string, a whole number, true, false, null, or a list of those."
        }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "How `vendor/bin/commandments judge` reads this project. Every key is optional; `vendor/bin/commandments config` shows what runs.",
    "properties": {
        "$schema": {
            "description": "The schema this file is checked against, written by `vendor/bin/commandments sync`.",
            "type": "string"
        },
        "agents": {
            "description": "Agents a config from the PHP tool turned on by name. Every project runs both agents the tool ships and it ships no other, so each name here is skipped, and said so.",
            "items": {
                "type": "string"
            },
            "type": "array",
            "uniqueItems": true
        },
        "base": {
            "description": "The branch `--branch` compares against when it names none: this project's trunk. Left out, it is main. A branch named on the command line always wins.",
            "minLength": 1,
            "type": "string"
        },
        "cache_hours": {
            "description": "How many hours anything kept between runs stays once nothing uses it: parsed trees, the rules' answers per file, mypy's cache and the edit windows. Every use resets the clock. Left out, 12.",
            "exclusiveMinimum": 0,
            "type": "number"
        },
