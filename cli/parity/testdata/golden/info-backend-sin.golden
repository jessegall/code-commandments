[1mswallow-catch[0m  [2mshared/exceptions[0m
  A `catch` whose body is empty, or only returns `null`/`false`/an empty value or moves
  on: the failure becomes something that looks like an answer

[33mWhy it is a sin[0m

  A failure is loud, named and carries its cause. Code that catches a failure does
  something about it,
  or does not catch it at all. These rules hold the same in every language, so every
  language is judged
  by them the same way.

[33mHow to fix it[0m

  Let a failure throw, or surface it named with its cause; never swallow a catch into an
  empty body or an absent value.
  Rethrow it wrapped with the caught failure as its cause, or catch, log and skip at one
  named boundary.

[33mExample[0m

  In PHP:
  
  ```php
  ----------[ Bad ]----------
  
  public function forecast(string $city): array
  {
      try {
          $body = $this->http->get("https://weather.test/{$city}");
  
          return (array) json_decode($body, true);
      } catch (\Throwable $e) {
          return [];
      }
  }
  
  ----------[ Good ]----------
  
  public function forecastOrThrow(string $city): array
  {
      try {
          $body = $this->http->get("https://weather.test/{$city}");
  
          return (array) json_decode($body, true);
      } catch (\Throwable $e) {
          report($e);
  
          throw $e;
      }
  }
  ```
  
  In TypeScript:
  
  ```ts
  ----------[ Bad ]----------
  
  export function parsedReturnReason(raw: string): unknown {
      try {
          return JSON.parse(raw)
      }
      catch {
          return null
      }
  }
  
  ----------[ Good ]----------
  
  export function returnReason(raw: string): unknown {
      return JSON.parse(raw)
  }
  ```
  
  In Python:
  
  ```py
  ----------[ Bad ]----------
  
  def load_catalog(path: Path):
      try:
          return Catalog(json.loads(path.read_text()))
      except Exception:
          return {}
  
  ----------[ Good ]----------
  
  # in catalog_file.py
  @dataclass(frozen=True)
  class Catalog:
      products: dict
  
  # in catalog_file.py
  class CatalogUnreadable(Exception):
      @classmethod
      def at(cls, path: Path) -> "CatalogUnreadable":
          return cls(f"the catalog at {path} is not valid JSON")
  
  # in catalog_file.py
  def read_catalog(path: Path) -> Catalog:
      try:
          return Catalog(json.loads(path.read_text()))
      except json.JSONDecodeError as error:
          raise CatalogUnreadable.at(path) from error
  ```
  
  In C#:
  
  ```cs
  ----------[ Bad ]----------
  
  public Dictionary<string, int>? Load()
  {
      try
      {
          return JsonSerializer.Deserialize<Dictionary<string, int>>(File.ReadAllText(Path.Combine(folder, "stock.json")));
      }
      catch (Exception)
      {
          return null;
      }
  }
  
  ----------[ Good ]----------
  
  public Dictionary<string, int> LoadOrEmpty()
  {
      try
      {
          return JsonSerializer.Deserialize<Dictionary<string, int>>(File.ReadAllText(Path.Combine(folder, "stock.json"))) ?? [];
      }
      catch (FileNotFoundException)
      {
          return [];
      }
  }
  ```
  
  In Go:
  
  ```go
  ----------[ Bad ]----------
  
  func importBins(codes []string, read func(string) error) int {
  	loaded := 0
  	for _, code := range codes {
  		if err := read(code); err != nil {
  			continue
  		}
  		loaded++
  	}
  
  	return loaded
  }
  
  ----------[ Good ]----------
  
  func receiveAllBins(codes []string, read func(string) error) error {
  	for _, code := range codes {
  		if err := read(code); err != nil {
  			return err
  		}
  	}
  
  	return nil
  }
  ```

