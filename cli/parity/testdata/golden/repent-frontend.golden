=== changed components/StockIndicator.vue
<script setup lang="ts">
defineProps<{ stock: number }>();
</script>

<template>
  <!-- Range checks, not equality on one value — a genuine conditional, NOT a switch. -->
  <!-- @sin ControlFlowOnElement -->
  <template v-if="stock > 10">
    <span class="text-green-600">In stock</span>
  </template>
  <!-- @sin ControlFlowOnElement -->
  <template v-else-if="stock > 0">
    <span class="text-amber-600">Only a few left</span>
  </template>
  <!-- @sin ControlFlowOnElement -->
  <template v-else>
    <span class="text-red-600">Sold out</span>
  </template>
</template>

=== changed components/StorefrontHero.vue
<script setup lang="ts">
import CampaignSection from './CampaignSection.vue';

import type { Storefront } from '@/types';

defineProps<{ storefront: Storefront }>();
</script>

<template>
  <header class="hero">
    <div class="hero__bar">
      <span class="hero__name">{{ storefront.name }}</span>
      <span class="hero__status">{{ storefront.open }}</span>
    </div>

    <!-- A cluster: storefront.campaign read in three fields → extract <HeroBanner :campaign>. -->
    <!-- @sin DeepDataReach -->
    <CampaignSection :campaign="storefront.campaign" />

    <nav class="hero__nav">
      <ul class="hero__links">
        <!-- @sin ControlFlowOnElement -->
        <template v-for="link in storefront.links" :key="link.id">
          <li class="hero__link">
            <span class="hero__link-label">{{ link.label }}</span>
          </li>
        </template>
      </ul>
    </nav>

    <div class="hero__promo">
      <h2 class="hero__promo-title">Featured</h2>
      <!-- Righteous: a LONE deep reach (one field off storefront.featured) is no cluster. -->
      <p class="hero__promo-text">{{ storefront.featured.product.name }}</p>
      <p class="hero__promo-price">{{ storefront.featuredPrice }}</p>
    </div>

    <div class="hero__meta">
      <span class="hero__hours">{{ storefront.hours }}</span>
      <span class="hero__location">{{ storefront.location }}</span>
      <span class="hero__rating">{{ storefront.rating }}</span>
    </div>

    <div class="hero__categories">
      <h2 class="hero__cat-title">Browse the store</h2>
      <ul class="hero__cat-list">
        <li class="hero__cat">New arrivals</li>
        <li class="hero__cat">Best sellers</li>
        <li class="hero__cat">On sale this week</li>
        <li class="hero__cat">Clearance</li>
      </ul>
    </div>

    <dl class="hero__stats">
      <!-- @sin IndexAsKey -->
      <template v-for="(value, label, index) in storefront.stats" :key="index">
        <dt class="hero__stat-label">{{ label }}</dt>
        <dd class="hero__stat-value">{{ value }}</dd>
      </template>
    </dl>

    <div class="hero__cta">
      <button class="hero__shop" type="button">Shop now</button>
      <button class="hero__learn" type="button">Learn more</button>
    </div>
  </header>
</template>

