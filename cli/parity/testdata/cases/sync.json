 {
  "name": "sync-keeps-what-the-project-wrote",
  "pending": "task 120: the project's AGENTS.md is written with CRLF and sync appends its block with LF, so the file comes out mixed where this recording holds it all as LF. The block has to be written in the document's own line endings before this can match.",
  "args": [
   "sync"
  ],
  "digest": [
   ".agents/skills"
  ],
  "setup": [
   "git init -q",
   "mkdir -p src .commandments .agents/skills/mine",
   "printf '{\"name\": \"acme/app\", \"scripts\": {\"post-install-cmd\": \"@php artisan x\"}}' > composer.json",
   "printf '# Ours\\r\\n\\r\\nKeep this.\\r\\n' > AGENTS.md",
   "printf 'vendor/\\n.commandments/\\n' > .gitignore",
   "printf 'my-rule\\n' > .commandments/.gitignore",
   "printf 'mine' > .agents/skills/mine/SKILL.md"
  ]
 },
 {
