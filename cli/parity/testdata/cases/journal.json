  "stdin": "{}"
 },
 {
  "name": "journal-hook-stop-with-changes",
  "args": [
   "journal-hook"
  ],
  "setup": [
   "git init -q && git -c user.email=a@b -c user.name=a commit -q --allow-empty -m init",
   "mkdir -p src",
   "printf '<?php\\n' > src/A.php"
  ],
  "stdin": "{\"event\":\"hook.Stop\",\"agent\":{\"session\":\"s1\"}}",
  "env": {
   "GIT_AUTHOR_DATE": "2026-01-01T00:00:00Z",
   "GIT_COMMITTER_DATE": "2026-01-01T00:00:00Z"
  }
 },
 {
  "name": "journal-hook-gate-refuses",
  "args": [
   "journal-hook"
  ],
  "setup": [
   "git init -q && git -c user.email=a@b -c user.name=a commit -q --allow-empty -m init",
   "git worktree add -q .wt/other 2>/dev/null"
  ],
  "stdin": "{\"event\":\"hook.PreToolUse\",\"agent\":{\"session\":\"s1\"},\"tool\":{\"name\":\"Bash\",\"command\":\"git pull --rebase\"}}",
  "env": {
   "GIT_AUTHOR_DATE": "2026-01-01T00:00:00Z",
   "GIT_COMMITTER_DATE": "2026-01-01T00:00:00Z"
  }
 },
 {
  "name": "journal-hook-write-a-sin",
  "args": [
   "journal-hook"
  ],
  "setup": [
   "git init -q && git -c user.email=a@b -c user.name=a commit -q --allow-empty -m init",
   "mkdir -p .commandments && printf '%s\\n' '<?php' 'return function ($config): void {' '    $config->paths(\"src\");' '};' > .commandments/config.php",
   "mkdir -p src && printf '%s\\n' '<?php' '' 'namespace App;' '' 'final class Order' '{' '    public function hides(): void' '    {' '    }' '' '    public function total(array $data): int' '    {' '        return $data[\"total\"] ?? 0;' '    }' '}' > src/Order.php"
  ],
  "stdin": "{\"event\":\"hook.PostToolUse\",\"agent\":{\"session\":\"s1\"},\"tool\":{\"name\":\"Write\",\"file\":\"src/Order.php\"}}",
  "env": {
   "GIT_AUTHOR_DATE": "2026-01-01T00:00:00Z",
   "GIT_COMMITTER_DATE": "2026-01-01T00:00:00Z"
  }
 },
 {
  "name": "journal-hook-write-a-sin-kept",
  "args": [
   "journal-hook"
  ],
  "setup": [
   "git init -q && git -c user.email=a@b -c user.name=a commit -q --allow-empty -m init",
   "mkdir -p .commandments && printf '%s\\n' '<?php' 'return function ($config): void {' '    $config->paths(\"src\");' '};' > .commandments/config.php",
   "mkdir -p src && printf '%s\\n' '<?php' '' 'namespace App;' '' 'final class Order' '{' '    public function hides(): void' '    {' '    }' '' '    public function total(array $data): int' '    {' '        return $data[\"total\"] ?? 0;' '    }' '}' > src/Order.php",
   "mkdir -p plugin-data"
  ],
  "stdin": "{\"event\":\"hook.PostToolUse\",\"agent\":{\"session\":\"s1\"},\"tool\":{\"name\":\"Write\",\"file\":\"src/Order.php\"}}",
  "env": {
   "GIT_AUTHOR_DATE": "2026-01-01T00:00:00Z",
   "GIT_COMMITTER_DATE": "2026-01-01T00:00:00Z",
   "JOURNAL_PLUGIN_DATA": "plugin-data"
  }
 },
 {
  "name": "journal-hook-sin-repented",
  "args": [
   "journal-hook"
  ],
  "setup": [
   "git init -q && git -c user.email=a@b -c user.name=a commit -q --allow-empty -m init",
   "mkdir -p .commandments && printf '%s\\n' '<?php' 'return function ($config): void {' '    $config->paths(\"src\");' '};' > .commandments/config.php",
   "mkdir -p src && printf '%s\\n' '<?php' '' 'namespace App;' '' 'final class Order' '{' '    public function hides(): void' '    {' '    }' '' '    public function total(array $data): int' '    {' '        return $data[\"total\"] ?? 0;' '    }' '}' > src/Order.php",
   "mkdir -p plugin-data",
   "echo '{\"event\":\"hook.PostToolUse\",\"agent\":{\"session\":\"s1\"},\"tool\":{\"name\":\"Write\",\"file\":\"src/Order.php\"}}' | JOURNAL_PLUGIN_DATA=plugin-data php \"$PARITY_PACKAGE/bin/commandments\" journal-hook > /dev/null",
   "printf '%s\\n' '<?php' '' 'namespace App;' '' 'final class Order' '{' '}' > src/Order.php"
  ],
  "stdin": "{\"event\":\"hook.PostToolUse\",\"agent\":{\"session\":\"s1\"},\"tool\":{\"name\":\"Write\",\"file\":\"src/Order.php\"}}",
  "env": {
   "GIT_AUTHOR_DATE": "2026-01-01T00:00:00Z",
   "GIT_COMMITTER_DATE": "2026-01-01T00:00:00Z",
   "JOURNAL_PLUGIN_DATA": "plugin-data"
  }
 },
 {
  "name": "journal-hook-quiet-hooks",
  "args": [
   "journal-hook"
  ],
  "setup": [
   "git init -q && git -c user.email=a@b -c user.name=a commit -q --allow-empty -m init",
   "mkdir -p src",
   "printf '<?php\\n' > src/A.php"
  ],
  "stdin": "{\"event\":\"hook.Stop\",\"agent\":{\"session\":\"s1\"}}",
  "env": {
   "GIT_AUTHOR_DATE": "2026-01-01T00:00:00Z",
   "GIT_COMMITTER_DATE": "2026-01-01T00:00:00Z",
   "COMMANDMENTS_QUIET_HOOKS": "JudgeReminder, Other"
  }
 },
 {
  "name": "journal-scan",
  "args": [
   "journal-scan"
  ],
  "setup": [
   "mkdir -p src/Domain vendor/x node_modules resources/js",
   "printf '<?php\\n' > src/Domain/A.php",
   "printf 'x' > resources/js/app.ts",
   "printf '{\"autoload\": {\"psr-4\": {\"App\\\\\\\\\": \"src/\"}}}' > composer.json"
  ]
 },
