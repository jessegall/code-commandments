[
 {
  "name": "journal-config-help",
  "args": [
   "journal-config",
   "--help"
  ]
 },
 {
  "name": "journal-scan-help",
  "args": [
   "journal-scan",
   "--help"
  ]
 },
 {
  "name": "journal-skills-help",
  "args": [
   "journal-skills",
   "--help"
  ]
 },
 {
  "name": "journal-scan",
  "args": [
   "journal-scan"
  ],
  "setup": [
   "mkdir -p src/Domain vendor/x node_modules resources/js",
   "printf '<?php\\n' > src/Domain/A.php",
   "printf 'x' > resources/js/app.ts",
   "printf '{\"autoload\": {\"psr-4\": {\"App\\\\\\\\\": \"src/\"}}}' > composer.json"
  ]
 },
 {
  "name": "journal-config-without-settings",
  "args": [
   "journal-config"
  ]
 },
 {
  "name": "journal-config-applies",
  "args": [
   "journal-config"
  ],
  "setup": [
   "mkdir -p src lib"
  ],
  "env": {
   "JOURNAL_SETTINGS": "{\"language_py\": \"false\", \"language_php\": \"true\", \"sin_array-bag\": \"false\", \"sin_narrated-command\": \"true\", \"folders_judged\": \"src\\nlib\\n\", \"folders_skipped\": \"src/Generated\"}"
  }
 }
]
