[
  {"name": "disable-help", "args": ["disable", "--help"]},
  {"name": "enable-help-verb", "args": ["help", "enable"]},
  {"name": "disable-without-a-name", "args": ["disable"]},
  {"name": "disable-unknown", "args": ["disable", "zz-nothing-like-it"]},
  {"name": "disable-ambiguous", "args": ["disable", "python-dict"]},
  {"name": "disable-scaffolds-the-config", "args": ["disable", "python-dict-bag"], "setup": ["mkdir -p src"]},
  {"name": "disable-a-skill-by-slug", "args": ["disable", "python/absence"], "setup": ["mkdir -p .commandments", "printf '%s\\n' '{\"paths\": [\"src\"]}' > .commandments/config.json"]},
  {"name": "disable-into-a-one-line-call", "args": ["disable", "duplicate-element"], "setup": ["mkdir -p .commandments", "printf '%s\\n' '{\"disable\": {\"languages\": [\"python\"]}}' > .commandments/config.json"]},
  {"name": "disable-already-disabled", "args": ["disable", "duplicate-element"], "setup": ["mkdir -p .commandments", "printf '%s\\n' '{\"disable\": {\"sins\": [\"duplicate-element\"]}}' > .commandments/config.json"]},
  {"name": "enable-a-disabled-sin", "args": ["enable", "duplicate-element"], "setup": ["mkdir -p .commandments", "printf '%s\\n' '{\"disable\": {\"sins\": [\"duplicate-element\", \"python-dict-bag\"]}}' > .commandments/config.json"]},
  {"name": "enable-not-disabled", "args": ["enable", "python-dict-bag"], "setup": ["mkdir -p .commandments", "printf '%s\\n' '{}' > .commandments/config.json"]},
  {"name": "enable-without-a-config", "args": ["enable", "python-dict-bag"]}
]
