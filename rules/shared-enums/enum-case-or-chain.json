    },
    "caseOwner": {
      "args": [
        "c"
      ],
      "expr": [
        "case",
        [
          "nonempty",
          [
            "enumOwner",
            [
              "declarationOf",
              [
                "at",
                "$c.operands",
                1
              ]
            ]
          ]
        ],
        {
          "true": [
            "enumOwner",
            [
              "declarationOf",
              [
                "at",
                "$c.operands",
                1
              ]
            ]
          ]
        },
        [
          "enumOwner",
          [
            "declarationOf",
            [
              "at",
              "$c.operands",
              0
            ]
          ]
        ]
      ]
    },
    "subjectOf": {
      "args": [
        "c"
      ],
      "expr": [
