            [
              "at",
              "$c.operands",
              0
            ],
            "exact"
          ]
        },
        [
          "fingerprint",
          [
            "at",
            "$c.operands",
            1
          ],
          "exact"
        ]
      ]
    }
  },
  "find": {
    "select": "logical",
    "as": "l",
    "where": [
      "and",
      [
        "=",
        "$l.operator",
        "or"
      ],
      [
        "!=",
        "$l.parent.kind",
        "logical"
      ]
    ],
    "let": [
      [
        "checks",
        [
          "leaves",
          "$l",
          "logical"
        ]
      ],
      [
        "owners",
        [
          "map",
          "$checks",
          "c",
          [
            "caseOwner",
            "$c"
          ]
        ]
      ],
      [
