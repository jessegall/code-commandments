        [
          "map",
          "$checks",
          "c",
          [
            "subjectOf",
            "$c"
          ]
        ]
      ]
    ],
    "having": [
      "and",
      [
        ">=",
        [
          "count",
          "$checks"
        ],
        2
      ],
      [
        "every",
        "$checks",
        "c",
        [
          "and",
          [
            "=",
            "$c.kind",
            "comparison"
          ],
          [
            "every",
            "$c.operators",
            "o",
            [
              "in",
              "$o",
              "equal",
              "identical"
            ]
          ]
        ]
      ],
      [
        "every",
        "$owners",
        "o",
        [
          "nonempty",
          "$o"
        ]
      ],
      [
        "=",
        [
          "distinctCount",
          "$owners"
        ],
        1
      ],
      [
        "=",
        [
