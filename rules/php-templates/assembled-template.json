{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "csharp",
    "go",
    "php",
    "python",
    "typescript"
  ],
  "sin": {
    "name": "assembled-template",
    "aliases": [
      "AssembledTemplateDetector",
      "AssembledTemplate",
      "csharp-assembled-template",
      "python-assembled-template"
    ],
    "skill": "php/templates",
    "description": "A multi-line template assembled as an array of line fragments and joined with a newline \u2014 the output is unreadable in the source that emits it",
    "rule": "State a fixed multi-line string as a heredoc, at its real indentation, and interpolate what varies \u2014 never as a list of line fragments joined by a newline.",
    "suggestion": "A heredoc (`<<<PHP` / `<<<'PHP'`), with the computed part as one interpolation."
  },
  "find": {
    "select": "call",
    "as": "c",
    "where": [
      "not",
      "$c.file.test"
    ],
    "having": [
      "and",
      [
        "some",
        [
          "fragments",
          "$c"
        ],
        "x",
        [
          "newline",
          "$x"
        ]
      ],
      [
        "or",
        [
          "some",
          [
            "map",
            [
              "fragments",
              "$c"
            ],
            "x",
            [
              "listOf",
              "$x"
            ]
          ],
          "k",
          [
            "and",
            [
              "exists",
              "$k"
            ],
            [
              "=",
              "$k.kind",
              "collection"
            ],
            [
              ">=",
              [
                "count",
                "$k.entries"
              ],
              3
            ],
            [
              ">=",
              [
                "count",
                [
                  "filter",
                  "$k.entries",
                  "e",
                  [
                    "spelledText",
                    "$e.value"
                  ]
                ]
              ],
              2
            ]
          ]
        ],
        [
          ">=",
          [
            "count",
            [
              "filter",
              "$c.arguments",
              "g",
              [
                "spelledText",
                "$g.value"
              ]
            ]
          ],
          3
        ]
      ]
    ],
    "emit": "$c"
  },
  "definitions": {
    "newline": {
      "args": [
        "x"
      ],
      "expr": [
        "or",
        [
          "and",
          [
            "=",
            "$x.kind",
            "literal"
          ],
          [
            "=",
            "$x.literalKind",
            "string"
          ],
          [
            "=",
            "$x.value",
            "\n"
          ]
        ],
        [
          "and",
          [
            "=",
            "$x.constantValue.type",
            "string"
          ],
          [
            "=",
            "$x.constantValue.value",
            "\n"
          ]
        ],
        [
          "has",
          [
            "identities",
            "newline"
          ],
          "$x.refers"
        ],
        [
          "has",
          [
            "identities",
            "newline"
          ],
          "$x.member.refers"
        ]
      ]
    },
    "heldValue": {
      "args": [
        "b"
      ],
      "expr": [
        "case",
        "$b.parent.kind",
        {
          "declarator": "$b.parent.initializer",
          "assignment": [
            "at",
            "$b.parent.values",
            0
          ]
        },
        null
      ]
    },
    "listOf": {
      "args": [
        "x"
      ],
      "expr": [
        "case",
        "$x.kind",
        {
          "collection": "$x",
          "reference": [
            "case",
            [
              "exists",
              "$x.binding"
            ],
            {
              "true": [
                "heldValue",
                "$x.binding"
              ]
            },
            null
          ]
        },
        null
      ]
    },
    "fragments": {
      "args": [
        "c"
      ],
      "expr": [
        "flatten",
        [
          "list",
          [
            "map",
            "$c.arguments",
            "g",
            "$g.value"
          ],
          [
            "list",
            "$c.callee.subject"
          ]
        ]
      ]
    },
    "spelledText": {
      "args": [
        "x"
      ],
      "expr": [
        "in",
        "$x.kind",
        "literal",
        "interpolation"
      ]
    }
  }
}
