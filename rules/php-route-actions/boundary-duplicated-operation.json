{
  "$schema": "commandments:generic-rule/v2",
  "engine": [
    "php"
  ],
  "sin": {
    "name": "boundary-duplicated-operation",
    "aliases": [
      "BoundaryDuplicatedOperationDetector",
      "BoundaryDuplicatedOperation"
    ],
    "skill": "php/route-actions",
    "description": "The same domain operation hand-rolled at two DIFFERENT entry boundaries (a console command and an MCP tool, a controller and a command) — one operation with two implementations that drift",
    "rule": "One operation, one implementation. A boundary translates its own protocol and calls the shared application service; it does not re-spell the operation.",
    "suggestion": "Hoist the shared sequence into one application service and have both faces call it.",
    "requires": {
      "name": "illuminate/support",
      "ecosystem": "composer"
    },
    "reporting": {
      "crossFile": true
    }
  },
  "find": {
    "relations": {
      "entries": {
        "from": "function",
        "as": "f",
        "pipeline": [
          {
            "where": [
              "and",
              [
                "=",
                "$f.form",
                "method"
              ],
              [
                "none",
                "$f.modifiers",
                "m",
                [
                  "in",
                  "$m",
                  "private",
                  "protected"
                ]
              ],
              [
                "reportable",
                "$f"
              ],
              [
                "exists",
                [
                  "enclosing",
                  "$f",
                  "type"
                ]
              ]
            ]
          },
          {
            "project": {
              "anchor": "$f",
              "every": true,
              "pre": [
                "laravel.boundaryKind",
                "$f"
              ],
              "key": [
                "concat",
                [
                  "tree.ownSymbol",
                  [
                    "enclosing",
                    "$f",
                    "type"
                  ]
                ],
                "::",
                "$f.name"
              ]
            }
          },
          {
            "join": "laravel-route-actions",
            "as": "own",
            "on": {
              "action": "$key"
            }
          },
          {
            "project": {
              "kind": [
                "case",
                [
                  "nonempty",
                  "$pre"
                ],
                {
                  "true": "$pre"
                },
                [
                  "case",
                  [
                    "or",
                    [
                      "exists",
                      "$own"
                    ],
                    [
                      "laravel.handlesRequest",
                      "$f"
                    ]
                  ],
                  {
                    "true": "http"
                  },
                  ""
                ]
              ]
            }
          },
          {
            "where": [
              "nonempty",
              "$kind"
            ]
          },
          {
            "project": {
              "calls": [
                "laravel.boundaryCalls",
                "$f"
              ],
              "flows": [
                "laravel.boundaryFlows",
                "$f"
              ],
              "owners": [
                "laravel.boundaryOwners",
                "$f"
              ],
              "decides": [
                "some",
                [
                  "ownDescendants",
                  "$f.body"
                ],
                "x",
                [
                  "in",
                  "$x.kind",
                  "if",
                  "loop",
                  "dispatch",
                  "try",
                  "throw",
                  "conditional"
                ]
              ]
            }
          },
          {
            "where": [
              ">=",
              [
                "count",
                "$calls"
              ],
              2
            ]
          }
        ]
      },
      "entry-calls": {
        "from": "entries",
        "as": "e",
        "pipeline": [
          {
            "expand": "$e.calls"
          },
          {
            "project": {
              "call": "$row"
            }
          }
        ]
      }
    },
    "from": "entries",
    "as": "e",
    "pipeline": [
      {
        "join": "entries",
        "as": "o",
        "on": {
          "every": "$e.every"
        },
        "mode": "all"
      },
      {
        "where": [
          "!=",
          "$o.kind",
          "$e.kind"
        ]
      },
      {
        "project": {
          "shared": [
            "filter",
            "$e.calls",
            "k",
            [
              "and",
              [
                "has",
                "$o.calls",
                "$k"
              ],
              [
                "<=",
                [
                  "countOf",
                  "entry-calls",
                  [
                    "record",
                    "call",
                    "$k"
                  ]
                ],
                3
              ]
            ]
          ]
        }
      },
      {
        "where": [
          "or",
          [
            ">=",
            [
              "count",
              [
                "filter",
                "$e.owners",
                "t",
                [
                  "has",
                  "$o.owners",
                  "$t"
                ]
              ]
            ],
            2
          ],
          [
            "and",
            [
              "not",
              "$e.decides"
            ],
            [
              "not",
              "$o.decides"
            ]
          ]
        ]
      },
      {
        "where": [
          "or",
          [
            ">=",
            [
              "count",
              "$shared"
            ],
            3
          ],
          [
            "and",
            [
              "=",
              [
                "count",
                "$shared"
              ],
              2
            ],
            [
              "some",
              "$e.flows",
              "fl",
              [
                "and",
                [
                  "has",
                  "$o.flows",
                  "$fl"
                ],
                [
                  "has",
                  "$shared",
                  [
                    "get",
                    "$fl",
                    "producer"
                  ]
                ],
                [
                  "has",
                  "$shared",
                  [
                    "get",
                    "$fl",
                    "consumer"
                  ]
                ]
              ]
            ]
          ]
        ]
      },
      {
        "emit": "$e.anchor"
      }
    ]
  }
}
