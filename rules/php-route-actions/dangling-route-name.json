{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "php"
  ],
  "sin": {
    "name": "dangling-route-name",
    "aliases": [
      "DanglingRouteNameDetector",
      "DanglingRouteName"
    ],
    "skill": "php/route-actions",
    "description": "A `route('x')` lookup naming a route no registration mints — a stringly cross-reference that only fails at runtime, as a 500",
    "rule": "The route-name vocabulary is a CLOSED set: every name looked up must be a name some route registers. Renaming a route means renaming its references in the same breath.",
    "suggestion": "Point the lookup at the registered name, or register the route the name promises.",
    "requires": {
      "name": "illuminate/support",
      "ecosystem": "composer"
    },
    "reporting": {
      "crossFile": true
    },
    "unpublished": true
  },
  "find": {
    "relations": {
      "route-name-calls": {
        "from": "call",
        "as": "c",
        "pipeline": [
          {
            "where": [
              "and",
              [
                "=",
                "$c.callee.kind",
                "access"
              ],
              [
                "=",
                "$c.callee.member.name",
                "name"
              ],
              [
                "laravel.routed",
                "$c"
              ],
              [
                "not",
                [
                  "laravel.opensGroup",
                  "$c"
                ]
              ]
            ]
          },
          {
            "project": {
              "anchor": "$c",
              "prefix": [
                "laravel.prefixOf",
                "$c"
              ],
              "first": [
                "laravel.firstValue",
                "$c"
              ]
            }
          },
          {
            "project": {
              "kind": [
                "laravel.nameKind",
                "$first"
              ],
              "name": [
                "concat",
                "$prefix",
                [
                  "laravel.nameText",
                  "$first"
                ]
              ]
            }
          }
        ]
      },
      "route-groups": {
        "from": "call",
        "as": "g",
        "pipeline": [
          {
            "where": [
              "laravel.groupCall",
              "$g"
            ]
          },
          {
            "project": {
              "anchor": "$g",
              "name": [
                "stripSuffix",
                [
                  "concat",
                  [
                    "laravel.prefixOf",
                    "$g"
                  ],
                  [
                    "laravel.groupPrefix",
                    "$g"
                  ]
                ],
                "."
              ]
            }
          },
          {
            "where": [
              "nonempty",
              "$name"
            ]
          },
          {
            "project": {
              "kind": "exact"
            }
          }
        ]
      },
      "route-resources": {
        "from": "call",
        "as": "c",
        "pipeline": [
          {
            "where": [
              "and",
              [
                "=",
                "$c.callee.kind",
                "access"
              ],
              [
                "in",
                "$c.callee.member.name",
                "resource",
                "apiResource"
              ],
              [
                "laravel.routed",
                "$c"
              ]
            ]
          },
          {
            "project": {
              "anchor": "$c",
              "prefix": [
                "laravel.prefixOf",
                "$c"
              ],
              "first": [
                "laravel.firstValue",
                "$c"
              ]
            }
          },
          {
            "project": {
              "kind": [
                "case",
                [
                  "literalIs",
                  "$first",
                  "string"
                ],
                {
                  "true": "family"
                },
                "dynamic"
              ],
              "name": [
                "concat",
                "$prefix",
                [
                  "laravel.nameText",
                  "$first"
                ],
                "."
              ]
            }
          }
        ]
      },
      "route-names": {
        "from": [
          "unionAll",
          "route-name-calls",
          "route-groups",
          "route-resources",
          "route-array-names"
        ],
        "as": "r"
      },
      "route-array-names": {
        "from": "call",
        "as": "c",
        "pipeline": [
          {
            "where": [
              "and",
              [
                "=",
                "$c.callee.kind",
                "access"
              ],
              [
                "in",
                "$c.callee.member.name",
                "get",
                "post",
                "put",
                "patch",
                "delete",
                "any",
                "options",
                "match",
                "head"
              ],
              [
                "laravel.routed",
                "$c"
              ],
              [
                "nonempty",
                [
                  "laravel.keyedLiteral",
                  "$c",
                  "as"
                ]
              ]
            ]
          },
          {
            "project": {
              "anchor": "$c",
              "prefix": [
                "laravel.prefixOf",
                "$c"
              ],
              "first": [
                "laravel.keyedLiteral",
                "$c",
                "as"
              ]
            }
          },
          {
            "project": {
              "kind": "exact",
              "name": [
                "concat",
                "$prefix",
                "$first"
              ]
            }
          }
        ]
      }
    },
    "select": "call",
    "as": "c",
    "where": [
      "and",
      [
        "laravel.routeLookup",
        "$c"
      ],
      [
        "nonempty",
        [
          "laravel.firstLiteral",
          "$c"
        ]
      ]
    ],
    "let": [
      [
        "name",
        [
          "laravel.firstLiteral",
          "$c"
        ]
      ]
    ],
    "having": [
      "and",
      [
        ">",
        [
          "countOf",
          "route-names",
          [
            "record",
            "kind",
            "exact"
          ]
        ],
        0
      ],
      [
        "not",
        [
          "or",
          [
            "hasRow",
            "route-names",
            [
              "record",
              "kind",
              "dynamic"
            ]
          ],
          [
            "hasRow",
            "route-names",
            [
              "record",
              "kind",
              "exact",
              "name",
              "$name"
            ]
          ],
          [
            "some",
            [
              "rowsOf",
              "route-names",
              [
                "record",
                "kind",
                "family"
              ]
            ],
            "r",
            [
              "startsWith",
              "$name",
              [
                "get",
                "$r",
                "name"
              ]
            ]
          ],
          [
            "some",
            [
              "rowsOf",
              "route-names",
              [
                "record",
                "kind",
                "exact"
              ]
            ],
            "r",
            [
              "endsWith",
              "$name",
              [
                "concat",
                ".",
                [
                  "get",
                  "$r",
                  "name"
                ]
              ]
            ]
          ]
        ]
      ],
      [
        "not",
        [
          "some",
          [
            "identities",
            "package-route-name"
          ],
          "i",
          [
            "startsWith",
            "$name",
            "$i"
          ]
        ]
      ]
    ],
    "emit": "$c"
  }
}
