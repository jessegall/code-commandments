            [
              "flatten",
              [
                "map",
                [
                  "flatten",
                  [
                    "list",
                    [
                      "list",
                      "$m"
                    ],
                    "$m.hooks"
                  ]
                ],
                "h",
                [
                  "descendants",
                  "$h"
                ]
              ]
            ],
            "x",
            [
              "and",
              [
                "=",
                "$x.kind",
                "reference"
              ],
              [
                "some",
                [
                  "before",
                  "$m"
                ],
                "p",
