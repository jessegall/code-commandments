{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "csharp",
    "php",
    "python",
    "typescript"
  ],
  "sin": {
    "name": "member-out-of-order",
    "aliases": [
      "MemberOutOfOrderDetector",
      "MemberOutOfOrder",
      "csharp-member-out-of-order",
      "python-member-out-of-order"
    ],
    "skill": "php/class-layout",
    "description": "A declaration in the head of a class that arrives after something belonging below it — a constant under a property, a public field under a private one, a hook above the fields it reads",
    "rule": "Order the head of a class the same way every time: trait uses, enum cases, constants, static properties, then instance properties public → protected → private, and hooked (derived) properties last, after the fields they read from."
  },
  "definitions": {
    "rank": {
      "args": [
        "m"
      ],
      "expr": [
        "case",
        "$m.file.language",
        {
          "php": [
            "case",
            "$m.kind",
            {
              "enum-case": 1,
              "constant": 2,
              "field": [
                "case",
                [
                  "some",
                  "$m.modifiers",
                  "x",
                  [
                    "=",
                    "$x",
                    "static"
                  ]
                ],
                {
                  "true": 3
                },
                [
                  "add",
                  [
                    "case",
                    [
                      ">",
                      [
                        "count",
                        "$m.hooks"
                      ],
                      0
                    ],
                    {
                      "true": 7
                    },
                    4
                  ],
                  [
                    "case",
                    [
                      "some",
                      "$m.modifiers",
                      "x",
                      [
                        "=",
                        "$x",
                        "private"
                      ]
                    ],
                    {
                      "true": 2
                    },
                    [
                      "case",
                      [
                        "some",
                        "$m.modifiers",
                        "x",
                        [
                          "=",
                          "$x",
                          "protected"
                        ]
                      ],
                      {
                        "true": 1
                      },
                      0
                    ]
                  ]
                ]
              ],
              "function": 10
            },
            0
          ]
        },
        [
          "case",
          "$m.kind",
          {
            "enum-case": 1,
            "constant": 1,
            "field": [
              "case",
              [
                "and",
                [
                  "some",
                  "$m.modifiers",
                  "x",
                  [
                    "=",
                    "$x",
                    "static"
                  ]
                ],
                [
                  "some",
                  "$m.modifiers",
                  "x",
                  [
                    "in",
                    "$x",
                    "readonly",
                    "const",
                    "final"
                  ]
                ]
              ],
              {
                "true": 1
              },
              2
            ],
            "function": 3
          },
          0
        ]
      ]
    }
  },
  "find": {
    "select": [
      "field",
      "constant",
      "enum-case"
    ],
    "as": "m",
    "where": [
      "=",
      "$m.parent.kind",
      "type"
    ],
    "let": [
      [
        "mine",
        [
          "rank",
          "$m"
        ]
      ],
      [
        "methods",
        [
          "case",
          "$m.file.language",
          {
            "php": 10
          },
          3
        ]
      ],
      [
        "earlier",
        [
          "map",
          [
            "before",
            "$m"
          ],
          "p",
          [
            "rank",
            "$p"
          ]
        ]
      ]
    ],
    "having": [
      "and",
      [
        ">",
        "$mine",
        0
      ],
      [
        "none",
        "$earlier",
        "r",
        [
          ">=",
          "$r",
          "$methods"
        ]
      ],
      [
        "some",
        "$earlier",
        "r",
        [
          ">",
          "$r",
          "$mine"
        ]
      ]
    ],
    "emit": "$m"
  }
}
