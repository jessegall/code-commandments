{
  "$schema": "commandments:generic-rule/v2",
  "engine": [
    "vue"
  ],
  "sin": {
    "name": "control-flow-on-element",
    "aliases": [
      "ControlFlowOnElementDetector",
      "ControlFlowOnElement"
    ],
    "skill": "vue/vue-control-flow",
    "description": "`v-if`/`v-for`/`v-else`/`v-else-if` on an HTML/component tag instead of a `<template>`",
    "rule": "Put `v-if`/`v-for`/`v-else`/`v-else-if` on a `<template>`, never directly on an HTML or component tag."
  },
  "find": {
    "select": "element",
    "as": "e",
    "where": [
      "and",
      [
        "not",
        [
          "in",
          "$e.tag",
          "template",
          "slot"
        ]
      ],
      [
        "some",
        "$e.attributes",
        "a",
        [
          "and",
          [
            "=",
            "$a.kind",
            "directive"
          ],
          [
            "in",
            "$a.name",
            "if",
            "else-if",
            "else",
            "for"
          ]
        ]
      ]
    ],
    "having": [
      "not",
      [
        "and",
        [
          "=",
          "$e.parent.kind",
          "element"
        ],
        [
          "in",
          "$e.parent.tag",
          "Transition",
          "TransitionGroup",
          "transition",
          "transition-group"
        ]
      ]
    ],
    "emit": "$e"
  }
}
