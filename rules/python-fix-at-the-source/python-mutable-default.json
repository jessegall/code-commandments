{
  "$schema": "commandments:generic-rule/v2",
  "engine": [
    "python"
  ],
  "sin": {
    "name": "python-mutable-default",
    "aliases": [
      "MutableDefaultDetector",
      "MutableDefault"
    ],
    "skill": "python/fix-at-the-source",
    "description": "a parameter defaulted to a `[]`, `{}` or `set()` \u2014 one container, made once, shared by every call that omits it",
    "rule": "Default a parameter to an immutable value; never to a container, which is built once when the def is defined and outlives every call.",
    "suggestion": "Default it to `None` and make the container inside the body, so each call gets its own."
  },
  "find": {
    "select": "parameter",
    "as": "p",
    "where": [
      "and",
      [
        "=",
        "$p.evaluated",
        "definition"
      ],
      [
        "exists",
        "$p.default"
      ],
      [
        "exists",
        "$p.parent.body"
      ]
    ],
    "having": [
      "or",
      [
        "and",
        [
          "=",
          "$p.default.kind",
          "collection"
        ],
        [
          "!=",
          "$p.default.form",
          "tuple"
        ]
      ],
      [
        "=",
        "$p.default.kind",
        "comprehension"
      ],
      [
        "proven",
        [
          "hasEffect",
          "$p.default",
          "builds-mutable"
        ]
      ]
    ],
    "emit": "$p"
  }
}
