                [
                  "tree.canon",
                  "$owner.name"
                ],
                "field",
                [
                  "tree.canon",
                  "$n"
                ],
                "strict",
                true
              ]
            ]
          ]
        ]
      ]
    ],
    "emit": "$s"
  },
  "definitions": {
    "fieldNames": {
      "args": [
        "s"
      ],
      "expr": [
        "case",
