          "static"
        ]
      ],
      [
        "=",
        "$s.declaredType.form",
        "keyword"
      ],
      [
        "=",
        "$s.declaredType.name",
        "string"
      ]
    ],
    "let": [
      [
        "owner",
        [
          "enclosing",
          "$s",
          "type"
        ]
      ]
    ],
    "having": [
      "and",
      [
        "exists",
        "$owner"
      ],
      [
        "some",
        [
          "fieldNames",
          "$s"
        ],
        "n",
        [
          "or",
          [
            "hasRow",
            "blank-questions",
            [
              "record",
              "type",
              [
                "tree.canon",
                "$owner.name"
              ],
              "field",
              [
                "tree.canon",
                "$n"
              ],
              "strict",
              false
            ]
          ],
          [
            "and",
            [
              "literalEquals",
              [
                "spatie.slotDefault",
                "$s"
              ],
              ""
            ],
            [
              "hasRow",
              "blank-questions",
              [
                "record",
