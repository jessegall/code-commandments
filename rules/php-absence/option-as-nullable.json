{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "php"
  ],
  "sin": {
    "name": "option-as-nullable",
    "aliases": [
      "OptionAsNullableDetector",
      "OptionAsNullable"
    ],
    "skill": "php/absence",
    "description": "`Option<T>` used as if it were nullable — `?Option`, `Option | null`, `unwrapOr(null)`",
    "rule": "Use `Option` as a real option (`some`/`none`/`match`); never `?Option`/`Option | null`/`unwrapOr(null)`.",
    "suggestion": "Wrap at the seam with `Option::fromNullable($x)`, then consume with `match`/`unwrapOr`.",
    "requires": {
      "name": "jessegall/php-types",
      "ecosystem": "composer"
    }
  },
  "definitions": {
    "nullableOption": {
      "args": [
        "t"
      ],
      "expr": [
        "and",
        [
          "or",
          [
            "=",
            "$t.nullable",
            true
          ],
          [
            "some",
            "$t.members",
            "m",
            [
              "and",
              [
                "=",
                "$m.kind",
                "keyword"
              ],
              [
                "=",
                "$m.name",
                "null"
              ]
            ]
          ]
        ],
        [
          "or",
          [
            "=",
            "$t.name",
            [
              "identity",
              "option"
            ]
          ],
          [
            "some",
            "$t.members",
            "m",
            [
              "=",
              "$m.name",
              [
                "identity",
                "option"
              ]
            ]
          ]
        ]
      ]
    }
  },
  "find": {
    "select": [
      "parameter",
      "declarator",
      "function",
      "call"
    ],
    "as": "s",
    "where": [
      "case",
      "$s.kind",
      {
        "parameter": [
          "nullableOption",
          [
            "typeOf",
            "$s"
          ]
        ],
        "declarator": [
          "and",
          [
            "=",
            "$s.parent.kind",
            "field"
          ],
          [
            "nullableOption",
            [
              "typeOf",
              "$s.parent"
            ]
          ]
        ],
        "function": [
          "nullableOption",
          "$s.resolved.returns"
        ],
        "call": [
          "and",
          [
            "=",
            "$s.callee.kind",
            "access"
          ],
          [
            "=",
            "$s.callee.member.name",
            "unwrapOr"
          ],
          [
            "or",
            [
              "!=",
              "$s.parent.kind",
              "argument"
            ],
            [
              "proven",
              [
                "=",
                [
                  "typeCategory",
                  [
                    "typeOf",
                    [
                      "parameterOf",
                      "$s.parent"
                    ]
                  ]
                ],
                "any"
              ]
            ]
          ],
          [
            "some",
            "$s.arguments",
            "a",
            [
              "and",
              [
                "=",
                [
                  "position",
                  "$a"
                ],
                0
              ],
              [
                "=",
                "$a.value.kind",
                "literal"
              ],
              [
                "=",
                "$a.value.literalKind",
                "null"
              ]
            ]
          ]
        ]
      },
      false
    ],
    "emit": "$s"
  }
}
