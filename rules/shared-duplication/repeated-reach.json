{
  "$schema": "commandments:generic-rule/v2",
  "engine": [
    "php"
  ],
  "sin": {
    "name": "repeated-reach",
    "aliases": [
      "RepeatedReach"
    ],
    "skill": "shared/duplication",
    "description": "One member of another object is reached through (`$request->headers->get(\u2026)`) at more than one site, instead of a method that names each value it reads",
    "rule": "Reach through another object's member once. When the object is yours, give it the method that answers; when it is not, wrap it in a reader, one small type with a named method per value.",
    "suggestion": "Wrap what you reach into in a reader (`LoaderCall::of($request)`) with one method per value (`loader()`, `input()`), or give the object you own the method (`$grant->isHolding()`), and call that.",
    "unpublished": true,
    "reporting": {
      "crossFile": false
    }
  },
  "definitions": {
    "reachesThrough": {
      "args": [
        "c"
      ],
      "expr": [
        "and",
        [
          "=",
          "$c.callee.kind",
          "access"
        ],
        [
          "=",
          "$c.callee.form",
          "instance"
        ],
        [
          "=",
          "$c.callee.subject.kind",
          "access"
        ],
        [
          "=",
          "$c.callee.subject.form",
          "instance"
        ],
        [
          "not",
          [
            "isSelf",
            "$c.callee.subject.subject"
          ]
        ],
        [
          "!=",
          [
            "get",
            [
              "consumer",
              "$c"
            ],
            "use"
          ],
          "discarded"
        ],
        [
          "not",
          [
            "namedForwarder",
            "$c"
          ]
        ],
        [
          "not",
          [
            "ownState",
            "$c"
          ]
        ],
        [
          "not",
          [
            "heldLibraryClient",
            "$c"
          ]
        ]
      ]
    },
    "chainRoot": {
      "args": [
        "c"
      ],
      "expr": [
        "get",
        [
          "first",
          [
            "receiverChain",
            "$c"
          ]
        ],
        "node"
      ]
    },
    "namedForwarder": {
      "args": [
        "c"
      ],
      "expr": [
        "some",
        [
          "list",
          [
            "enclosing",
            "$c",
            "function-like"
          ]
        ],
        "f",
        [
          "and",
          [
            "exists",
            "$f.name"
          ],
          [
            "or",
            [
              "=",
              "$f.body",
              "$c"
            ],
            [
              "=",
              "$f.body",
              "$c.parent"
            ],
            [
              "and",
              [
                "=",
                [
                  "count",
                  "$f.body.statements"
                ],
                1
              ],
              [
                "or",
                [
                  "=",
                  "$c.parent.kind",
                  "return"
                ],
                [
                  "=",
                  "$c.parent.parent.kind",
                  "return"
                ]
              ]
            ]
          ]
        ]
      ]
    },
    "ownState": {
      "args": [
        "c"
      ],
      "expr": [
        "proven",
        [
          "=",
          [
            "typeDeclaration",
            [
              "get",
              [
                "typeOf",
                [
                  "chainRoot",
                  "$c"
                ]
              ],
              "name"
            ]
          ],
          [
            "enclosing",
            "$c",
            "type"
          ]
        ]
      ]
    },
    "heldLibraryClient": {
      "args": [
        "c"
      ],
      "expr": [
        "and",
        [
          "proven",
          [
            "libraryMember",
            "$c"
          ]
        ],
        [
          "or",
          [
            "isSelf",
            [
              "chainRoot",
              "$c"
            ]
          ],
          [
            "proven",
            [
              "not",
              [
                "handedIn",
                "$c"
              ]
            ]
          ]
        ]
      ]
    },
    "rootType": {
      "args": [
        "c"
      ],
      "expr": [
        "case",
        [
          "proven",
          [
            "exists",
            [
              "get",
              [
                "typeOf",
                "$c.callee.subject.subject"
              ],
              "name"
            ]
          ]
        ],
        {
          "true": [
            "get",
            [
              "typeOf",
              "$c.callee.subject.subject"
            ],
            "name"
          ]
        },
        ""
      ]
    },
    "handedIn": {
      "args": [
        "c"
      ],
      "expr": [
        "some",
        [
          "list",
          [
            "enclosing",
            "$c",
            "function-like"
          ]
        ],
        "f",
        [
          "and",
          [
            "!=",
            [
              "get",
              "$f.effective",
              "visibility"
            ],
            "private"
          ],
          [
            "some",
            "$f.parameters",
            "p",
            [
              "sameSymbol",
              [
                "chainRoot",
                "$c"
              ],
              "$p"
            ]
          ]
        ]
      ]
    },
    "libraryMember": {
      "args": [
        "c"
      ],
      "expr": [
        "some",
        [
          "receiverChain",
          "$c"
        ],
        "l",
        [
          "and",
          [
            "=",
            [
              "get",
              "$l",
              "node"
            ],
            "$c.callee.subject"
          ],
          [
            "nonempty",
            [
              "get",
              "$l",
              "owner"
            ]
          ],
          [
            "not",
            [
              "exists",
              [
                "typeDeclaration",
                [
                  "get",
                  "$l",
                  "owner"
                ]
              ]
            ]
          ]
        ]
      ]
    }
  },
  "find": {
    "from": "call",
    "as": "c",
    "pipeline": [
      {
        "where": [
          "and",
          [
            "not",
            "$c.file.test"
          ],
          [
            "reachesThrough",
            "$c"
          ]
        ]
      },
      {
        "project": {
          "anchor": "$c",
          "key": [
            "list",
            "$c.file.fromProject",
            [
              "fingerprint",
              "$c.callee.subject",
              "exact"
            ],
            [
              "rootType",
              "$c"
            ]
          ]
        }
      },
      {
        "groupBy": "$key"
      },
      {
        "having": [
          ">=",
          [
            "count",
            "$rows"
          ],
          2
        ]
      },
      {
        "expand": "$rows"
      },
      {
        "emit": "$row.anchor",
        "group": "$key"
      }
    ]
  }
}
