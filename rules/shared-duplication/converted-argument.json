{
  "$schema": "commandments:generic-rule/v2",
  "engine": [
    "csharp",
    "go",
    "php",
    "python",
    "typescript"
  ],
  "sin": {
    "name": "converted-argument",
    "aliases": [
      "python-converted-argument",
      "csharp-converted-argument",
      "ConvertedArgumentDetector",
      "ConvertedArgument"
    ],
    "skill": "shared/duplication",
    "description": "Most callers convert a value the same way for one parameter",
    "rule": "Accept the value the callers already have and let the callee own the conversion.",
    "suggestion": "Take the original typed value and convert it where it is used.",
    "reporting": {
      "crossFile": true
    }
  },
  "definitions": {
    "conversion": {
      "args": [
        "v"
      ],
      "expr": [
        "and",
        [
          "in",
          "$v.kind",
          "call",
          "cast",
          "construction"
        ],
        [
          "or",
          [
            "scalar",
            "$v.resolved"
          ],
          [
            "or",
            [
              "=",
              "$v.kind",
              "construction"
            ],
            [
              "and",
              [
                "=",
                "$v.kind",
                "call"
              ],
              [
                "=",
                "$v.callee.form",
                "static"
              ]
            ]
          ]
        ],
        [
          "exists",
          [
            "source",
            "$v"
          ]
        ],
        [
          "not",
          [
            "in",
            [
              "tree.kindOf",
              [
                "source",
                "$v"
              ]
            ],
            "literal",
            "collection"
          ]
        ],
        [
          "not",
          [
            "proven",
            [
              "and",
              [
                "=",
                [
                  "tree.kindOf",
                  [
                    "source",
                    "$v"
                  ]
                ],
                "construction"
              ],
              [
                "=",
                [
                  "count",
                  [
                    "get",
                    [
                      "source",
                      "$v"
                    ],
                    "arguments"
                  ]
                ],
                0
              ]
            ]
          ]
        ],
        [
          "not",
          [
            "proven",
            [
              "and",
              [
                "=",
                "$v.callee.kind",
                "access"
              ],
              [
                "!=",
                "$v.callee.form",
                "static"
              ],
              [
                "or",
                [
                  "exists",
                  [
                    "typeDeclaration",
                    "$v.target.type"
                  ]
                ],
                [
                  "=",
                  [
                    "count",
                    "$v.arguments"
                  ],
                  0
                ]
              ]
            ]
          ]
        ]
      ]
    },
    "scalar": {
      "args": [
        "t"
      ],
      "expr": [
        "in",
        [
          "typeCategory",
          "$t"
        ],
        "text",
        "integer",
        "float",
        "boolean",
        "bytes"
      ]
    },
    "resolvedOf": {
      "args": [
        "x"
      ],
      "expr": "$x.resolved"
    },
    "sameConversion": {
      "args": [
        "a",
        "b"
      ],
      "expr": [
        "and",
        [
          "conversion",
          "$a"
        ],
        [
          "=",
          [
            "conversionKey",
            "$a"
          ],
          [
            "conversionKey",
            "$b"
          ]
        ]
      ]
    },
    "source": {
      "args": [
        "v"
      ],
      "expr": [
        "case",
        "$v.kind",
        {
          "call": [
            "callSource",
            "$v"
          ],
          "construction": [
            "callSource",
            "$v"
          ],
          "cast": "$v.operand"
        },
        null
      ]
    },
    "conversionKey": {
      "args": [
        "v"
      ],
      "expr": [
