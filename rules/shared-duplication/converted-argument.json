  "find": {
    "from": "argument",
    "as": "g",
    "pipeline": [
      {
        "where": [
          "and",
          [
            "not",
            "$g.file.test"
          ],
          [
            "in",
            "$g.parent.kind",
            "call",
            "construction"
          ],
          [
            "conversion",
            "$g.value"
          ]
        ]
      },
      {
        "project": {
          "anchor": "$g.parent",
          "declared": [
            "declarationOf",
            "$g.parent"
          ],
          "at": [
            "position",
            "$g"
          ],
          "value": "$g.value"
        }
      },
      {
        "where": [
          "and",
          [
            "exists",
            "$declared"
          ],
          [
            "exists",
            "$at"
          ],
          [
            "not",
            [
              "some",
              "$declared.parameters",
              "p",
              [
                "proven",
                [
                  "decodes",
                  "$value",
                  "$p"
                ]
              ]
            ]
          ]
        ]
      },
      {
        "project": {
          "anchor": "$anchor",
          "declared": "$declared",
          "key": [
            "concat",
            "$declared.file.path",
            "@",
            [
              "text",
              "$declared.span.start"
            ],
            "#",
            [
              "text",
              "$at"
            ],
            "#",
            [
              "conversionKey",
              "$value"
            ]
          ]
        }
      },
      {
        "groupBy": "$key"
      },
      {
        "having": [
          "and",
          [
            ">=",
            [
              "count",
              [
                "filter",
                "$rows",
                "r",
                [
                  "=",
                  [
                    "get",
                    [
                      "get",
                      "$r",
                      "anchor"
                    ],
                    "kind"
                  ],
                  "call"
                ]
              ]
            ],
            2
          ],
          [
            ">=",
            [
              "multiply",
              [
                "count",
                [
                  "filter",
                  "$rows",
                  "r",
                  [
                    "=",
                    [
                      "get",
                      [
                        "get",
                        "$r",
                        "anchor"
                      ],
                      "kind"
                    ],
                    "call"
                  ]
                ]
              ],
              2
            ],
            [
              "count",
              [
                "tree.callsOf",
                [
                  "get",
