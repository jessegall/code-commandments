            [
              "!=",
              "$v.callee.form",
              "static"
            ]
          ],
          {
            "true": "$v.callee.subject"
          },
          null
        ]
      ]
    },
    "decodes": {
      "args": [
        "v",
        "p"
      ],
      "expr": [
        "some",
        [
          "flatten",
          [
            "list",
            [
              "list",
              "$p.declaredType"
            ],
            [
              "ownDescendants",
              "$p.declaredType"
            ]
          ]
        ],
        "t",
        [
          "and",
          [
            "=",
            "$t.kind",
            "type-expression"
