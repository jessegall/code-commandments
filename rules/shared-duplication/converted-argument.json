{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "csharp",
    "go",
    "php",
    "python",
    "typescript"
  ],
  "sin": {
    "name": "converted-argument",
    "aliases": [
      "python-converted-argument",
      "csharp-converted-argument",
      "ConvertedArgumentDetector",
      "ConvertedArgument"
    ],
    "skill": "shared/duplication",
    "description": "Most callers convert a value the same way for one parameter",
    "rule": "Accept the value the callers already have and let the callee own the conversion.",
    "suggestion": "Take the original typed value and convert it where it is used.",
    "reporting": {
      "crossFile": true
    }
  },
  "definitions": {
    "conversion": {
      "args": [
        "v"
      ],
      "expr": [
        "and",
        [
          "in",
          "$v.kind",
          "call",
          "cast",
          "construction"
        ],
        [
          "or",
          [
            "scalar",
            "$v.resolved"
          ],
          [
            "or",
            [
              "=",
              "$v.kind",
              "construction"
            ],
            [
              "and",
              [
                "=",
                "$v.kind",
                "call"
              ],
              [
                "=",
                "$v.callee.form",
                "static"
              ]
            ]
          ]
        ],
        [
          "exists",
          [
            "source",
            "$v"
          ]
        ],
        [
          "not",
          [
            "in",
            [
              "tree.kindOf",
              [
                "source",
                "$v"
              ]
            ],
            "literal",
            "collection"
          ]
        ],
        [
          "not",
          [
            "proven",
            [
              "and",
              [
                "=",
                "$v.callee.kind",
                "access"
              ],
              [
                "!=",
                "$v.callee.form",
                "static"
              ],
              [
                "or",
                [
                  "exists",
                  [
                    "typeDeclaration",
                    "$v.target.type"
                  ]
                ],
                [
                  "=",
                  [
                    "count",
                    "$v.arguments"
                  ],
                  0
                ]
              ]
            ]
          ]
        ]
      ]
    },
    "scalar": {
      "args": [
        "t"
      ],
      "expr": [
        "in",
        [
          "typeCategory",
          "$t"
        ],
        "text",
        "integer",
        "float",
        "boolean",
        "bytes"
      ]
    },
    "resolvedOf": {
      "args": [
        "x"
      ],
      "expr": "$x.resolved"
    },
    "sameConversion": {
      "args": [
        "a",
        "b"
      ],
      "expr": [
        "and",
        [
          "conversion",
          "$a"
        ],
        [
          "=",
          [
            "conversionKey",
            "$a"
          ],
          [
            "conversionKey",
            "$b"
          ]
        ]
      ]
    },
    "source": {
      "args": [
        "v"
      ],
      "expr": [
        "case",
        "$v.kind",
        {
          "call": [
            "callSource",
            "$v"
          ],
          "construction": [
            "callSource",
            "$v"
          ],
          "cast": "$v.operand"
        },
        null
      ]
    },
    "conversionKey": {
      "args": [
        "v"
      ],
      "expr": [
        "case",
        "$v.kind",
        {
          "call": "$v.target.symbol",
          "cast": [
            "concat",
            "cast:",
            "$v.resolved.text"
          ],
          "construction": "$v.target.symbol"
        },
        null
      ]
    },
    "callSource": {
      "args": [
        "v"
      ],
      "expr": [
        "case",
        [
          "=",
          [
            "count",
            "$v.arguments"
          ],
          1
        ],
        {
          "true": [
            "at",
            [
              "map",
              "$v.arguments",
              "g",
              "$g.value"
            ],
            0
          ]
        },
        [
          "case",
          [
            "and",
            [
              "=",
              [
                "count",
                "$v.arguments"
              ],
              0
            ],
            [
              "=",
              "$v.callee.form",
              "static"
            ]
          ],
          {
            "true": null
          },
          "$v.callee.subject"
        ]
      ]
    },
    "decodes": {
      "args": [
        "v",
        "p"
      ],
      "expr": [
        "some",
        [
          "flatten",
          [
            "list",
            [
              "list",
              "$p.declaredType"
            ],
            [
              "ownDescendants",
              "$p.declaredType"
            ]
          ]
        ],
        "t",
        [
          "and",
          [
            "=",
            "$t.kind",
            "type-expression"
          ],
          [
            "or",
            [
              "and",
              [
                "exists",
                [
                  "typeDeclaration",
                  "$t.refers"
                ]
              ],
              [
                "or",
                [
                  "=",
                  [
                    "typeDeclaration",
                    "$t.refers"
                  ],
                  [
                    "typeDeclaration",
                    "$v.resolved.name"
                  ]
                ],
                [
                  "=",
                  [
                    "typeDeclaration",
                    "$t.refers"
                  ],
                  [
                    "typeDeclaration",
                    "$v.target.type"
                  ]
                ]
              ]
            ],
            [
              "and",
              [
                "not",
                [
                  "scalar",
                  "$v.resolved"
                ]
              ],
              [
                "exists",
                "$v.resolved.name"
              ],
              [
                "=",
                "$t.resolved.name",
                "$v.resolved.name"
              ]
            ]
          ]
        ]
      ]
    }
  },
  "find": {
    "select": [
      "call",
      "construction"
    ],
    "as": "c",
    "where": [
      "not",
      "$c.file.test"
    ],
    "let": [
      [
        "declared",
        [
          "declarationOf",
          "$c"
        ]
      ],
      [
        "calls",
        [
          "tree.callsOf",
          "$declared"
        ]
      ]
    ],
    "having": [
      "some",
      "$c.arguments",
      "g",
      [
        "and",
        [
          "conversion",
          "$g.value"
        ],
        [
          "not",
          [
            "some",
            "$declared.parameters",
            "p",
            [
              "proven",
              [
                "decodes",
                "$g.value",
                "$p"
              ]
            ]
          ]
        ],
        [
          ">=",
          [
            "count",
            [
              "filter",
              "$calls",
              "o",
              [
                "sameConversion",
                [
                  "tree.valueAt",
                  "$o",
                  [
                    "position",
                    "$g"
                  ]
                ],
                "$g.value"
              ]
            ]
          ],
          2
        ],
        [
          ">=",
          [
            "multiply",
            [
              "count",
              [
                "filter",
                "$calls",
                "o",
                [
                  "sameConversion",
                  [
                    "tree.valueAt",
                    "$o",
                    [
                      "position",
                      "$g"
                    ]
                  ],
                  "$g.value"
                ]
              ]
            ],
            2
          ],
          [
            "count",
            "$calls"
          ]
        ]
      ]
    ],
    "emit": "$c"
  }
}
