            "$v"
          ],
          "cast": [
            "concat",
            "cast:",
            "$v.resolved.text",
            [
              "case",
              [
                "tree.kindOf",
                "$v.operand"
              ],
              {
                "binary": [
                  "concat",
                  "|",
                  [
                    "fingerprint",
                    "$v.operand",
                    "exact"
                  ]
                ]
              },
              ""
            ]
          ],
          "construction": [
            "symbolOrCallee",
            "$v"
          ]
        },
        null
      ]
    },
    "callSource": {
      "args": [
        "v"
      ],
      "expr": [
        "case",
        [
          "=",
          [
