{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "csharp",
    "go",
    "php",
    "python",
    "typescript"
  ],
  "sin": {
    "name": "unnamed-vocabulary-literal",
    "aliases": [
      "python-unnamed-vocabulary-literal",
      "csharp-unnamed-vocabulary-literal",
      "UnnamedVocabularyLiteralDetector",
      "UnnamedVocabularyLiteral"
    ],
    "skill": "shared/duplication",
    "description": "A string literal fills a parameter that already has a named constant for that value",
    "rule": "Use the vocabulary the parameter already has.",
    "suggestion": "Replace the string with the named constant that carries the same value.",
    "reporting": {
      "crossFile": true
    }
  },
  "definitions": {
    "constantWord": {
      "args": [
        "v"
      ],
      "expr": [
        "wordOf",
        [
          "declarationOf",
          "$v"
        ]
      ]
    },
    "wordOf": {
      "args": [
        "d"
      ],
      "expr": [
        "case",
        [
          "exists",
          [
            "enclosing",
            "$d",
            "function"
          ]
        ],
        {
          "true": null
        },
        [
          "case",
          "$d.kind",
          {
            "binding": [
              "case",
              "$d.parent.kind",
              {
                "declarator": [
                  "writtenLiteral",
                  "$d.parent.initializer"
                ],
                "assignment": [
                  "writtenLiteral",
                  [
                    "at",
                    "$d.parent.values",
                    0
                  ]
                ]
              },
              null
            ],
            "declarator": [
              "writtenLiteral",
              "$d.initializer"
            ],
            "enum-case": [
              "writtenLiteral",
              "$d.value"
            ]
          },
          null
        ]
      ]
    },
    "writtenLiteral": {
      "args": [
        "x"
      ],
      "expr": [
        "case",
        "$x.kind",
        {
          "literal": "$x.value"
        },
        null
      ]
    },
    "memberWord": {
      "args": [
        "m"
      ],
      "expr": [
        "case",
        "$m.kind",
        {
          "enum-case": [
            "writtenLiteral",
            "$m.value"
          ],
          "constant": [
            "writtenLiteral",
            [
              "at",
              [
                "map",
                "$m.declarators",
                "d",
                "$d.initializer"
              ],
              0
            ]
          ],
          "field": [
            "writtenLiteral",
            [
              "at",
              [
                "map",
                "$m.declarators",
                "d",
                "$d.initializer"
              ],
              0
            ]
          ]
        },
        null
      ]
    },
    "typeWords": {
      "args": [
        "t"
      ],
      "expr": [
        "map",
        [
          "filter",
          "$t.writtenMembers",
          "m",
          [
            "in",
            "$m.kind",
            "enum-case",
            "constant",
            "field"
          ]
        ],
        "m",
        [
          "memberWord",
          "$m"
        ]
      ]
    },
    "ownVocabulary": {
      "args": [
        "d",
        "c",
        "a"
      ],
      "expr": [
        "and",
        [
          "=",
          [
            "enclosing",
            "$d",
            "type"
          ],
          [
            "enclosing",
            "$c",
            "type"
          ]
        ],
        [
          "!=",
          [
            "enclosing",
            "$c",
            "type"
          ],
          [
            "enclosing",
            "$a",
            "type"
          ]
        ]
      ]
    }
  },
  "find": {
    "select": "argument",
    "as": "a",
    "where": [
      "and",
      [
        "not",
        "$a.file.test"
      ],
      [
        "=",
        "$a.value.kind",
        "literal"
      ],
      [
        "=",
        "$a.value.literalKind",
        "string"
      ],
      [
        "in",
        "$a.parent.kind",
        "call",
        "construction"
      ]
    ],
    "let": [
      [
        "at",
        [
          "position",
          "$a"
        ]
      ],
      [
        "siblings",
        [
          "filter",
          [
            "referrers",
            [
              "declarationOf",
              "$a.parent"
            ]
          ],
          "c",
          [
            "not",
            "$c.file.test"
          ]
        ]
      ]
    ],
    "having": [
      "or",
      [
        "some",
        "$siblings",
        "c",
        [
          "some",
          "$c.arguments",
          "g",
          [
            "and",
            [
              "=",
              [
                "position",
                "$g"
              ],
              "$at"
            ],
            [
              "in",
              "$g.value.kind",
              "reference",
              "access"
            ],
            [
              "=",
              [
                "constantWord",
                "$g.value"
              ],
              "$a.value.value"
            ],
            [
              "not",
              [
                "proven",
                [
                  "ownVocabulary",
                  [
                    "declarationOf",
                    "$g.value"
                  ],
                  "$c",
                  "$a"
                ]
              ]
            ]
          ]
        ]
      ],
      [
        "some",
        "$siblings",
        "c",
        [
          "some",
          "$c.arguments",
          "g",
          [
            "and",
            [
              "=",
              [
                "position",
                "$g"
              ],
              "$at"
            ],
            [
              "in",
              "$g.value.kind",
              "reference",
              "access"
            ],
            [
              "some",
              [
                "typeWords",
                [
                  "enclosing",
                  [
                    "declarationOf",
                    "$g.value"
                  ],
                  "type"
                ]
              ],
              "w",
              [
                "=",
                "$w",
                "$a.value.value"
              ]
            ],
            [
              "not",
              [
                "proven",
                [
                  "ownVocabulary",
                  [
                    "declarationOf",
                    "$g.value"
                  ],
                  "$c",
                  "$a"
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    "emit": "$a"
  }
}
