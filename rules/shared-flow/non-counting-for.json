{
  "$schema": "commandments:generic-rule/v2",
  "engine": [
    "csharp",
    "go",
    "php",
    "typescript"
  ],
  "sin": {
    "name": "non-counting-for",
    "aliases": [
      "csharp-non-counting-for",
      "NonCountingForDetector",
      "NonCountingFor"
    ],
    "skill": "shared/flow",
    "description": "A `for` loop whose step assigns the next item instead of moving a counter: a walk written as a count",
    "rule": "Keep `for` for a counted loop, whose step advances a counter; walk with a `while`, or let the type hand out its own sequence.",
    "suggestion": "A `while` over an explicit cursor, or better, an iterator on the type being walked, so the caller never holds the cursor at all."
  },
  "definitions": {
    "advances": {
      "args": [
        "s"
      ],
      "expr": [
        "case",
        "$s.kind",
        {
          "assignment": [
            "assignmentAdvances",
            "$s"
          ],
          "expression-statement": [
            "assignmentAdvances",
            "$s.expression"
          ]
        },
        false
      ]
    },
    "steps": {
      "args": [
        "target",
        "value"
      ],
      "expr": [
        "case",
        "$value.kind",
        {
          "binary": [
            "and",
            [
              "in",
              "$value.operator",
              "add",
              "subtract"
            ],
            [
              "or",
              [
                "=",
                [
                  "fingerprint",
                  "$value.left",
                  "exact"
                ],
                [
                  "fingerprint",
                  "$target",
                  "exact"
                ]
              ],
              [
                "=",
                [
                  "fingerprint",
                  "$value.right",
                  "exact"
                ],
                [
                  "fingerprint",
                  "$target",
                  "exact"
                ]
              ]
            ]
          ],
          "call": [
            "and",
            [
              "=",
              [
                "fingerprint",
                "$value.callee.subject",
                "exact"
              ],
              [
                "fingerprint",
                "$target",
                "exact"
              ]
            ],
            [
              ">",
              [
                "count",
                "$value.arguments"
              ],
              0
            ],
            [
              "every",
              "$value.arguments",
              "g",
              [
                "=",
                "$g.value.kind",
                "literal"
              ]
            ]
          ]
        },
        false
      ]
    },
    "assignmentAdvances": {
      "args": [
        "s"
      ],
      "expr": [
        "or",
        [
          "in",
          "$s.mode",
          "increment",
          "decrement"
        ],
        [
          "and",
          [
            "=",
            "$s.mode",
            "compound"
          ],
          [
            "in",
            "$s.operator",
            "add",
            "subtract",
            "multiply",
            "divide",
            "shift-left",
            "shift-right"
          ]
        ],
        [
          "steps",
          [
            "at",
            "$s.targets",
            0
          ],
          [
            "at",
            "$s.values",
            0
          ]
        ]
      ]
    }
  },
  "find": {
    "select": "loop",
    "as": "l",
    "where": [
      "and",
      [
        ">",
        [
          "count",
          "$l.steps"
        ],
        0
      ],
      [
        "none",
        "$l.steps",
        "s",
        [
          "advances",
          "$s"
        ]
      ]
    ],
    "emit": "$l"
  }
}
