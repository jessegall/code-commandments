{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "csharp",
    "go",
    "php",
    "python",
    "typescript"
  ],
  "sin": {
    "name": "deep-nesting",
    "aliases": [
      "deep-python-nesting",
      "deep-csharp-nesting",
      "deep-go-nesting",
      "DeepNestingDetector",
      "DeepNesting"
    ],
    "skill": "shared/flow",
    "description": "A decision sits deep inside other decisions in one function",
    "rule": "Flatten with guards that leave early, or extract the inner decision into a function of its own.",
    "suggestion": "Turn the outer conditions into guards that return or `continue`, or move the innermost block into a well-named function."
  },
  "parameters": {
    "limit": {
      "type": "number",
      "default": 3,
      "description": "How many choices above a choice make it too deep; PHP's fixtures prove two ifs."
    }
  },
  "definitions": {
    "choice": {
      "args": [
        "n"
      ],
      "expr": [
        "case",
        "$n.kind",
        {
          "if": [
            "not",
            [
              "tree.continuation",
              "$n"
            ]
          ],
          "loop": true,
          "dispatch": true,
          "select": true
        },
        false
      ]
    },
    "onlyLeaves": {
      "args": [
        "n"
      ],
      "expr": [
        "some",
        [
          "case",
          "$n.kind",
          {
            "if": [
              "list",
              "$n.then",
              "$n.else"
            ],
            "loop": [
              "list",
              "$n.body"
            ]
          },
          [
            "list"
          ]
        ],
        "c",
        [
          "or",
          [
            "is",
            "$c",
            "exit"
          ],
          [
            "and",
            [
              "=",
              "$c.kind",
              "block"
            ],
            [
              "=",
              [
                "count",
                "$c.statements"
              ],
              1
            ],
            [
              "is",
              [
                "at",
                "$c.statements",
                0
              ],
              "exit"
            ]
          ]
        ]
      ]
    },
    "counted": {
      "args": [
        "s",
        "a"
      ],
      "expr": [
        "case",
        "$s.file.language",
        {
          "php": [
            "=",
            "$a.kind",
            "if"
          ]
        },
        [
          "choice",
          "$a"
        ]
      ]
    }
  },
  "find": {
    "select": [
      "if",
      "loop",
      "dispatch",
      "select"
    ],
    "as": "s",
    "where": [
      "choice",
      "$s"
    ],
    "let": [
      [
        "limit",
        [
          "case",
          "$s.file.language",
          {
            "php": 2
          },
          "$param.limit"
        ]
      ],
      [
        "depth",
        [
          "count",
          [
            "filter",
            [
              "ownAncestors",
              "$s"
            ],
            "a",
            [
              "counted",
              "$s",
              "$a"
            ]
          ]
        ]
      ]
    ],
    "having": [
      "and",
      [
        "=",
        "$depth",
        "$limit"
      ],
      [
        "or",
        [
          "not",
          [
            "onlyLeaves",
            "$s"
          ]
        ],
        [
          "none",
          [
            "ownAncestors",
            "$s"
          ],
          "a",
          [
            "and",
            [
              "=",
              "$a.kind",
              "loop"
            ],
            [
              "counted",
              "$s",
              "$a"
            ]
          ]
        ]
      ]
    ],
    "emit": "$s"
  }
}
