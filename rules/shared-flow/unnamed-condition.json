                "$l.parent.then.statements"
              ],
              "exit"
            ]
          ]
        ]
      ]
    ],
    "let": [
      [
        "parts",
        [
          "leaves",
          "$l",
          "logical"
        ]
      ],
      [
        "roots",
        [
          "flatten",
          [
            "map",
            "$parts",
            "p",
            [
              "map",
              [
                "filter",
                [
                  "flatten",
                  [
                    "list",
                    [
                      "list",
                      "$p"
                    ],
                    [
                      "ownDescendants",
                      "$p"
