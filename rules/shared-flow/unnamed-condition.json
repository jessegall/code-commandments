    "having": [
      "and",
      [
        ">=",
        [
          "count",
          "$parts"
        ],
        "$param.parts"
      ],
      [
        "none",
        "$parts",
        "p",
        [
          "declares",
          "$p"
        ]
      ],
      [
        ">=",
        [
          "distinctCount",
          "$subjects"
        ],
        "$param.subjects"
      ]
    ],
    "emit": "$l"
  }
}
