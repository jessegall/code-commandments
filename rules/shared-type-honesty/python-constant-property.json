{
  "$schema": "commandments:generic-rule/v2",
  "engine": [
    "python"
  ],
  "sin": {
    "name": "python-constant-property",
    "aliases": [
      "ConstantPropertyDetector",
      "ConstantProperty"
    ],
    "skill": "shared/type-honesty",
    "description": "an `@property` whose body never reads `self` \u2014 `return \"box\"` \u2014 a stored value made to look like a computed one.",
    "rule": "A `@property` must derive from the object; a value it never reads `self` for is a class attribute.",
    "suggestion": "`kind = \"box\"` on the class \u2014 or a `ClassVar` \u2014 and the property goes."
  },
  "find": {
    "select": "function",
    "as": "f",
    "where": [
      "and",
      [
        "=",
        "$f.form",
        "method"
      ],
      [
        "some",
        "$f.attributes",
        "a",
        [
          "=",
          "$a.refers",
          "builtins.property"
        ]
      ],
      [
        "=",
        [
          "count",
          "$f.parameters"
        ],
        0
      ],
      [
        "=",
        [
          "count",
          [
            "statementsOf",
            "$f"
          ]
        ],
        1
      ],
      [
        "=",
        [
          "tree.kindOf",
          [
            "at",
            [
              "statementsOf",
              "$f"
            ],
            0
          ]
        ],
        "return"
      ],
      [
        "=",
        [
          "count",
          "$f.obligations"
        ],
        0
      ]
    ],
    "let": [
      [
        "first",
        [
          "at",
          [
            "statementsOf",
            "$f"
          ],
          0
        ]
      ],
      [
        "value",
        [
          "at",
          "$first.values",
          0
        ]
      ]
    ],
    "having": [
      "and",
      [
        "exists",
        "$value"
      ],
      [
        "none",
        [
          "flatten",
          [
            "list",
            [
              "list",
              "$value"
            ],
            [
              "ownDescendants",
              "$value"
            ]
          ]
        ],
        "x",
        [
          "or",
          [
            "in",
            "$x.kind",
            "call",
            "access",
            "index"
          ],
          [
            "and",
            [
              "=",
              "$x.kind",
              "reference"
            ],
            [
              "!=",
              "$x.role",
              "callee"
            ]
          ]
        ]
      ],
      [
        "none",
        [
          "siblings",
          "$f"
        ],
        "m",
        [
          "some",
          "$m.attributes",
          "a",
          [
            "and",
            [
              "=",
              "$a.subject.kind",
              "reference"
            ],
            [
              "=",
              "$a.subject.name",
              "$f.name"
            ]
          ]
        ]
      ],
      [
        "=",
        [
          "count",
          [
            "overriders",
            "$f"
          ]
        ],
        0
      ]
    ],
    "emit": "$f"
  },
  "definitions": {
    "statementsOf": {
      "args": [
        "f"
      ],
      "expr": [
        "filter",
        "$f.body.statements",
        "s",
        [
          "not",
          [
            "and",
            [
              "=",
              "$s.kind",
              "expression-statement"
            ],
            [
              "=",
              "$s.expression.kind",
              "literal"
            ],
            [
              "=",
              "$s.expression.literalKind",
              "string"
            ]
          ]
        ]
      ]
    }
  }
}
