        [
          "extractable",
          "$c"
        ],
        [
          "some",
          [
            "ownDescendants",
            "$c"
          ],
          "x",
          [
            "extractable",
            "$x"
          ]
        ]
      ]
    },
    "branches": {
      "args": [
        "e"
      ],
      "expr": [
