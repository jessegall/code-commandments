  "definitions": {
    "tall": {
      "args": [
        "e"
      ],
      "expr": [
        "some",
        [
          "ownDescendants",
          "$e"
        ],
        "g",
        [
          "and",
          [
            "=",
            "$g.kind",
            "element"
          ],
          [
            "=",
            "$g.parent.kind",
            "element"
          ],
          [
            "!=",
            "$g.parent",
            "$e"
          ]
        ]
      ]
    },
    "extractable": {
      "args": [
        "x"
      ],
      "expr": [
        "and",
        [
          "=",
          "$x.kind",
