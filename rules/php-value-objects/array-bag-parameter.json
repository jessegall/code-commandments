{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "go",
    "php",
    "typescript"
  ],
  "sin": {
    "name": "array-bag-parameter",
    "aliases": [
      "ArrayBagParameterDetector",
      "ArrayBagParameter"
    ],
    "skill": "php/value-objects",
    "description": "A parameter declared `array` that callers fill with string-keyed records (`['mode' => \u2026, 'plan' => \u2026]`): the method never defined the type its fields belong to.",
    "rule": "A method of your own takes values and objects, never an `array` of named fields \u2014 the definition is at fault, not the caller filling it.",
    "suggestion": "Type the parameter as a Spatie `Data` object or a final readonly value object, and have callers construct it.",
    "reporting": {
      "crossFile": true
    }
  },
  "definitions": {
    "stringKeys": {
      "args": [
        "c"
      ],
      "expr": [
        "map",
        [
          "filter",
          "$c.entries",
          "e",
          [
            "or",
            [
              "and",
              [
                "=",
                "$e.key.kind",
                "literal"
              ],
              [
                "=",
                "$e.key.literalKind",
                "string"
              ]
            ],
            [
              "and",
              [
                "=",
                "$c.form",
                "object"
              ],
              [
                "=",
                "$e.key.kind",
                "reference"
              ],
              [
                "=",
                "$e.key.form",
                "name"
              ]
            ]
          ]
        ],
        "e",
        [
          "case",
          "$e.key.kind",
          {
            "literal": "$e.key.value",
            "reference": "$e.key.name"
          },
          ""
        ]
      ]
    },
    "fieldNamed": {
      "args": [
        "c"
      ],
      "expr": [
        "every",
        [
          "stringKeys",
          "$c"
        ],
        "k",
        [
          "matchesText",
          "$k",
          "^[A-Za-z_][A-Za-z0-9_]*$"
        ]
      ]
    },
    "standing": {
      "args": [
        "h"
      ],
      "expr": [
        "case",
        [
          "exists",
          [
            "assignedOnce",
            "$h"
          ]
        ],
        {
          "true": [
            "assignedOnce",
            "$h"
          ]
        },
        "$h"
      ]
    }
  },
  "find": {
    "select": "parameter",
    "as": "p",
    "where": [
      "and",
      [
        "=",
        "$p.parent.kind",
        "function"
      ],
      [
        "tree.looseRecord",
        [
          "typeOf",
          "$p"
        ]
      ]
    ],
    "let": [
      [
        "at",
        [
          "position",
          "$p"
        ]
      ],
      [
        "calls",
        [
          "filter",
          [
            "referrers",
            "$p.parent"
          ],
          "c",
          [
            "and",
            [
              "=",
              "$c.kind",
              "call"
            ],
            [
              "not",
              "$c.file.test"
            ]
          ]
        ]
      ],
      [
        "handed",
        [
          "map",
          [
            "map",
            "$calls",
            "c",
            [
              "tree.valueAt",
              "$c",
              "$at"
            ]
          ],
          "h",
          [
            "standing",
            "$h"
          ]
        ]
      ]
    ],
    "having": [
      "and",
      [
        ">=",
        [
          "count",
          "$calls"
        ],
        1
      ],
      [
        "every",
        "$handed",
        "h",
        [
          "and",
          [
            "=",
            "$h.kind",
            "collection"
          ],
          [
            ">=",
            [
              "distinctCount",
              [
                "stringKeys",
                "$h"
              ]
            ],
            2
          ],
          [
            "fieldNamed",
            "$h"
          ],
          [
            "=",
            [
              "sort",
              [
                "stringKeys",
                "$h"
              ]
            ],
            [
              "sort",
              [
                "stringKeys",
                [
                  "at",
                  "$handed",
                  0
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    "emit": "$p"
  }
}
