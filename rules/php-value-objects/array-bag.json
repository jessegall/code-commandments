{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "csharp",
    "go",
    "php",
    "python",
    "typescript"
  ],
  "sin": {
    "name": "array-bag",
    "aliases": [
      "ArrayBagDetector",
      "ArrayBag",
      "csharp-dictionary-bag",
      "DictionaryBagDetector",
      "DictionaryBag",
      "python-dict-bag",
      "DictBagDetector",
      "DictBag"
    ],
    "skill": "php/value-objects",
    "description": "String-indexing (`$arr['key']`) a structured array param instead of giving it a name \u2014 the type was never defined.",
    "rule": "Give a structured array a typed value object \u2014 never read a named field by string key off an `array` param.",
    "suggestion": "A Spatie `Data` object built via `::from($array)`.",
    "reporting": {
      "crossFile": true
    }
  },
  "find": {
    "select": "parameter",
    "as": "p",
    "where": [
      "and",
      [
        "=",
        "$p.parent.kind",
        "function"
      ],
      [
        "not",
        "$p.file.test"
      ],
      [
        "not",
        [
          "in",
          "$p.parent.form",
          "closure",
          "arrow",
          "lambda"
        ]
      ],
      [
        "tree.notOverriding",
        "$p.parent"
      ],
      [
        "not",
        [
          "has",
          [
            "functionRole",
            "$p.parent"
          ],
          "named-constructor"
        ]
      ],
      [
        "not",
        [
          "has",
          [
            "functionRole",
            "$p.parent"
          ],
          "serialization-hook"
        ]
      ],
      [
        "not",
        [
          "and",
          [
            ">",
            [
              "count",
              [
                "tree.callsOf",
                "$p.parent"
              ]
            ],
            0
          ],
          [
            "every",
            [
              "tree.callsOf",
              "$p.parent"
            ],
            "c",
            [
              "has",
              [
                "functionRole",
                [
                  "enclosing",
                  "$c",
                  "function"
                ]
              ],
              "serialization-hook"
            ]
          ]
        ]
      ],
      [
        "tree.looseRecord",
        [
          "typeOf",
          "$p"
        ]
      ]
    ],
    "let": [
      [
        "keys",
        [
          "map",
          [
            "filter",
            [
              "ownDescendants",
              "$p.parent.body"
            ],
            "i",
            [
              "or",
              [
                "and",
                [
                  "=",
                  "$i.kind",
                  "index"
                ],
                [
                  "=",
                  "$i.subject.kind",
                  "reference"
                ],
                [
                  "=",
                  "$i.subject.name",
                  "$p.binding.name"
                ],
                [
                  "=",
                  "$i.key.kind",
                  "literal"
                ],
                [
                  "=",
                  "$i.key.literalKind",
                  "string"
                ]
              ],
              [
                "and",
                [
                  "=",
                  "$i.kind",
                  "call"
                ],
                [
                  "=",
                  "$i.callee.kind",
                  "access"
                ],
                [
                  "=",
                  "$i.callee.subject.kind",
                  "reference"
                ],
                [
                  "=",
                  "$i.callee.subject.name",
                  "$p.binding.name"
                ],
                [
                  "=",
                  [
                    "at",
                    [
                      "map",
                      "$i.arguments",
                      "g",
                      "$g.value.literalKind"
                    ],
                    0
                  ],
                  "string"
                ]
              ]
            ]
          ],
          "i",
          [
            "case",
            "$i.kind",
            {
              "index": "$i.key.value",
              "call": [
                "at",
                [
                  "map",
                  "$i.arguments",
                  "g",
                  "$g.value.value"
                ],
                0
              ]
            },
            null
          ]
        ]
      ]
    ],
    "having": [
      ">=",
      [
        "distinctCount",
        "$keys"
      ],
      2
    ],
    "emit": "$p"
  }
}
