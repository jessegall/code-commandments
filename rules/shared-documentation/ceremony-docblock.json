{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "csharp",
    "php",
    "python",
    "typescript"
  ],
  "sin": {
    "name": "ceremony-docblock",
    "aliases": [
      "python-ceremony-docblock",
      "csharp-ceremony-docblock",
      "CeremonyDocblockDetector",
      "CeremonyDocblock"
    ],
    "skill": "shared/documentation",
    "description": "A doc comment repeats the function signature",
    "rule": "Keep documentation for information the signature does not already say.",
    "suggestion": "Remove the redundant tags and leave any useful explanation."
  },
  "find": {
    "select": "comment",
    "as": "c",
    "where": [
      "and",
      [
        "=",
        "$c.form",
        "doc"
      ],
      [
        "=",
        "$c.documents.kind",
        "function"
      ],
      [
        "=",
        "$c.description",
        ""
      ],
      [
        ">",
        [
          "count",
          "$c.tags"
        ],
        0
      ],
      [
        "none",
        "$c.tags",
        "t",
        [
          "not",
          [
            "restates",
            "$t",
            "$c.documents"
          ]
        ]
      ]
    ],
    "emit": "$c.location"
  },
  "definitions": {
    "declaredText": {
      "args": [
        "x"
      ],
      "expr": [
        "case",
        [
          "nonempty",
          "$x.members"
        ],
        {
          "true": [
            "join",
            [
              "map",
              "$x.members",
              "m",
              [
                "coalesce",
                "$m.name",
                "$m.resolved.text"
              ]
            ],
            "|"
          ]
        },
        [
          "coalesce",
          "$x.name",
          "$x.resolved.text"
        ]
      ]
    },
    "restates": {
      "args": [
        "t",
        "f"
      ],
      "expr": [
        "and",
        [
          "in",
          "$t.name",
          "param",
          "arg",
          "argument",
          "return",
          "returns"
        ],
        [
          "=",
          "$t.text",
          ""
        ],
        [
          "or",
          [
            "=",
            "$t.type",
            ""
          ],
          [
            "case",
            "$t.name",
            {
              "return": [
                "same",
                [
                  "declaredText",
                  "$f.returnType"
                ],
                "$t.type"
              ],
              "returns": [
                "same",
                [
                  "declaredText",
                  "$f.returnType"
                ],
                "$t.type"
              ]
            },
            [
              "some",
              "$f.parameters",
              "p",
              [
                "and",
                [
                  "=",
                  "$p.binding.name",
                  "$t.subject"
                ],
                [
                  "same",
                  [
                    "declaredText",
                    "$p.declaredType"
                  ],
                  "$t.type"
                ]
              ]
            ]
          ]
        ]
      ]
    },
    "squash": {
      "args": [
        "x"
      ],
      "expr": [
        "replace",
        "$x",
        " ",
        ""
      ]
    },
    "same": {
      "args": [
        "a",
        "b"
      ],
      "expr": [
        "or",
        [
          "=",
          [
            "squash",
            "$a"
          ],
          [
            "squash",
            "$b"
          ]
        ],
        [
          "contains",
          [
            "squash",
            "$a"
          ],
          [
            "concat",
            "\\",
            [
              "squash",
              "$b"
            ]
          ]
        ]
      ]
    }
  }
}
