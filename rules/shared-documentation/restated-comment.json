{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "csharp",
    "go",
    "python",
    "typescript"
  ],
  "sin": {
    "name": "restated-comment",
    "aliases": [
      "python-restated-comment",
      "csharp-restated-comment",
      "RestatedCommentDetector",
      "RestatedComment"
    ],
    "skill": "shared/documentation",
    "description": "A comment repeats the words of the statement it documents",
    "rule": "Give the statement clear names and let it speak for itself.",
    "suggestion": "Delete the comment or explain the reason for the statement."
  },
  "find": {
    "select": "comment",
    "as": "c",
    "where": [
      "and",
      [
        "!=",
        "$c.form",
        "doc"
      ],
      [
        "not",
        "$c.code"
      ],
      [
        "exists",
        "$c.documents"
      ],
      [
        "!=",
        "$c.documents.kind",
        "entry"
      ],
      [
        "!=",
        "$c.documents.parent.kind",
        "collection"
      ],
      [
        "not",
        [
          "in",
          "$c.documents.kind",
          "block",
          "function",
          "type"
        ]
      ],
      [
        "exists",
        [
          "enclosing",
          "$c.documents",
          "function"
        ]
      ],
      [
        ">=",
        [
          "count",
          "$c.words"
        ],
        2
      ],
      [
        ">",
        [
          "count",
          "$c.codeWords"
        ],
        0
      ],
      [
        "every",
        "$c.words",
        "w",
        [
          "some",
          "$c.codeWords",
          "s",
          [
            "=",
            "$s",
            "$w"
          ]
        ]
      ],
      [
        "not",
        [
          "proven",
          [
            "laravel.routed",
            "$c.documents.expression"
          ]
        ]
      ]
    ],
    "emit": "$c.location"
  }
}
