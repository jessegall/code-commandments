{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "csharp",
    "go",
    "php",
    "python",
    "typescript"
  ],
  "sin": {
    "name": "keyed-lookup-envy",
    "aliases": [
      "KeyedLookupEnvyDetector",
      "KeyedLookupEnvy",
      "python-keyed-lookup-envy"
    ],
    "skill": "php/tell-dont-ask",
    "description": "Indirect feature envy \u2014 a method that uses an owned object's IDENTITY as a key to look up a fact about it through a collaborator",
    "rule": "Ask the object directly; don't use its identity as a key to look its own fact up through a collaborator.",
    "suggestion": "Move the lookup onto the object that owns the identity.",
    "reporting": {
      "crossFile": true
    }
  },
  "definitions": {
    "builtBy": {
      "args": [
        "s"
      ],
      "expr": [
        "case",
        "$s.kind",
        {
          "return": [
            "at",
            "$s.values",
            0
          ]
        },
        null
      ]
    },
    "paramMember": {
      "args": [
        "k"
      ],
      "expr": [
        "and",
        [
          "=",
          "$k.kind",
          "access"
        ],
        [
          "=",
          "$k.subject.kind",
          "reference"
        ],
        [
          "ownParameter",
          "$k.subject"
        ],
        [
          "exists",
          [
            "declarationOf",
            "$k"
          ]
        ],
        [
          "not",
          [
            "isSelf",
            "$k.subject"
          ]
        ],
        [
          "not",
          [
            "proven",
            [
              "=",
              [
                "tree.formOf",
                [
                  "typeDeclaration",
                  "$k.resolved.name"
                ]
              ],
              "enum"
            ]
          ]
        ]
      ]
    },
    "keyedBy": {
      "args": [
        "x"
      ],
      "expr": [
        "case",
        "$x.kind",
        {
          "index": [
            "and",
            [
              "paramMember",
              "$x.key"
            ],
            [
              "or",
              [
                "ownParameter",
                "$x.subject"
              ],
              [
                "and",
                [
                  "tree.selfField",
                  "$x.subject"
                ],
                [
                  "exists",
                  [
                    "typeDeclaration",
                    "$x.resolved.name"
                  ]
                ]
              ]
            ]
          ],
          "call": [
            "and",
            [
              "exists",
              [
                "typeDeclaration",
                "$x.resolved.name"
              ]
            ],
            [
              "not",
              [
                "isSelf",
                "$x.callee.subject"
              ]
            ],
            [
              "not",
              [
                "proven",
                [
                  "=",
                  "$x.resolved.name",
                  "$x.callee.subject.resolved.name"
                ]
              ]
            ],
            [
              "some",
              "$x.arguments",
              "g",
              [
                "paramMember",
                "$g.value"
              ]
            ],
            [
              "or",
              [
                "tree.selfField",
                "$x.callee.subject"
              ],
              [
                "ownParameter",
                "$x.callee.subject"
              ]
            ]
          ]
        },
        false
      ]
    },
    "ownParameter": {
      "args": [
        "x"
      ],
      "expr": [
        "and",
        [
          "=",
          "$x.binding.parent.kind",
          "parameter"
        ],
        [
          "=",
          [
            "enclosing",
            "$x.binding",
            "function"
          ],
          [
            "enclosing",
            "$x",
            "function"
          ]
        ]
      ]
    }
  },
  "find": {
    "select": "function",
    "as": "f",
    "where": [
      "exists",
      "$f.body.statements"
    ],
    "let": [
      [
        "looked",
        [
          "builtBy",
          [
            "last",
            "$f.body.statements"
          ]
        ]
      ]
    ],
    "having": [
      "and",
      [
        "exists",
        "$looked"
      ],
      [
        "some",
        [
          "flatten",
          [
            "list",
            [
              "list",
              "$looked"
            ],
            [
              "ownDescendants",
              "$looked"
            ]
          ]
        ],
        "d",
        [
          "keyedBy",
          "$d"
        ]
      ]
    ],
    "emit": "$f"
  }
}
