{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "php"
  ],
  "sin": {
    "name": "config-read",
    "aliases": [
      "ConfigReadDetector",
      "ConfigRead"
    ],
    "skill": "php/laravel-idioms",
    "description": "`config('\u2026')` read inside a class",
    "rule": "Inject a typed config object; never read `config('\u2026')` inside a class.",
    "suggestion": "Inject a typed config value object.",
    "requires": {
      "name": "illuminate/support",
      "ecosystem": "composer"
    }
  },
  "find": {
    "select": "call",
    "as": "c",
    "where": [
      "and",
      [
        "not",
        "$c.file.test"
      ],
      [
        "laravel.configRead",
        "$c"
      ]
    ],
    "having": [
      "and",
      [
        "exists",
        "$owner"
      ],
      [
        "not",
        [
          "proven",
          [
            "exemptedBy",
            "composition-root",
            [
              "enclosing",
              "$c",
              "function"
            ]
          ]
        ]
      ],
      [
        "not",
        [
          "proven",
          [
            "exemptedBy",
            "composition-root",
            "$owner"
          ]
        ]
      ],
      [
        "not",
        [
          "and",
          [
            "=",
            "$owner.form",
            "trait"
          ],
          [
            ">",
            [
              "count",
              [
                "filter",
                [
                  "referrers",
                  "$owner"
                ],
                "r",
                [
                  "=",
                  "$r.role",
                  "mixins"
                ]
              ]
            ],
            0
          ],
          [
            "every",
            [
              "filter",
              [
                "referrers",
                "$owner"
              ],
              "r",
              [
                "=",
                "$r.role",
                "mixins"
              ]
            ],
            "r",
            [
              "proven",
              [
                "exemptedBy",
                "composition-root",
                [
                  "enclosing",
                  "$r",
                  "type"
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    "emit": "$c",
    "let": [
      [
        "owner",
        [
          "enclosing",
          "$c",
          "type"
        ]
      ]
    ]
  }
}
