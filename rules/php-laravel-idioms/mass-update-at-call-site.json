{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "php"
  ],
  "sin": {
    "name": "mass-update-at-call-site",
    "aliases": [
      "MassUpdateAtCallSiteDetector",
      "MassUpdateAtCallSite"
    ],
    "skill": "php/laravel-idioms",
    "description": "Bare `$model->update([...])` mass-array update at a call site",
    "rule": "Mutate a model through an intention method; never `$model->update([...])` an anonymous array of columns at a call site.",
    "suggestion": "An intention method on the model (`$order->markPaid()`).",
    "requires": {
      "name": "illuminate/support",
      "ecosystem": "composer"
    },
    "reporting": {
      "crossFile": true
    }
  },
  "find": {
    "select": "call",
    "as": "c",
    "where": [
      "and",
      [
        "not",
        "$c.file.test"
      ],
      [
        "not",
        [
          "some",
          [
            "list",
            [
              "enclosing",
              "$c",
              "type"
            ]
          ],
          "t",
          [
            "and",
            [
              "exists",
              "$t"
            ],
            [
              "assignable",
              "$t",
              "Illuminate\\Database\\Seeder"
            ]
          ]
        ]
      ],
      [
        "or",
        [
          "laravel.named",
          "$c",
          "update"
        ],
        [
          "laravel.named",
          "$c",
          "save"
        ]
      ]
    ],
    "having": [
      "and",
      [
        "exists",
        "$m"
      ],
      [
        "not",
        [
          "isSelf",
          "$m.callee.subject"
        ]
      ],
      [
        "some",
        "$m.arguments",
        "a",
        [
          "and",
          [
            "=",
            [
              "position",
              "$a"
            ],
            0
          ],
          [
            "=",
            "$a.value.kind",
            "collection"
          ]
        ]
      ],
      [
        "laravel.receiverIs",
        "$m",
        "model"
      ],
      [
        "not",
        [
          "proven",
          [
            "intentionMethod",
            "$c"
          ]
        ]
      ]
    ],
    "emit": "$c",
    "let": [
      [
        "m",
        [
          "massWrite",
          "$c"
        ]
      ]
    ]
  },
  "definitions": {
    "intentionMethod": {
      "args": [
        "c"
      ],
      "expr": [
        "and",
        [
          "some",
          [
            "list",
            [
              "enclosing",
              "$c",
              "function"
            ]
          ],
          "f",
          [
            "and",
            [
              "exists",
              "$f"
            ],
            [
              "!=",
              "$f.form",
              "lambda"
            ],
            [
              "=",
              [
                "count",
                "$f.body.statements"
              ],
              1
            ],
            [
              "=",
              [
                "count",
                "$f.obligations"
              ],
              0
            ],
            [
              "some",
              "$f.body.statements",
              "s",
              [
                "=",
                "$s.expression",
                "$c"
              ]
            ]
          ]
        ],
        [
          "some",
          [
            "list",
            [
              "enclosing",
              "$c",
              "type"
            ]
          ],
          "t",
          [
            "and",
            [
              "exists",
              "$t"
            ],
            [
              "some",
              [
                "descendants",
                "$t",
                "access"
              ],
              "x",
              [
                "and",
                [
                  "=",
                  "$x.member.name",
                  "class"
                ],
                [
                  "=",
                  "$x.subject.refers",
                  "$c.callee.subject.resolved.name"
                ]
              ]
            ]
          ]
        ]
      ]
    },
    "massWrite": {
      "args": [
        "c"
      ],
      "expr": [
        "case",
        [
          "laravel.named",
          "$c",
          "update"
        ],
        {
          "true": "$c"
        },
        [
          "case",
          [
            "and",
            [
              "laravel.named",
              "$c",
              "save"
            ],
            [
              "=",
              "$c.callee.subject.kind",
              "call"
            ],
            [
              "or",
              [
                "laravel.named",
                "$c.callee.subject",
                "fill"
              ],
              [
                "laravel.named",
                "$c.callee.subject",
                "forceFill"
              ]
            ]
          ],
          {
            "true": "$c.callee.subject"
          },
          null
        ]
      ]
    }
  }
}
