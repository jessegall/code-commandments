{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "csharp",
    "php",
    "python"
  ],
  "sin": {
    "name": "query-in-loop",
    "aliases": [
      "QueryInLoopDetector",
      "QueryInLoop"
    ],
    "skill": "php/laravel-idioms",
    "description": "a query run inside a loop — one query per turn, so the work grows with the data while the code reads as though it were one call",
    "rule": "Ask the database once for everything the loop needs, before the loop.",
    "suggestion": "Load what the loop needs in one query before it: eager-load the relation with `with()`, or fetch the rows by their keys and index them, then let the loop read what is already in memory.",
    "reporting": {
      "crossFile": true
    }
  },
  "find": {
    "select": "call",
    "as": "c",
    "where": [
      "and",
      [
        "not",
        "$c.file.test"
      ],
      [
        "not",
        [
          "some",
          [
            "list",
            [
              "enclosing",
              "$c",
              "type"
            ]
          ],
          "t",
          [
            "and",
            [
              "exists",
              "$t"
            ],
            [
              "assignable",
              "$t",
              "Illuminate\\Database\\Seeder"
            ]
          ]
        ]
      ],
      [
        "not",
        [
          "some",
          [
            "list",
            [
              "enclosing",
              "$c",
              "type"
            ]
          ],
          "t",
          [
            "and",
            [
              "exists",
              "$t"
            ],
            [
              "assignable",
              "$t",
              "Illuminate\\Database\\Eloquent\\Factories\\Factory"
            ]
          ]
        ]
      ],
      [
        "some",
        [
          "flatten",
          [
            "list",
            [
              "list",
              "$c"
            ],
            [
              "ownAncestors",
              "$c"
            ]
          ]
        ],
        "a",
        [
          "and",
          [
            "=",
            "$a.parent.kind",
            "loop"
          ],
          [
            "in",
            "$a.role",
            "body",
            "steps"
          ]
        ]
      ],
      [
        "not",
        [
          "some",
          [
            "flatten",
            [
              "list",
              [
                "list",
                "$c"
              ],
              [
                "ownAncestors",
                "$c"
              ]
            ]
          ],
          "a",
          [
            "and",
            [
              "=",
              "$a.parent.kind",
              "loop"
            ],
            [
              "in",
              "$a.role",
              "body",
              "steps"
            ],
            [
              "or",
              [
                "=",
                "$a.parent.iterable.kind",
                "collection"
              ],
              [
                "and",
                [
                  "=",
                  "$a.parent.iterable.kind",
                  "call"
                ],
                [
                  "=",
                  [
                    "tree.formOf",
                    [
                      "typeDeclaration",
                      "$a.parent.iterable.callee.subject.refers"
                    ]
                  ],
                  "enum"
                ]
              ]
            ]
          ]
        ]
      ],
      [
        "hasEffect",
        "$c",
        "executes-query"
      ]
    ],
    "emit": "$c"
  }
}
