{
  "$schema": "commandments:generic-rule/v2",
  "engine": [
    "php"
  ],
  "sin": {
    "name": "hard-coded-route-path",
    "aliases": [
      "HardCodedRoutePathDetector",
      "HardCodedRoutePath"
    ],
    "skill": "php/laravel-idioms",
    "description": "A path written out by hand where a named route already declares it",
    "rule": "A route's path is declared once, in its registration; everywhere else builds it from the route's name.",
    "suggestion": "Build the URL with `route('name', $parameters)` so a changed path changes every link with it.",
    "requires": {
      "name": "illuminate/support",
      "ecosystem": "composer"
    },
    "reporting": {
      "crossFile": true
    }
  },
  "find": {
    "select": [
      "literal",
      "interpolation"
    ],
    "as": "n",
    "where": [
      "and",
      [
        "not",
        "$n.file.test"
      ],
      [
        "exists",
        [
          "enclosing",
          "$n",
          "function"
        ]
      ],
      [
        "not",
        [
          "laravel.ownerIs",
          "$n",
          "model-factory"
        ]
      ],
      [
        "startsWith",
        [
          "laravel.pathText",
          "$n"
        ],
        "/"
      ],
      [
        "not",
        [
          "startsWith",
          [
            "laravel.pathText",
            "$n"
          ],
          "//"
        ]
      ],
      [
        "not",
        [
          "some",
          [
            "ownAncestors",
            "$n"
          ],
          "a",
          [
            "and",
            [
              "=",
              "$a.kind",
              "argument"
            ],
            [
              "or",
              [
                "laravel.routed",
                "$a.parent"
              ],
              [
                "proven",
                [
                  "reportable",
                  [
                    "declarationOf",
                    "$a.parent"
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    "having": [
      "some",
      [
        "rowsOf",
        "laravel-named-routes"
      ],
      "r",
      [
        "pathFits",
        [
          "laravel.pathText",
          "$n"
        ],
        [
          "templateOf",
          "$r"
        ]
      ]
    ],
    "emit": "$n"
  },
  "definitions": {
    "templateOf": {
      "args": [
        "r"
      ],
      "expr": [
        "get",
        "$r",
        "template"
      ]
    }
  }
}
