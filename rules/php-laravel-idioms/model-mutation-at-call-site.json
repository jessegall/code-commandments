{
  "$schema": "commandments:generic-rule/v2",
  "engine": [
    "php"
  ],
  "sin": {
    "name": "model-mutation-at-call-site",
    "aliases": [
      "ModelMutationAtCallSiteDetector",
      "ModelMutationAtCallSite"
    ],
    "skill": "php/laravel-idioms",
    "description": "Set-property-then-`save()` at a call site (should be an intention method)",
    "rule": "Mutate a model through an intention method; don't set-property-then-`save()` at a call site.",
    "suggestion": "An intention method on the model (`$order->suspend($reason)`).",
    "requires": {
      "name": "illuminate/support",
      "ecosystem": "composer"
    },
    "reporting": {
      "crossFile": true
    }
  },
  "find": {
    "select": "call",
    "as": "c",
    "where": [
      "and",
      [
        "not",
        "$c.file.test"
      ],
      [
        "not",
        [
          "some",
          [
            "list",
            [
              "enclosing",
              "$c",
              "type"
            ]
          ],
          "t",
          [
            "and",
            [
              "exists",
              "$t"
            ],
            [
              "assignable",
              "$t",
              "Illuminate\\Database\\Seeder"
            ]
          ]
        ]
      ],
      [
        "laravel.named",
        "$c",
        "save"
      ],
      [
        "=",
        "$c.callee.subject.kind",
        "reference"
      ],
      [
        "not",
        [
          "=",
          "$c.callee.subject.form",
          "self"
        ]
      ]
    ],
    "having": [
      "and",
      [
        "laravel.receiverIs",
        "$c",
        "model"
      ],
      [
        "some",
        [
          "ownDescendants",
          [
            "enclosing",
            "$c",
            "function"
          ]
        ],
        "w",
        [
          "and",
          [
            "=",
            "$w.kind",
            "assignment"
          ],
          [
            "some",
            "$w.targets",
            "g",
            [
              "and",
              [
                "=",
                "$g.kind",
                "access"
              ],
              [
                "=",
                "$g.subject.kind",
                "reference"
              ],
              [
                "=",
                "$g.subject.name",
                "$c.callee.subject.name"
              ]
            ]
          ]
        ]
      ],
      [
        "not",
        [
          "some",
          [
            "ownDescendants",
            [
              "enclosing",
              "$c",
              "function"
            ]
          ],
          "n",
          [
            "and",
            [
              "=",
              "$n.kind",
              "assignment"
            ],
            [
              "some",
              "$n.targets",
              "g",
              [
                "and",
                [
                  "in",
                  "$g.kind",
                  "reference",
                  "binding"
                ],
                [
                  "=",
                  "$g.name",
                  "$c.callee.subject.name"
                ]
              ]
            ],
            [
              "some",
              "$n.values",
              "v",
              [
                "=",
                "$v.kind",
                "construction"
              ]
            ]
          ]
        ]
      ],
      [
        "not",
        [
          "some",
          [
            "list",
            [
              "enclosing",
              "$c",
              "function"
            ]
          ],
          "f",
          [
            "nonempty",
            "$f.obligations"
          ]
        ]
      ],
      [
        "not",
        [
          "proven",
          [
            "not",
            [
              "exists",
              [
                "typeDeclaration",
                [
                  "get",
                  [
                    "typeOf",
                    "$c.callee.subject"
                  ],
                  "name"
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    "emit": "$c"
  }
}
