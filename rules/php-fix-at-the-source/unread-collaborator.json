{
  "$schema": "commandments:generic-rule/v2",
  "engine": [
    "csharp",
    "go",
    "php",
    "python",
    "typescript"
  ],
  "sin": {
    "name": "unread-collaborator",
    "aliases": [
      "UnreadCollaboratorDetector",
      "UnreadCollaborator",
      "csharp-unread-collaborator",
      "python-unread-collaborator"
    ],
    "skill": "php/fix-at-the-source",
    "description": "a collaborator promoted into a private field by the constructor and never read anywhere in the class — the class asks for something it does not use, and only a search of the whole type says so",
    "rule": "A constructor asks for what the class uses, and nothing more: a collaborator no method reads is removed, along with what the callers pass.",
    "suggestion": "Delete the parameter and the field, then follow the callers: whatever they built or resolved only to hand it over goes too. If the class is meant to use it and does not, that is the bug the empty field is pointing at.",
    "reporting": {
      "crossFile": true
    }
  },
  "find": {
    "select": [
      "declarator",
      "parameter",
      "reference"
    ],
    "as": "d",
    "where": [
      "case",
      "$d.kind",
      {
        "declarator": [
          "and",
          [
            "=",
            "$d.parent.kind",
            "field"
          ],
          [
            "in",
            "$d.parent.effective.visibility",
            "private",
            "package"
          ]
        ],
        "parameter": [
          "or",
          [
            "and",
            [
              "=",
              "$d.parent.kind",
              "function"
            ],
            [
              "=",
              "$d.parent.form",
              "constructor"
            ],
            [
              "some",
              "$d.modifiers",
              "m",
              [
                "=",
                "$m",
                "private"
              ]
            ]
          ],
          [
            "and",
            [
              "=",
              "$d.parent.kind",
              "type"
            ],
            [
              "in",
              "$d.parent.form",
              "class",
              "struct"
            ]
          ]
        ],
        "reference": [
          "and",
          [
            "nonempty",
            "$d.symbol"
          ],
          [
            "in",
            "$d.effective.visibility",
            "private",
            "package"
          ]
        ]
      },
      false
    ],
    "let": [
      [
        "declared",
        [
          "case",
          "$d.kind",
          {
            "declarator": "$d.parent.declaredType",
            "parameter": "$d.declaredType"
          },
          null
        ]
      ]
    ],
    "having": [
      "and",
      [
        "not",
        "$d.file.test"
      ],
      [
        "or",
        [
          "some",
          [
            "flatten",
            [
              "list",
              [
                "list",
                "$declared"
              ],
              [
                "ownDescendants",
                "$declared"
              ]
            ]
          ],
          "t",
          [
            "and",
            [
              "=",
              "$t.kind",
              "type-expression"
            ],
            [
              "or",
              [
                "exists",
                [
                  "typeDeclaration",
                  "$t.refers"
                ]
              ],
              [
                "and",
                [
                  "=",
                  "$d.file.language",
                  "php"
                ],
                [
                  "nonempty",
                  "$t.refers"
                ]
              ]
            ]
          ]
        ],
        [
          "and",
          [
            "=",
            "$d.kind",
            "reference"
          ],
          [
            "exists",
            [
              "typeDeclaration",
              "$d.parent.resolved.name"
            ]
          ]
        ]
      ],
      [
        "=",
        [
          "count",
          [
            "filter",
            [
              "referrers",
              [
                "case",
                "$d.kind",
                {
                  "reference": "$d"
                },
                "$d.binding"
              ]
            ],
            "r",
            [
              "not",
              [
                "writtenOnly",
                "$r"
              ]
            ]
          ]
        ],
        0
      ],
      [
        "none",
        [
          "flatten",
          [
            "list",
            [
              "flatten",
              [
                "map",
                [
                  "list",
                  [
                    "enclosing",
                    "$d",
                    "type"
                  ]
                ],
                "t",
                [
                  "flatten",
                  [
                    "map",
                    "$t.mixins",
                    "m",
                    [
                      "descendants",
                      [
                        "typeDeclaration",
                        "$m.refers"
                      ]
                    ]
                  ]
                ]
              ]
            ],
            [
              "flatten",
              [
                "map",
                [
                  "filter",
                  [
                    "referrers",
                    [
                      "enclosing",
                      "$d",
                      "type"
                    ]
                  ],
                  "r",
                  [
                    "=",
                    "$r.role",
                    "mixins"
                  ]
                ],
                "r",
                [
                  "descendants",
                  [
                    "enclosing",
                    "$r",
                    "type"
                  ]
                ]
              ]
            ]
          ]
        ],
        "x",
        [
          "and",
          [
            "tree.selfField",
            "$x"
          ],
          [
            "=",
            [
              "case",
              "$x.kind",
              {
                "access": "$x.member.name",
                "reference": "$x.name"
              },
              ""
            ],
            [
              "case",
              "$d.kind",
              {
                "declarator": "$d.binding.name",
                "parameter": "$d.binding.name"
              },
              ""
            ]
          ]
        ]
      ]
    ],
    "emit": "$d"
  },
  "definitions": {
    "writtenOnly": {
      "args": [
        "r"
      ],
      "expr": [
        "or",
        [
          "and",
          [
            "=",
            "$r.role",
            "targets"
          ],
          [
            "=",
            "$r.parent.kind",
            "assignment"
          ],
          [
            "=",
            "$r.parent.mode",
            "assign"
          ]
        ],
        [
          "and",
          [
            "=",
            "$r.role",
            "member"
          ],
          [
            "=",
            "$r.parent.kind",
            "access"
          ],
          [
            "=",
            "$r.parent.role",
            "targets"
          ],
          [
            "=",
            "$r.parent.parent.kind",
            "assignment"
          ],
          [
            "=",
            "$r.parent.parent.mode",
            "assign"
          ]
        ]
      ]
    }
  }
}
