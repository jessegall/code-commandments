{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "csharp",
    "go",
    "php",
    "python",
    "typescript"
  ],
  "sin": {
    "name": "mutable-static-state",
    "aliases": [
      "MutableStaticStateDetector",
      "MutableStaticState",
      "csharp-mutable-static-state",
      "python-mutable-static-state"
    ],
    "skill": "php/fix-at-the-source",
    "description": "A write to a static property \u2014 really a global variable with a namespace attached \u2014 where whichever write happens last wins, so the order code runs in changes the result.",
    "rule": "Hold changing state on an INSTANCE someone owns and passes; never write a static property.",
    "suggestion": "Constructor-inject the state as a collaborator, so who holds it (and who may change it) is written down."
  },
  "find": {
    "select": "assignment",
    "as": "a",
    "where": [
      "and",
      [
        "exists",
        [
          "enclosing",
          "$a",
          "function"
        ]
      ],
      [
        "not",
        "$a.file.test"
      ]
    ],
    "let": [
      [
        "fn",
        [
          "enclosing",
          "$a",
          "function"
        ]
      ],
      [
        "target",
        [
          "at",
          "$a.targets",
          0
        ]
      ],
      [
        "root",
        [
          "case",
          "$target.kind",
          {
            "index": "$target.subject"
          },
          "$target"
        ]
      ],
      [
        "declared",
        [
          "declarationOf",
          "$root"
        ]
      ],
      [
        "field",
        [
          "enclosing",
          "$declared",
          "field"
        ]
      ]
    ],
    "having": [
      "and",
      [
        "or",
        [
          "=",
          [
            "count",
            "$fn.obligations"
          ],
          0
        ],
        [
          "=",
          "$fn.form",
          "constructor"
        ]
      ],
      [
        "or",
        [
          "=",
          "$field.effective.static",
          true
        ],
        [
          "some",
          "$field.modifiers",
          "m",
          [
            "=",
            "$m",
            "static"
          ]
        ],
        [
          "and",
          [
            "exists",
            "$declared"
          ],
          [
            "not",
            [
              "exists",
              [
                "enclosing",
                "$declared",
                "function"
              ]
            ]
          ],
          [
            "not",
            [
              "exists",
              [
                "enclosing",
                "$declared",
                "type"
              ]
            ]
          ]
        ],
        [
          "some",
          [
            "ownDescendants",
            "$fn.body"
          ],
          "s",
          [
            "and",
            [
              "=",
              "$s.kind",
              "scope-declaration"
            ],
            [
              "=",
              "$s.form",
              "global"
            ],
            [
              "some",
              "$s.bindings",
              "b",
              [
                "=",
                "$b.name",
                "$target.name"
              ]
            ]
          ]
        ]
      ],
      [
        "not",
        [
          "and",
          [
            "=",
            "$a.mode",
            "assign"
          ],
          [
            "some",
            [
              "ownAncestors",
              "$a"
            ],
            "g",
            [
              "and",
              [
                "=",
                "$g.kind",
                "if"
              ],
              [
                "some",
                [
                  "descendants",
                  "$g.condition"
                ],
                "y",
                [
                  "tree.names",
                  "$y",
                  [
                    "case",
                    "$root.kind",
                    {
                      "access": "$root.member.name",
                      "reference": "$root.name"
                    },
                    ""
                  ]
                ]
              ]
            ]
          ]
        ]
      ],
      [
        "not",
        [
          "some",
          [
            "before",
            [
              "enclosing",
              "$a",
              "expression-statement"
            ]
          ],
          "g",
          [
            "and",
            [
              "=",
              "$g.kind",
              "if"
            ],
            [
              "not",
              [
                "completes",
                "$g.then"
              ]
            ],
            [
              "some",
              [
                "descendants",
                "$g.condition"
              ],
              "y",
              [
                "tree.names",
                "$y",
                [
                  "case",
                  "$root.kind",
                  {
                    "access": "$root.member.name",
                    "reference": "$root.name"
                  },
                  ""
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    "emit": "$a"
  }
}
