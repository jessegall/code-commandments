{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "php",
    "python"
  ],
  "sin": {
    "name": "repeated-named-call",
    "aliases": [
      "RepeatedNamedCallDetector",
      "RepeatedNamedCall",
      "csharp-repeated-named-call",
      "python-repeated-named-call"
    ],
    "skill": "php/repeated-call-helper",
    "description": "The same `with`-style method is called with the same named argument at 2+ sites, instead of a named helper on the type.",
    "rule": "Promote a repeated call of a `with…` method with the same named argument into a method on the receiver's type that hides the call and its construction boilerplate.",
    "suggestion": "A method on the type (`withMetadata(payload)`) that makes the call once.",
    "reporting": {
      "crossFile": true
    }
  },
  "parameters": {
    "threshold": {
      "type": "number",
      "default": 2,
      "description": "How many calls repeat one named-argument shape at least."
    }
  },
  "find": {
    "from": "call",
    "as": "c",
    "pipeline": [
      {
        "reject": "$c.file.test"
      },
      {
        "where": [
          "and",
          [
            "nonempty",
            "$c.target.symbol"
          ],
          [
            ">",
            [
              "count",
              [
                "filter",
                "$c.arguments",
                "a",
                [
                  "nonempty",
                  "$a.label"
                ]
              ]
            ],
            0
          ],
          [
            "some",
            [
              "filter",
              "$c.arguments",
              "a",
              [
                "nonempty",
                "$a.label"
              ]
            ],
            "a",
            [
              "in",
              "$a.value.kind",
              "call",
              "construction",
              "collection"
            ]
          ],
          [
            "some",
            [
              "flatten",
              [
                "map",
                [
                  "list",
                  [
                    "declarationOf",
                    "$c"
                  ]
                ],
                "d",
                "$d.parameters"
              ]
            ],
            "p",
            [
              "in",
              "$p.collects",
              "rest",
              "keywords"
            ]
          ],
          [
            "not",
            [
              "isSelf",
              "$c.callee.subject"
            ]
          ]
        ]
      },
      {
        "project": {
          "anchor": "$c",
          "key": [
            "list",
            "$c.target.symbol",
            [
              "sort",
              [
                "map",
                [
                  "filter",
                  "$c.arguments",
                  "a",
                  [
                    "nonempty",
                    "$a.label"
                  ]
                ],
                "a",
                [
                  "concat",
                  "$a.label",
                  "=",
                  "$a.value.kind"
                ]
              ]
            ]
          ]
        }
      },
      {
        "groupBy": "$key"
      },
      {
        "having": [
          ">=",
          [
            "count",
            "$rows"
          ],
          "$param.threshold"
        ]
      },
      {
        "expand": "$rows"
      },
      {
        "emit": "$row.anchor",
        "group": "$key"
      }
    ]
  }
}
