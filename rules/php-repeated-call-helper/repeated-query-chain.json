{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "php"
  ],
  "sin": {
    "name": "repeated-query-chain",
    "aliases": [
      "RepeatedQueryChainDetector",
      "RepeatedQueryChain"
    ],
    "skill": "php/repeated-call-helper",
    "description": "One Eloquent query chain written alike at three or more sites outside its model",
    "rule": "A query several callers run is one named finder or scope on the model, written once.",
    "suggestion": "Add a named static finder or scope to the model (`CommandRequest::lockedFor($id)`) and call it from each site.",
    "requires": {
      "name": "illuminate/support",
      "ecosystem": "composer"
    },
    "reporting": {
      "crossFile": true
    }
  },
  "parameters": {
    "repeats": {
      "type": "number",
      "default": 3,
      "description": "How many sites write one query chain alike before it is reported."
    }
  },
  "definitions": {
    "rootOf": {
      "args": [
        "c"
      ],
      "expr": [
        "at",
        [
          "filter",
          [
            "ownDescendants",
            "$c"
          ],
          "x",
          [
            "and",
            [
              "=",
              "$x.kind",
              "call"
            ],
            [
              "=",
              "$x.callee.kind",
              "access"
            ],
            [
              "=",
              "$x.callee.subject.kind",
              "reference"
            ],
            [
              "assignable",
              "$x.callee.subject.refers",
              "model"
            ]
          ]
        ],
        0
      ]
    },
    "constrains": {
      "args": [
        "c"
      ],
      "expr": [
        "or",
        [
          "some",
          [
            "filter",
            [
              "ownDescendants",
              "$c"
            ],
            "x",
            [
              "and",
              [
                "=",
                "$x.kind",
                "call"
              ],
              [
                "=",
                "$x.callee.kind",
                "access"
              ]
            ]
          ],
          "x",
          [
            "or",
            [
              "and",
              [
                ">=",
                [
                  "count",
                  "$x.arguments"
                ],
                2
              ],
              [
                "literalIs",
                [
                  "at",
                  [
                    "map",
                    "$x.arguments",
                    "a",
                    "$a.value"
                  ],
                  0
                ],
                "string"
              ],
              [
                "!=",
                [
                  "literalValue",
                  [
                    "at",
                    [
                      "map",
                      "$x.arguments",
                      "a",
                      "$a.value"
                    ],
                    0
                  ]
                ],
                "id"
              ]
            ],
            [
              "and",
              [
                ">=",
                [
                  "count",
                  "$x.arguments"
                ],
                1
              ],
              [
                "=",
                [
                  "at",
                  [
                    "map",
                    "$x.arguments",
                    "a",
                    "$a.value.member.name"
                  ],
                  0
                ],
                "class"
              ]
            ]
          ]
        ],
        [
          "and",
          [
            ">=",
            [
              "count",
              [
                "filter",
                [
                  "ownDescendants",
                  "$c"
                ],
                "x",
                [
                  "and",
                  [
                    "=",
                    "$x.kind",
                    "call"
                  ],
                  [
                    "=",
                    "$x.callee.kind",
                    "access"
                  ]
                ]
              ]
            ],
            3
          ],
          [
            "none",
            [
              "filter",
              [
                "ownDescendants",
                "$c"
              ],
              "x",
              [
                "and",
                [
                  "=",
                  "$x.kind",
                  "call"
                ],
                [
                  "=",
                  "$x.callee.kind",
                  "access"
                ]
              ]
            ],
            "x",
            [
              "and",
              [
                ">=",
                [
                  "count",
                  "$x.arguments"
                ],
                1
              ],
              [
                "literalIs",
                [
                  "at",
                  [
                    "map",
                    "$x.arguments",
                    "a",
                    "$a.value"
                  ],
                  0
                ],
                "string"
              ],
              [
                "=",
                [
                  "literalValue",
                  [
                    "at",
                    [
                      "map",
                      "$x.arguments",
                      "a",
                      "$a.value"
                    ],
                    0
                  ]
                ],
                "id"
              ]
            ]
          ]
        ]
      ]
    }
  },
  "find": {
    "from": "call",
    "as": "c",
    "pipeline": [
      {
        "reject": "$c.file.test"
      },
      {
        "where": [
          "and",
          [
            "=",
            "$c.callee.kind",
            "access"
          ],
          [
            "=",
            "$c.callee.subject.kind",
            "call"
          ],
          [
            "not",
            [
              "and",
              [
                "=",
                "$c.parent.kind",
                "access"
              ],
              [
                "=",
                "$c.role",
                "subject"
              ]
            ]
          ],
          [
            "constrains",
            "$c"
          ]
        ]
      },
      {
        "project": {
          "anchor": "$c",
          "model": [
            "rootOf",
            "$c"
          ],
          "key": [
            "fingerprint",
            "$c",
            "renamed"
          ],
          "scope": [
            "enclosing",
            "$c",
            "function"
          ]
        }
      },
      {
        "where": [
          "and",
          [
            "exists",
            "$model"
          ],
          [
            "!=",
            "$model.callee.subject.refers",
            [
              "tree.ownSymbol",
              [
                "enclosing",
                "$anchor",
                "type"
              ]
            ]
          ]
        ]
      },
      {
        "groupBy": "$key"
      },
      {
        "having": [
          "and",
          [
            ">=",
            [
              "count",
              "$rows"
            ],
            "$param.repeats"
          ],
          [
            ">=",
            [
              "distinctCount",
              [
                "map",
                "$rows",
                "r",
                "$r.scope"
              ]
            ],
            2
          ]
        ]
      },
      {
        "expand": "$rows"
      },
      {
        "emit": "$row.anchor",
        "group": "$key"
      }
    ]
  }
}
