{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "php"
  ],
  "sin": {
    "name": "manual-hydration-loop",
    "aliases": [
      "ManualHydrationLoopDetector",
      "ManualHydrationLoop"
    ],
    "skill": "php/spatie-data",
    "description": "Collections hydrated with `::from()` per item instead of `#[DataCollectionOf]` + `::collect()`",
    "rule": "Hydrate a collection with `#[DataCollectionOf]` + `::collect()`, not a per-item `::from()` loop.",
    "suggestion": "`#[DataCollectionOf(X::class)]` + `X::collect($rows)`.",
    "requires": {
      "name": "spatie/laravel-data",
      "ecosystem": "composer"
    },
    "reporting": {
      "crossFile": true
    }
  },
  "find": {
    "select": [
      "call",
      "access"
    ],
    "as": "c",
    "where": [
      "case",
      "$c.kind",
      {
        "call": [
          "hydrates",
          "$c"
        ]
      },
      [
        "callableFrom",
        "$c"
      ]
    ],
    "having": [
      "and",
      [
        "not",
        [
          "conditional",
          "$c"
        ]
      ],
      [
        "not",
        [
          "tolerantTry",
          [
            "enclosing",
            "$c",
            "try"
          ]
        ]
      ],
      [
        "not",
        [
          "keyedStore",
          "$c"
        ]
      ],
      [
        "or",
        [
          "=",
          "$c.kind",
          "access"
        ],
        [
          "not",
          [
            "inline",
            "$c"
          ]
        ]
      ],
      [
        "none",
        [
          "ownDescendants",
          [
            "enclosing",
            "$c",
            "function"
          ]
        ],
        "y",
        [
          "=",
          "$y.kind",
          "yield"
        ]
      ]
    ],
    "emit": "$c"
  },
  "definitions": {
    "mapped": {
      "args": [
        "x"
      ],
      "expr": [
        "and",
        [
          "=",
          "$x.parent.kind",
          "argument"
        ],
        [
          "=",
          "$x.parent.parent.kind",
          "call"
        ],
        [
          "=",
          "$x.parent.parent.callee.kind",
          "reference"
        ],
        [
          "=",
          "$x.parent.parent.callee.refers",
          "array_map"
        ]
      ]
    },
    "callableFrom": {
      "args": [
        "a"
      ],
      "expr": [
        "and",
        [
          "=",
          "$a.member.name",
          "from"
        ],
        [
          "=",
          "$a.subject.kind",
          "reference"
        ],
        [
          "mapped",
          "$a"
        ],
        [
          "spatie.isData",
          [
            "typeDeclaration",
            "$a.subject.refers"
          ]
        ]
      ]
    },
    "eachItem": {
      "args": [
        "x"
      ],
      "expr": [
        "or",
        [
          "spatie.perItem",
          "$x"
        ],
        [
          "some",
          [
            "list",
            [
              "enclosing",
              "$x",
              "function"
            ]
          ],
          "f",
          [
            "and",
            [
              "exists",
              "$f"
            ],
            [
              "=",
              "$f.parent.kind",
              "argument"
            ],
            [
              "=",
              "$f.parent.parent.callee.kind",
              "access"
            ],
            [
              "=",
              "$f.parent.parent.callee.member.name",
              "map"
            ],
            [
              "assignable",
              "$f.parent.parent.callee.subject",
              [
                "identity",
                "collection"
              ]
            ]
          ]
        ]
      ]
    },
    "hydrates": {
      "args": [
        "c"
      ],
      "expr": [
        "and",
        [
          "spatie.isFrom",
          "$c"
        ],
        [
          "spatie.isData",
          [
            "spatie.ownerOf",
            "$c"
          ]
        ],
        [
          "eachItem",
          "$c"
        ]
      ]
    },
    "conditional": {
      "args": [
        "c"
      ],
      "expr": [
        "some",
        [
          "ancestors",
          "$c"
        ],
        "a",
        [
          "and",
          [
            "within",
            "$a",
            [
              "enclosing",
              "$c",
              "loop"
            ]
          ],
          [
            "or",
            [
              "in",
              "$a.kind",
              "if",
              "conditional"
            ],
            [
              "and",
              [
                "=",
                "$a.kind",
                "dispatch"
              ],
              [
                "=",
                "$a.form",
                "match"
              ]
            ],
            [
              "and",
              [
                "=",
                "$a.kind",
                "fallback"
              ],
              [
                "=",
                "$a.trigger",
                "falsy"
              ]
            ]
          ]
        ]
      ]
    },
    "tolerantTry": {
      "args": [
        "t"
      ],
      "expr": [
        "and",
        [
          "exists",
          "$t"
        ],
        [
          "some",
          [
            "ancestors",
            "$t"
          ],
          "a",
          [
            "=",
            "$a.kind",
            "loop"
          ]
        ],
        [
          "some",
          "$t.handlers",
          "h",
          [
            "none",
            [
              "descendants",
              "$h"
            ],
            "d",
            [
              "=",
              "$d.kind",
              "throw"
            ]
          ]
        ]
      ]
    },
    "keyedStore": {
      "args": [
        "c"
      ],
      "expr": [
        "some",
        [
          "list",
          [
            "enclosing",
            "$c",
            "assignment"
          ]
        ],
        "a",
        [
          "and",
          [
            "exists",
            "$a"
          ],
          [
            "some",
            "$a.targets",
            "t",
            [
              "and",
              [
                "=",
                "$t.kind",
                "index"
              ],
              [
                "exists",
                "$t.key"
              ]
            ]
          ]
        ]
      ]
    },
    "inline": {
      "args": [
        "c"
      ],
      "expr": [
        "some",
        "$c.arguments",
        "a",
        [
          "and",
          [
            "=",
            [
              "position",
              "$a"
            ],
            0
          ],
          [
            "=",
            "$a.value.kind",
            "collection"
          ]
        ]
      ]
    }
  }
}
