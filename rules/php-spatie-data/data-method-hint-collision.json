{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "php"
  ],
  "sin": {
    "name": "data-method-hint-collision",
    "aliases": [
      "DataMethodHintCollisionDetector",
      "DataMethodHintCollision"
    ],
    "skill": "php/spatie-data",
    "description": "`@method` tag that re-declares a real method (names the concrete factory, not the magic `from`/`collect`)",
    "rule": "A `@method` hint must name the magic `from`/`collect`, never re-declare a real method (no IDE collision).",
    "requires": {
      "name": "spatie/laravel-data",
      "ecosystem": "composer"
    }
  },
  "find": {
    "select": "comment",
    "as": "c",
    "where": [
      "and",
      [
        "=",
        "$c.form",
        "doc"
      ],
      [
        "=",
        "$c.documents.kind",
        "type"
      ],
      [
        "=",
        "$c.documents.form",
        "class"
      ]
    ],
    "having": [
      "and",
      [
        "some",
        "$c.tags",
        "g",
        [
          "and",
          [
            "=",
            "$g.name",
            "method"
          ],
          [
            "declares",
            "$c.documents",
            "$g"
          ]
        ]
      ],
      [
        "spatie.isData",
        "$c.documents"
      ]
    ],
    "emit": "$c.documents"
  },
  "definitions": {
    "tagWords": {
      "args": [
        "g"
      ],
      "expr": [
        "lower",
        [
          "concat",
          " ",
          [
            "coalesce",
            "$g.type",
            ""
          ],
          " ",
          [
            "coalesce",
            "$g.subject",
            ""
          ],
          " ",
          [
            "coalesce",
            "$g.text",
            ""
          ]
        ]
      ]
    },
    "declares": {
      "args": [
        "t",
        "g"
      ],
      "expr": [
        "some",
        "$t.writtenMembers",
        "m",
        [
          "and",
          [
            "=",
            "$m.kind",
            "function"
          ],
          [
            "contains",
            [
              "tagWords",
              "$g"
            ],
            [
              "lower",
              [
                "concat",
                "$m.name",
                "("
              ]
            ]
          ]
        ]
      ]
    }
  }
}
