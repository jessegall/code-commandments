{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "php"
  ],
  "sin": {
    "name": "manual-input-cast",
    "aliases": [
      "ManualInputCastDetector",
      "ManualInputCast"
    ],
    "skill": "php/spatie-data",
    "description": "A `Data` value-object property is hand-built at every construction site, instead of a `#[WithCast]` / `Castable` that owns the hydration once",
    "rule": "Hydrate a value-object property with a `#[WithCast]` (or a `Castable` value object), never by hand-building it at every `new`/`::from` call site.",
    "suggestion": "Type the property as the value object and add `#[WithCast(SomeCast::class)]` (or make the value object `Castable`) so the `simple \u2192 complex` mapping lives in one place.",
    "requires": {
      "name": "spatie/laravel-data",
      "ecosystem": "composer"
    },
    "reporting": {
      "crossFile": true
    }
  },
  "find": {
    "select": [
      "field",
      "parameter"
    ],
    "as": "s",
    "where": [
      "and",
      [
        "some",
        "$s.modifiers",
        "x",
        [
          "=",
          "$x",
          "public"
        ]
      ],
      [
        "none",
        "$s.modifiers",
        "x",
        [
          "=",
          "$x",
          "static"
        ]
      ],
      [
        "none",
        "$s.attributes",
        "a",
        [
          "in",
          "$a.refers",
          "Spatie\\LaravelData\\Attributes\\WithCast",
          "Spatie\\LaravelData\\Attributes\\WithCastAndTransformer",
          "Spatie\\LaravelData\\Attributes\\WithCastable"
        ]
      ]
    ],
    "let": [
      [
        "t",
        [
          "enclosing",
          "$s",
          "type"
        ]
      ],
      [
        "class",
        [
          "spatie.soleRefers",
          "$s.declaredType"
        ]
      ]
    ],
    "having": [
      "and",
      [
        "plainValue",
        "$class"
      ],
      [
        "spatie.isData",
        "$t"
      ],
      [
        "some",
        [
          "slotNames",
          "$s"
        ],
        "n",
        [
          "and",
          [
            ">",
            [
              "count",
              [
                "rowsOf",
                "fromSites",
                [
                  "record",
                  "owner",
                  "$t.symbol"
                ]
              ]
            ],
            0
          ],
          [
            "every",
            [
              "rowsOf",
              "fromSites",
              [
                "record",
                "owner",
                "$t.symbol"
              ]
            ],
            "r",
            [
              "handBuilt",
              "$r.call",
              "$n",
              "$class"
            ]
          ]
        ]
      ]
    ],
    "emit": "$s",
    "relations": {
      "fromSites": {
        "from": "call",
        "as": "c",
        "pipeline": [
          {
            "where": [
              "and",
              [
                "spatie.isFrom",
                "$c"
              ],
              [
                "spatie.isData",
                [
                  "spatie.ownerOf",
                  "$c"
                ]
              ]
            ]
          },
          {
            "project": {
              "owner": "$c.callee.subject.refers",
              "call": "$c"
            }
          }
        ]
      }
    }
  },
  "definitions": {
