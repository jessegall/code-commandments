        "n"
      ],
      "expr": [
        "case",
        [
          "=",
          "$arr.kind",
          "collection"
        ],
        {
          "true": [
            "first",
            [
              "map",
              [
                "filter",
                "$arr.entries",
                "e",
                [
                  "and",
                  [
                    "literalIs",
                    "$e.key",
                    "string"
                  ],
