{
  "$schema": "commandments:generic-rule/v2",
  "engine": [
    "php"
  ],
  "sin": {
    "name": "non-final-data",
    "aliases": [
      "NonFinalDataDetector",
      "NonFinalData"
    ],
    "skill": "php/spatie-data",
    "description": "Data class not `final`, or a promoted property not `readonly` on a Data object others can hold",
    "rule": "Seal a Data class `final` with `readonly` promoted props; only a Data object held by one private property, never handed out, may change in place.",
    "requires": {
      "name": "spatie/laravel-data",
      "ecosystem": "composer"
    }
  },
  "find": {
    "select": "type",
    "as": "t",
    "where": [
      "and",
      [
        "=",
        "$t.form",
        "class"
      ],
      [
        "nonempty",
        "$t.name"
      ]
    ],
    "let": [
      [
        "mutableSlots",
        [
          "filter",
          [
            "spatie.slotsOf",
            "$t"
          ],
          "s",
          [
            "and",
            [
              "=",
              "$s.kind",
              "parameter"
            ],
            [
              "not",
              [
                "proven",
                "$s.effective.readonly"
              ]
            ]
          ]
        ]
      ]
    ],
    "having": [
      "and",
      [
        "spatie.isData",
        "$t"
      ],
      [
        "or",
        [
          "and",
          [
            "none",
            "$t.modifiers",
            "m",
            [
              "in",
              "$m",
              "final",
              "abstract"
            ]
          ],
          [
            "none",
            [
              "referrers",
              "$t"
            ],
            "r",
            [
              "=",
              "$r.role",
              "bases"
            ]
          ]
        ],
        [
          "and",
          [
            "nonempty",
            "$mutableSlots"
          ],
          [
            "not",
            [
              "tree.heldPrivatelyOnly",
              "$t"
            ]
          ]
        ]
      ]
    ],
    "emit": "$t"
  }
}
