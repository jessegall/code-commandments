{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "vue",
    "typescript"
  ],
  "sin": {
    "name": "hard-coded-server-url",
    "aliases": [
      "HardCodedServerURLDetector",
      "HardCodedServerURL"
    ],
    "skill": "vue/server-calls",
    "description": "A string written out as the path of a route the server declares by name",
    "rule": "Every server address comes from the generated routes, never a path written by hand.",
    "suggestion": "Build it with the generated route helper (`route('plans.show', { plan: card.number })`) or the generated action's `.url()`.",
    "reporting": {
      "crossFile": true
    }
  },
  "find": {
    "select": [
      "literal",
      "interpolation",
      "binary"
    ],
    "as": "x",
    "where": [
      "and",
      [
        "in",
        "$x.file.language",
        "typescript",
        "vue"
      ],
      [
        "not",
        "$x.file.test"
      ],
      [
        "not",
        [
          "and",
          [
            "=",
            "$x.parent.kind",
            "binary"
          ],
          [
            "in",
            "$x.parent.operator",
            "add",
            "concatenate"
          ]
        ]
      ],
      [
        "or",
        [
          "and",
          [
            "=",
            "$x.parent.kind",
            "argument"
          ],
          [
            "in",
            "$x.parent.parent.kind",
            "call",
            "construction"
          ]
        ],
        [
          "and",
          [
            "=",
            "$x.parent.kind",
            "directive"
          ],
          [
            "=",
            "$x.role",
            "value"
          ]
        ]
      ]
    ],
    "let": [
      [
        "text",
        [
          "typescript.spelled",
          "$x"
        ]
      ]
    ],
    "having": [
      "and",
      [
        "startsWith",
        "$text",
        "/"
      ],
      [
        "not",
        [
          "startsWith",
          "$text",
          "//"
        ]
      ],
      [
        "some",
        [
          "rowsOf",
          "laravel-named-routes"
        ],
        "r",
        [
          "pathFits",
          "$text",
          [
            "templateOf",
            "$r"
          ]
        ]
      ]
    ],
    "emit": "$x"
  },
  "definitions": {
    "templateOf": {
      "args": [
        "r"
      ],
      "expr": [
        "get",
        "$r",
        "template"
      ]
    }
  }
}
