{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "csharp",
    "php",
    "python",
    "typescript"
  ],
  "sin": {
    "name": "message-at-throw",
    "aliases": [
      "MessageAtThrowDetector",
      "MessageAtThrow"
    ],
    "skill": "shared/exceptions",
    "description": "A failure's message written as a string at the throw, not by a named constructor given the values involved",
    "rule": "Pass the values involved to a named constructor on the failure; never write the message at the throw.",
    "suggestion": "A named constructor on the failure (`::for($order)`, `ForOrder(order)`) that writes the sentence once."
  },
  "definitions": {
    "writes": {
      "args": [
        "m",
        "d"
      ],
      "expr": [
        "or",
        [
          "messageText",
          "$m",
          "$d"
        ],
        [
          "=",
          "$m.kind",
          "interpolation"
        ],
        [
          "and",
          [
            "=",
            "$m.kind",
            "call"
          ],
          [
            ">",
            [
              "count",
              "$m.arguments"
            ],
            0
          ],
          [
            "some",
            "$m.arguments",
            "g",
            [
              "and",
              [
                "=",
                [
                  "position",
                  "$g"
                ],
                0
              ],
              [
                "messageText",
                "$g.value",
                "$d"
              ]
            ]
          ]
        ],
        [
          "and",
          [
            "=",
            "$m.kind",
            "binary"
          ],
          [
            "=",
            "$m.operator",
            "concatenate"
          ],
          [
            "some",
            [
              "ownDescendants",
              "$m"
            ],
            "p",
            [
              "or",
              [
                "messageText",
                "$p",
                "$d"
              ],
              [
                "=",
                "$p.kind",
                "interpolation"
              ]
            ]
          ]
        ]
      ]
    },
    "messageAtThrow": {
      "args": [
        "t"
      ],
      "expr": [
        "and",
        [
          "=",
          "$t.value.kind",
          "construction"
        ],
        [
          ">",
          [
            "count",
            "$t.value.arguments"
          ],
          0
        ],
        [
          "writes",
          [
            "firstValue",
            "$t.value"
          ],
          "$t.value"
        ]
      ]
    },
    "firstValue": {
      "args": [
        "c"
      ],
      "expr": [
        "valueOfArgument",
        [
          "at",
          "$c.arguments",
          0
        ]
      ]
    },
    "valueOfArgument": {
      "args": [
        "a"
      ],
      "expr": "$a.value"
    },
    "messageText": {
      "args": [
        "m",
        "d"
      ],
      "expr": [
        "and",
        [
          "=",
          "$m.kind",
          "literal"
        ],
        [
          "=",
          "$m.literalKind",
          "string"
        ],
        [
          "or",
          [
            "contains",
            "$m.value",
            " "
          ],
          [
            "not",
            [
              "exists",
              [
                "typeDeclaration",
                "$d.type.refers"
              ]
            ]
          ]
        ]
      ]
    }
  },
  "find": {
    "select": "throw",
    "as": "t",
    "where": [
      "and",
      [
        "not",
        "$t.file.test"
      ],
      [
        "messageAtThrow",
        "$t"
      ]
    ],
    "emit": [
      "case",
      "$t.file.language",
      {
        "php": "$t.value"
      },
      "$t"
    ]
  }
}
