{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "csharp",
    "go",
    "php",
    "python",
    "typescript"
  ],
  "sin": {
    "name": "match-default-returns-null",
    "aliases": [
      "csharp-match-default-returns-null",
      "MatchDefaultReturnsNullDetector",
      "MatchDefaultReturnsNull",
      "python-match-wildcard-returns-none",
      "MatchWildcardReturnsNoneDetector",
      "MatchWildcardReturnsNone"
    ],
    "skill": "shared/arguments",
    "description": "The default arm silently returns an absent value",
    "rule": "Handle the expected cases explicitly and signal an unexpected value.",
    "suggestion": "Handle the expected cases explicitly and signal an unexpected value."
  },
  "definitions": {
    "absent": {
      "args": [
        "x"
      ],
      "expr": [
        "or",
        [
          "tree.nullish",
          "$x"
        ],
        [
          "and",
          [
            "=",
            "$x.kind",
            "default-value"
          ],
          [
            "=",
            "$x.resolved.nullable",
            true
          ]
        ]
      ]
    },
    "results": {
      "args": [
        "body"
      ],
      "expr": [
        "case",
        "$body.kind",
        {
          "block": [
            "flatten",
            [
              "map",
              [
                "ownDescendants",
                "$body",
                "return"
              ],
              "s",
              "$s.values"
            ]
          ]
        },
        [
          "list",
          "$body"
        ]
      ]
    },
    "answersAbsent": {
      "args": [
        "body"
      ],
      "expr": [
        "case",
        "$body.kind",
        {
          "block": [
            "and",
            [
              "=",
              [
                "count",
                "$body.statements"
              ],
              1
            ],
            [
              "some",
              "$body.statements",
              "s",
              [
                "and",
                [
                  "=",
                  "$s.kind",
                  "return"
                ],
                [
                  "or",
                  [
                    "=",
                    [
                      "count",
                      "$s.values"
                    ],
                    0
                  ],
                  [
                    "some",
                    "$s.values",
                    "v",
                    [
                      "absent",
                      "$v"
                    ]
                  ]
                ]
              ]
            ]
          ]
        },
        [
          "absent",
          "$body"
        ]
      ]
    },
    "admitsAbsence": {
      "args": [
        "o"
      ],
      "expr": [
        "some",
        [
          "results",
          "$o.body"
        ],
        "v",
        [
          "or",
          [
            "absent",
            "$v"
          ],
          [
            "and",
            [
              "=",
              "$v.kind",
              "call"
            ],
            [
              "=",
              "$v.resolved.nullable",
              true
            ]
          ]
        ]
      ]
    }
  },
  "find": {
    "select": "arm",
    "as": "a",
    "where": [
      "and",
      [
        "=",
        "$a.default",
        true
      ],
      [
        "exists",
        "$a.parent.subject"
      ],
      [
        "!=",
        "$a.parent.subject.literalKind",
        "boolean"
      ]
    ],
    "let": [
      [
        "handled",
        [
          "filter",
          "$a.parent.arms",
          "o",
          [
            "!=",
            "$o.default",
            true
          ]
        ]
      ]
    ],
    "having": [
      "and",
      [
        ">=",
        [
          "count",
          "$handled"
        ],
        2
      ],
      [
        "none",
        "$handled",
        "o",
        [
          "admitsAbsence",
          "$o"
        ]
      ],
      [
        "answersAbsent",
        "$a.body"
      ]
    ],
    "emit": "$a"
  }
}
