{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "csharp",
    "php",
    "python",
    "typescript"
  ],
  "sin": {
    "name": "de-nulled-finder",
    "aliases": [
      "python-de-nulled-finder",
      "csharp-de-nulled-finder",
      "DeNulledFinderDetector",
      "DeNulledFinder"
    ],
    "skill": "shared/absence",
    "description": "Every caller takes a nullable result as present",
    "rule": "Make the finder provide a value or report the miss.",
    "suggestion": "Make the finder provide a value or report the miss.",
    "reporting": {
      "crossFile": true
    }
  },
  "definitions": {
    "forces": {
      "args": [
        "c"
      ],
      "expr": [
        "case",
        "$c.parent.kind",
        {
          "unary": [
            "=",
            "$c.parent.operator",
            "assert-present"
          ],
          "fallback": [
            "some",
            [
              "tree.insideOf",
              "$c.parent.replacement"
            ],
            "t",
            [
              "=",
              "$t.kind",
              "throw"
            ]
          ],
          "access": [
            "and",
            [
              "=",
              "$c.role",
              "subject"
            ],
            [
              "!=",
              "$c.parent.nullConditional",
              true
            ]
          ],
          "declarator": [
            "some",
            [
              "referrers",
              "$c.parent.binding"
            ],
            "r",
            [
              "absentThrows",
              "$r"
            ]
          ]
        },
        false
      ]
    },
    "absentThrows": {
      "args": [
        "r"
      ],
      "expr": [
        "and",
        [
          "=",
          "$r.parent.kind",
          "comparison"
        ],
        [
          "in",
          "$r.parent.operator",
          "equal",
          "identical"
        ],
        [
          "some",
          "$r.parent.operands",
          "o",
          [
            "and",
            [
              "=",
              "$o.kind",
              "literal"
            ],
            [
              "=",
              "$o.literalKind",
              "null"
            ]
          ]
        ],
        [
          "=",
          "$r.parent.role",
          "condition"
        ],
        [
          "=",
          "$r.parent.parent.kind",
          "if"
        ],
        [
          "some",
          [
            "tree.insideOf",
            "$r.parent.parent.then"
          ],
          "t",
          [
            "=",
            "$t.kind",
            "throw"
          ]
        ]
      ]
    }
  },
  "find": {
    "select": "function",
    "as": "f",
    "where": [
      "and",
      [
        "isNullable",
        [
          "typeOf",
          "$f"
        ]
      ],
      [
        "tree.notOverriding",
        "$f"
      ]
    ],
    "let": [
      [
        "callers",
        [
          "filter",
          [
            "referrers",
            "$f"
          ],
          "c",
          [
            "and",
            [
              "=",
              "$c.kind",
              "call"
            ],
            [
              "not",
              "$c.file.test"
            ]
          ]
        ]
      ]
    ],
    "having": [
      "and",
      [
        ">=",
        [
          "count",
          "$callers"
        ],
        2
      ],
      [
        "every",
        "$callers",
        "c",
        [
          "forces",
          "$c"
        ]
      ]
    ],
    "emit": "$f"
  }
}
