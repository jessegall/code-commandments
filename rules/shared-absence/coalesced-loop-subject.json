      "python-coalesced-loop-subject",
      "csharp-coalesced-loop-subject",
      "CoalescedLoopSubjectDetector",
      "CoalescedLoopSubject"
    ],
    "skill": "shared/absence",
    "description": "The loop header replaces a missing collection with an empty one",
    "rule": "Handle missing input before iteration or require a collection.",
    "suggestion": "Handle missing input before iteration or require a collection."
  },
  "find": {
    "select": [
      "fallback",
      "logical",
      "conditional",
      "call"
    ],
    "as": "f",
    "where": [
      "and",
      [
        "=",
        "$f.role",
        "iterable"
      ],
      [
        "=",
        "$f.parent.kind",
        "loop"
      ],
      [
        "case",
        "$f.kind",
        {
          "logical": [
            "=",
            "$f.operator",
            "or"
          ],
          "call": [
            "proven",
            [
              "hasEffect",
              "$f",
              "reads-with-default"
            ]
          ]
        },
        true
      ]
    ],
    "let": [
      [
        "heads",
        [
          "case",
          "$f.kind",
          {
            "fallback": [
              "map",
              [
                "follow",
                "$f",
                "replacement",
                "fallback"
              ],
              "g",
              "$g.subject"
            ],
            "logical": [
              "list",
              "$f.left"
            ],
            "conditional": [
              "list",
              "$f.consequent"
            ],
            "call": [
              "list",
              "$f.callee.subject"
            ]
          },
          [
            "list"
          ]
        ]
      ],
      [
        "tail",
        [
          "case",
          "$f.kind",
          {
            "fallback": [
              "last",
              [
                "map",
                [
                  "follow",
                  "$f",
                  "replacement",
                  "fallback"
                ],
                "g",
                "$g.replacement"
              ]
            ],
            "logical": "$f.right",
            "conditional": "$f.alternative",
            "call": [
              "tree.valueAt",
              "$f",
              1
            ]
          },
          null
        ]
      ]
    ],
    "having": [
      "and",
      [
        "tree.emptyCollection",
        "$tail"
      ],
      [
        "some",
        "$heads",
        "h",
        [
          "or",
          [
            "proven",
            [
              "isNullable",
              [
                "typeOf",
                "$h"
              ]
            ]
          ],
          [
            "some",
            [
              "tree.insideOf",
              "$h"
            ],
            "r",
            [
              "and",
              [
                "=",
                "$r.kind",
                "reference"
              ],
              [
                "not",
                [
                  "isSelf",
                  "$r"
                ]
              ],
              [
                "exists",
                "$r.binding"
              ],
              [
                "or",
                [
                  "=",
                  [
                    "fingerprint",
                    "$r",
                    "exact"
                  ],
                  [
                    "fingerprint",
                    "$h",
                    "exact"
                  ]
                ],
                [
                  "=",
                  "$r.role",
                  "subject"
                ]
              ]
            ]
          ]
