{
  "$schema": "commandments:generic-rule/v2",
  "engine": [
    "csharp",
    "go",
    "php",
    "python",
    "typescript"
  ],
  "sin": {
    "name": "raw-decoded-array-return",
    "aliases": [
      "python-raw-decoded-return",
      "RawDecodedArrayReturnDetector",
      "RawDecodedArrayReturn",
      "RawDecodedReturn",
      "RawDecodedReturnDetector"
    ],
    "skill": "shared/absence",
    "description": "A function returns decoded data before checking and giving it a type",
    "rule": "Validate decoded data at the boundary and return the type the caller can rely on.",
    "suggestion": "Parse the decoded payload into a named result with checked fields."
  },
  "find": {
    "select": "call",
    "as": "c",
    "where": [
      "and",
      [
        "not",
        "$c.file.test"
      ],
      [
        "returned",
        "$c"
      ],
      [
        "hasEffect",
        "$c",
        "decodes-untyped"
      ],
      [
        "not",
        [
          "hasEffect",
          [
            "uncast",
            [
              "at",
              [
                "map",
                "$c.arguments",
                "a",
                "$a.value"
              ],
              0
            ]
          ],
          "encodes-to-text"
        ]
      ]
    ],
    "let": [
      [
        "function",
        [
          "enclosing",
          "$c",
          "function"
        ]
      ]
    ],
    "having": [
      "and",
      [
        "or",
        [
          "not",
          [
            "exists",
            "$function.returnType"
          ]
        ],
        [
          "not",
          [
            "exists",
            [
              "typeDeclaration",
              "$function.returnType.resolved.name"
            ]
          ]
        ]
      ],
      [
        "none",
        "$function.obligations",
        "o",
        [
          "=",
          "$o.origin",
          "external"
        ]
      ]
    ],
    "emit": "$c"
  },
  "definitions": {
    "uncast": {
      "args": [
        "v"
      ],
      "expr": [
        "case",
        "$v.kind",
        {
          "cast": "$v.operand"
        },
        "$v"
      ]
    },
    "returned": {
      "args": [
        "x"
      ],
      "expr": [
        "or",
        [
          "=",
          "$x.parent.kind",
          "return"
        ],
        [
          "and",
          [
            "=",
            "$x.parent.kind",
            "fallback"
          ],
          [
            "=",
            "$x.role",
            "subject"
          ],
          [
            "=",
            "$x.parent.parent.kind",
            "return"
          ]
        ],
        [
          "and",
          [
            "=",
            "$x.parent.kind",
            "index"
          ],
          [
            "=",
            "$x.role",
            "subject"
          ],
          [
            "or",
            [
              "=",
              "$x.parent.parent.kind",
              "return"
            ],
            [
              "and",
              [
                "=",
                "$x.parent.parent.kind",
                "fallback"
              ],
              [
                "=",
                "$x.parent.role",
                "subject"
              ],
              [
                "=",
                "$x.parent.parent.parent.kind",
                "return"
              ]
            ]
          ]
        ]
      ]
    }
  }
}
