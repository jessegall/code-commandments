{
  "$schema": "commandments:generic-rule/v2",
  "engine": [
    "csharp",
    "php",
    "python",
    "typescript"
  ],
  "sin": {
    "name": "manufactured-fake-fill",
    "aliases": [
      "python-invented-default",
      "csharp-invented-default",
      "ManufacturedFakeFillDetector",
      "ManufacturedFakeFill",
      "InventedDefault",
      "InventedDefaultDetector"
    ],
    "skill": "shared/absence",
    "description": "An empty scalar stands in for a missing key a lookup is asked for",
    "rule": "Keep absence explicit and resolve it before the lookup.",
    "suggestion": "Resolve the missing key at its source, throw or return there, and look up only a key that exists."
  },
  "definitions": {
    "emptyScalar": {
      "args": [
        "x"
      ],
      "expr": [
        "and",
        [
          "=",
          "$x.kind",
          "literal"
        ],
        [
          "or",
          [
            "and",
            [
              "=",
              "$x.literalKind",
              "string"
            ],
            [
              "=",
              "$x.value",
              ""
            ]
          ],
          [
            "and",
            [
              "in",
              "$x.literalKind",
              "integer",
              "float"
            ],
            [
              "=",
              "$x.value",
              0
            ]
          ]
        ]
      ]
    },
    "parametersOf": {
      "args": [
        "d"
      ],
      "expr": [
        "case",
        "$d.kind",
        {
          "function": "$d.parameters",
          "type": [
            "flatten",
            [
              "map",
              [
                "filter",
                "$d.writtenMembers",
                "m",
                [
                  "and",
                  [
                    "=",
                    "$m.kind",
                    "function"
                  ],
                  [
                    "=",
                    "$m.form",
                    "constructor"
                  ]
                ]
              ],
              "m",
              "$m.parameters"
            ]
          ]
        },
        [
          "list"
        ]
      ]
    },
    "slot": {
      "args": [
        "f"
      ],
      "expr": [
        "case",
        "$f.parent.kind",
        {
          "argument": "$f.parent",
          "cast": [
            "case",
            "$f.parent.parent.kind",
            {
              "argument": "$f.parent.parent"
            },
            null
          ]
        },
        null
      ]
    },
    "defaulted": {
      "args": [
        "f"
      ],
      "expr": [
        "case",
        "$f.kind",
        {
          "fallback": "$f.replacement",
          "logical": [
            "case",
            "$f.operator",
            {
              "or": "$f.right"
            },
            null
          ],
          "conditional": [
            "case",
            [
              "absenceTested",
              "$f.condition"
            ],
            {
              "true": "$f.consequent"
            },
            [
              "case",
              [
                "valueTested",
                "$f"
              ],
              {
                "true": "$f.alternative"
              },
              null
            ]
          ]
        },
        null
      ]
    },
    "valueTested": {
      "args": [
        "f"
      ],
      "expr": [
        "some",
        [
          "tree.insideOf",
          "$f.condition"
        ],
        "x",
        [
          "and",
          [
            "!=",
            "$x.kind",
            "literal"
          ],
          [
            "=",
            [
              "fingerprint",
              "$x",
              "exact"
            ],
            [
              "fingerprint",
              "$f.consequent",
              "exact"
            ]
          ]
        ]
      ]
    },
    "absenceTested": {
      "args": [
        "c"
      ],
      "expr": [
        "and",
        [
          "=",
          "$c.kind",
          "comparison"
        ],
        [
          "in",
          "$c.operator",
          "equal",
          "identical"
        ],
        [
          "or",
          [
            "tree.nullish",
            [
              "at",
              "$c.operands",
              0
            ]
          ],
          [
            "tree.nullish",
            [
              "at",
              "$c.operands",
              1
            ]
          ]
        ]
      ]
    },
    "looksUp": {
      "args": [
        "c"
      ],
      "expr": [
        "or",
        [
          "hasEffect",
          "$c",
          "database-read"
        ],
        [
          "hasEffect",
          "$c",
          "deferred-query"
        ]
      ]
    },
    "feedsLookup": {
      "args": [
        "slot",
        "parameter"
      ],
      "expr": [
        "or",
        [
          "looksUp",
          "$slot.parent"
        ],
        [
          "readsIntoLookup",
          "$parameter.parent",
          "$parameter.binding.name"
        ],
        [
          "some",
          [
            "overriders",
            "$parameter.parent"
          ],
          "m",
          [
            "readsIntoLookup",
            "$m",
            [
              "at",
              [
                "map",
                "$m.parameters",
                "q",
                "$q.binding.name"
              ],
              [
                "position",
                "$slot"
              ]
            ]
          ]
        ]
      ]
    },
    "readsIntoLookup": {
      "args": [
        "fn",
        "name"
      ],
      "expr": [
        "some",
        [
          "descendants",
          "$fn.body"
        ],
        "x",
        [
          "and",
          [
            "=",
            "$x.kind",
            "reference"
          ],
          [
            "=",
            "$x.name",
            "$name"
          ],
          [
            "=",
            "$x.parent.kind",
            "argument"
          ],
          [
            "looksUp",
            "$x.parent.parent"
          ]
        ]
      ]
    }
  },
  "find": {
    "select": [
      "fallback",
      "logical",
      "conditional"
    ],
    "as": "f",
    "where": [
      "and",
      [
        "not",
        "$f.file.test"
      ],
      [
        "emptyScalar",
        [
          "defaulted",
          "$f"
        ]
      ]
    ],
    "let": [
      [
        "slot",
        [
          "slot",
          "$f"
        ]
      ],
      [
        "parameter",
        [
          "at",
          [
            "parametersOf",
            [
              "declarationOf",
              "$slot.parent"
            ]
          ],
          [
            "position",
            "$slot"
          ]
        ]
      ]
    ],
    "having": [
      "and",
      [
        "exists",
        "$slot"
      ],
      [
        "in",
        "$slot.parent.kind",
        "call",
        "construction"
      ],
      [
        "or",
        [
          "not",
          [
            "exists",
            "$parameter.default"
          ]
        ],
        [
          "!=",
          [
            "fingerprint",
            "$parameter.default",
            "exact"
          ],
          [
            "fingerprint",
            [
              "defaulted",
              "$f"
            ],
            "exact"
          ]
        ]
      ],
      [
        "feedsLookup",
        "$slot",
        "$parameter"
      ]
    ],
    "emit": "$f"
  }
}
