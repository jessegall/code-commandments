{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "csharp",
    "php",
    "python",
    "typescript"
  ],
  "sin": {
    "name": "placeholder-filled-data",
    "aliases": [
      "python-placeholder-filled-data",
      "csharp-placeholder-filled-data",
      "PlaceholderFilledDataDetector",
      "PlaceholderFilledData"
    ],
    "skill": "shared/absence",
    "description": "A blank string fills a required string field in a data type",
    "rule": "Supply the required value or make its absence part of the type.",
    "suggestion": "Validate the data before constructing it, or make a separate type for the incomplete state.",
    "reporting": {
      "crossFile": true
    }
  },
  "definitions": {
    "blank": {
      "args": [
        "x"
      ],
      "expr": [
        "or",
        [
          "and",
          [
            "=",
            "$x.kind",
            "literal"
          ],
          [
            "=",
            "$x.literalKind",
            "string"
          ],
          [
            "=",
            "$x.value",
            ""
          ]
        ],
        [
          "and",
          [
            "=",
            "$x.kind",
            "access"
          ],
          [
            "has",
            [
              "identities",
              "empty-text"
            ],
            "$x.member.refers"
          ]
        ]
      ]
    },
    "requiredText": {
      "args": [
        "t"
      ],
      "expr": [
        "and",
        [
          "not",
          [
            "isNullable",
            "$t"
          ]
        ],
        [
          "=",
          [
            "typeCategory",
            "$t"
          ],
          "text"
        ]
      ]
    },
    "slotOf": {
      "args": [
        "c",
        "a"
      ],
      "expr": [
        "case",
        [
          "exists",
          "$a.label"
        ],
        {
          "true": [
            "fieldType",
            [
              "typeOf",
              "$c"
            ],
            "$a.label"
          ]
        },
        [
          "get",
          [
            "at",
            [
              "fieldsOf",
              [
                "typeOf",
                "$c"
              ]
            ],
            [
              "position",
              "$a"
            ]
          ],
          "type"
        ]
      ]
    },
    "handedIn": {
      "args": [
        "c"
      ],
      "expr": [
        "some",
        "$c.arguments",
        "a",
        [
          "and",
          [
            "=",
            "$a.value.kind",
            "reference"
          ],
          [
            "some",
            [
              "get",
              [
                "enclosing",
                "$c",
                "function"
              ],
              "parameters"
            ],
            "p",
            [
              "=",
              "$p.binding.name",
              "$a.value.name"
            ]
          ]
        ]
      ]
    }
  },
  "find": {
    "select": [
      "construction",
      "collection"
    ],
    "as": "c",
    "where": [
      "not",
      "$c.file.test"
    ],
    "let": [
      [
        "owner",
        [
          "enclosing",
          "$c",
          "type"
        ]
      ]
    ],
    "having": [
      "and",
      [
        "or",
        [
          "!=",
          "$owner.symbol",
          "$c.resolved.name"
        ],
        [
          "handedIn",
          "$c"
        ]
      ],
      [
        "case",
        "$c.kind",
        {
          "construction": [
            "or",
            [
              "some",
              "$c.arguments",
              "a",
              [
                "and",
                [
                  "blank",
                  "$a.value"
                ],
                [
                  "requiredText",
                  [
                    "slotOf",
                    "$c",
                    "$a"
                  ]
                ]
              ]
            ],
            [
              "some",
              "$c.initializer.entries",
              "e",
              [
                "and",
                [
                  "blank",
                  "$e.value"
                ],
                [
                  "requiredText",
                  [
                    "fieldType",
                    [
                      "typeOf",
                      "$c"
                    ],
                    "$e.key.name"
                  ]
                ]
              ]
            ]
          ],
          "collection": [
            "and",
            [
              "!=",
              "$c.resolved.kind",
              "object"
            ],
            [
              "some",
              "$c.entries",
              "e",
              [
                "and",
                [
                  "blank",
                  "$e.value"
                ],
                [
                  "requiredText",
                  [
                    "fieldType",
                    [
                      "typeOf",
                      "$c"
                    ],
                    "$e.key.name"
                  ]
                ]
              ]
            ]
          ]
        },
        false
      ]
    ],
    "emit": "$c"
  }
}
