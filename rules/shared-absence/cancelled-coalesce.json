{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "csharp",
    "php",
    "python",
    "typescript"
  ],
  "sin": {
    "name": "cancelled-coalesce",
    "aliases": [
      "python-cancelled-fallback",
      "csharp-cancelled-coalesce",
      "CancelledCoalesceDetector",
      "CancelledCoalesce",
      "CancelledFallback",
      "CancelledFallbackDetector"
    ],
    "skill": "shared/absence",
    "description": "A fallback compared against the same value it falls back to (`(name ?? '') !== ''`, `(name or \"\") != \"\"`): missing and empty end up in one branch without saying so",
    "rule": "Ask about absence directly; never fall back to a value only to compare against that same value.",
    "suggestion": "Say both halves out loud (`name !== null && name !== ''`), or make the value always present where it is made so only one question is left."
  },
  "find": {
    "select": [
      "fallback",
      "logical",
      "conditional",
      "call"
    ],
    "as": "f",
    "where": [
      "exists",
      [
        "comparisonOf",
        "$f"
      ]
    ],
    "let": [
      [
        "replacement",
        [
          "replacementOf",
          "$f"
        ]
      ],
      [
        "compared",
        [
          "comparisonOf",
          "$f"
        ]
      ]
    ],
    "having": [
      "and",
      [
        "exists",
        "$replacement"
      ],
      [
        "or",
        [
          "=",
          "$replacement.kind",
          "literal"
        ],
        [
          "and",
          [
            "=",
            "$replacement.kind",
            "access"
          ],
          [
            "=",
            "$replacement.form",
            "static"
          ]
        ]
      ],
      [
        "not",
        [
          "tree.nullish",
          "$replacement"
        ]
      ],
      [
        "absenceChoice",
        "$f",
        "$replacement"
      ],
      [
        "every",
        "$compared.operators",
        "o",
        [
          "in",
          "$o",
          "equal",
          "not-equal",
          "identical",
          "not-identical",
          "less",
          "less-or-equal",
          "greater",
          "greater-or-equal"
        ]
      ],
      [
        "some",
        "$compared.operands",
        "side",
        [
          "and",
          [
            "!=",
            [
              "fingerprint",
              "$side",
              "exact"
            ],
            [
              "fingerprint",
              "$f",
              "exact"
            ]
          ],
          [
            "=",
            [
              "fingerprint",
              "$side",
              "exact"
            ],
            [
              "fingerprint",
              "$replacement",
              "exact"
            ]
          ]
        ]
      ]
    ],
    "emit": "$f"
  },
  "definitions": {
    "comparisonOf": {
      "args": [
        "x"
      ],
      "expr": [
        "case",
        "$x.parent.kind",
        {
          "comparison": "$x.parent",
          "assignment": [
            "case",
            [
              "and",
              [
                "=",
                [
                  "count",
                  "$x.parent.values"
                ],
                1
              ],
              [
                "=",
                "$x.parent.parent.kind",
                "comparison"
              ]
            ],
            {
              "true": "$x.parent.parent"
            },
            null
          ],
          "cast": [
            "case",
            [
              "=",
              "$x.parent.parent.kind",
              "comparison"
            ],
            {
              "true": "$x.parent.parent"
            },
            null
          ]
        },
        null
      ]
    },
    "replacementOf": {
      "args": [
        "x"
      ],
      "expr": [
        "case",
        "$x.kind",
        {
          "fallback": "$x.replacement",
          "logical": [
            "case",
            [
              "=",
              "$x.operator",
              "or"
            ],
            {
              "true": "$x.right"
            },
            null
          ],
          "conditional": "$x.alternative",
          "call": [
            "case",
            [
              "hasEffect",
              "$x",
              "reads-with-default"
            ],
            {
              "true": [
                "tree.valueAt",
                "$x",
                1
              ]
            },
            null
          ]
        },
        null
      ]
    },
    "absenceChoice": {
      "args": [
        "x",
        "r"
      ],
      "expr": [
        "case",
        "$x.kind",
        {
          "conditional": [
            "and",
            [
              "=",
              "$x.condition.kind",
              "comparison"
            ],
            [
              "some",
              "$x.condition.operands",
              "o",
              [
                "tree.nullish",
                "$o"
              ]
            ],
            [
              "some",
              "$x.condition.operands",
              "o",
              [
                "=",
                [
                  "fingerprint",
                  "$o",
                  "exact"
                ],
                [
                  "fingerprint",
                  "$x.consequent",
                  "exact"
                ]
              ]
            ]
          ],
          "logical": [
            "!=",
            "$r.literalKind",
            "boolean"
          ]
        },
        true
      ]
    }
  }
}
