{
  "$schema": "commandments:generic-rule/v2",
  "engine": [
    "php"
  ],
  "sin": {
    "name": "checked-then-read",
    "aliases": [
      "CheckedThenRead"
    ],
    "skill": "shared/absence",
    "description": "One lookup is asked twice: a key is tested (`has(k)`, `isset($a[k])`) and then read with the same key, instead of one read that answers with the absence handled",
    "rule": "Ask for a value once: read it in a way that says it may be missing (an Option, a default the owner gives), never test for it first and then read it again.",
    "suggestion": "Replace the test and the read with one call that answers (`$headers->project()` returning an Option, or the owner's `getOr($k, $default)`)."
  },
  "definitions": {
    "keyedTest": {
      "args": [
        "t"
      ],
      "expr": [
        "or",
        [
          "and",
          [
            "=",
            "$t.callee.kind",
            "access"
          ],
          [
            "=",
            "$t.callee.form",
            "instance"
          ],
          [
            "=",
            [
              "count",
              "$t.arguments"
            ],
            1
          ],
          [
            "not",
            [
              "isSelf",
              "$t.callee.subject"
            ]
          ],
          [
            "scalarKey",
            "$t"
          ]
        ],
        [
          "and",
          [
            "=",
            "$t.form",
            "presence"
          ],
          [
            "=",
            [
              "count",
              "$t.arguments"
            ],
            1
          ],
          [
            "=",
            [
              "get",
              [
                "first",
                "$t.arguments"
              ],
              "value"
            ],
            [
              "get",
              [
                "first",
                "$t.arguments"
              ],
              "value"
            ]
          ]
        ]
      ]
    },
    "firstKey": {
      "args": [
        "call"
      ],
      "expr": [
        "fingerprint",
        [
          "get",
          [
            "first",
            "$call.arguments"
          ],
          "value"
        ],
        "exact"
      ]
    },
    "readsWhatItTested": {
      "args": [
        "t",
        "r"
      ],
      "expr": [
        "case",
        [
          "=",
          "$t.form",
          "presence"
        ],
        {
          "true": [
            "and",
            [
              "=",
              "$r.kind",
              "index"
            ],
            [
              "=",
              [
                "fingerprint",
                "$r",
                "exact"
              ],
              [
                "firstKey",
                "$t"
              ]
            ],
            [
              "proven",
              [
                "=",
                [
                  "accessMode",
                  "$r"
                ],
                "read"
              ]
            ],
            [
              "not",
              [
                "some",
                [
                  "ownAncestors",
                  "$r"
                ],
                "a",
                [
                  "=",
                  "$a.role",
                  "targets"
                ]
              ]
            ]
          ]
        },
        [
          "and",
          [
            "=",
            "$r.kind",
            "call"
          ],
          [
            "=",
            "$r.callee.kind",
            "access"
          ],
          [
            "!=",
            "$r.callee.member.name",
            "$t.callee.member.name"
          ],
          [
            "=",
            [
              "fingerprint",
              "$r.callee.subject",
              "exact"
            ],
            [
              "fingerprint",
              "$t.callee.subject",
              "exact"
            ]
          ],
          [
            "=",
            [
              "count",
              "$r.arguments"
            ],
            1
          ],
          [
            "=",
            [
              "firstKey",
              "$r"
            ],
            [
              "firstKey",
              "$t"
            ]
          ],
          [
            "!=",
            [
              "get",
              [
                "consumer",
                "$r"
              ],
              "use"
            ],
            "discarded"
          ]
        ]
      ]
    },
    "scalarKey": {
      "args": [
        "t"
      ],
      "expr": [
        "some",
        [
          "list",
          [
            "get",
            [
              "first",
              "$t.arguments"
            ],
            "value"
          ]
        ],
        "k",
        [
          "or",
          [
            "=",
            "$k.kind",
            "literal"
          ],
          [
            "and",
            [
              "=",
              "$k.kind",
              "access"
            ],
            [
              "=",
              "$k.form",
              "static"
            ]
          ],
          [
            "proven",
            [
              "in",
              [
                "typeCategory",
                [
                  "typeOf",
                  "$k"
                ]
              ],
              "text",
              "integer"
            ]
          ]
        ]
      ]
    }
  },
  "find": {
    "select": "call",
    "as": "t",
    "where": [
      "and",
      [
        "not",
        "$t.file.test"
      ],
      [
        "keyedTest",
        "$t"
      ]
    ],
    "let": [
      [
        "d",
        [
          "enclosing",
          "$t",
          "choice"
        ]
      ]
    ],
    "having": [
      "and",
      [
        "exists",
        "$d"
      ],
      [
        "within",
        "$t",
        "$d.condition"
      ],
      [
        "some",
        [
          "flatten",
          [
            "list",
            [
              "ownDescendants",
              "$d.then"
            ],
            [
              "ownDescendants",
              "$d.else"
            ],
            [
              "ownDescendants",
              "$d.consequent"
            ],
            [
              "ownDescendants",
              "$d.alternative"
            ]
          ]
        ],
        "r",
        [
          "readsWhatItTested",
          "$t",
          "$r"
        ]
      ]
    ],
    "emit": "$t"
  }
}
