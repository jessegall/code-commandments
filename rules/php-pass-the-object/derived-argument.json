        "$x.kind",
        {
          "reference": "$x",
          "access": [
            "root2",
            "$x.subject"
          ]
        },
        null
      ]
    },
    "pieceRoot": {
      "args": [
        "l",
        "n"
      ],
      "expr": [
        "rootOf",
        [
          "subjectOf",
          [
            "piece",
            [
              "at",
              "$l",
              "$n"
            ]
          ]
        ]
      ]
    },
    "pieceMember": {
