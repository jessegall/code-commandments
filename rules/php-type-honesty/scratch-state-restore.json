{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "csharp",
    "go",
    "php",
    "python",
    "typescript"
  ],
  "sin": {
    "name": "scratch-state-restore",
    "aliases": [
      "ScratchStateRestoreDetector",
      "ScratchStateRestore",
      "python-scratch-state-restore"
    ],
    "skill": "php/type-honesty",
    "description": "Scratch state on the object: a method saves one of its own fields to a local and restores it later, the field really a per-call input.",
    "rule": "Pass a per-call value as a parameter; don't save-and-restore one of your own fields as scratch state."
  },
  "definitions": {
    "memberOf": {
      "args": [
        "x"
      ],
      "expr": "$x.member.name"
    },
    "nameOfNode": {
      "args": [
        "x"
      ],
      "expr": "$x.name"
    },
    "savedName": {
      "args": [
        "d"
      ],
      "expr": [
        "case",
        "$d.kind",
        {
          "declarator": "$d.binding.name"
        },
        [
          "nameOfNode",
          [
            "at",
            "$d.targets",
            0
          ]
        ]
      ]
    },
    "restores": {
      "args": [
        "a",
        "n"
      ],
      "expr": [
        "names",
        [
          "at",
          "$a.values",
          0
        ],
        "$n"
      ]
    },
    "names": {
      "args": [
        "x",
        "n"
      ],
      "expr": [
        "and",
        [
          "=",
          "$x.kind",
          "reference"
        ],
        [
          "=",
          "$x.name",
          "$n"
        ]
      ]
    },
    "savedFrom": {
      "args": [
        "d"
      ],
      "expr": [
        "case",
        "$d.kind",
        {
          "declarator": "$d.initializer"
        },
        [
          "at",
          "$d.values",
          0
        ]
      ]
    }
  },
  "find": {
    "select": [
      "declarator",
      "assignment"
    ],
    "as": "d",
    "where": [
      "and",
      [
        "case",
        "$d.kind",
        {
          "declarator": [
            "tree.selfField",
            "$d.initializer"
          ],
          "assignment": [
            "and",
            [
              "in",
              "$d.mode",
              "assign",
              "define"
            ],
            [
              "=",
              [
                "count",
                "$d.targets"
              ],
              1
            ],
            [
              "in",
              [
                "tree.kindOf",
                [
                  "at",
                  "$d.targets",
                  0
                ]
              ],
              "reference",
              "binding"
            ],
            [
              "tree.selfField",
              [
                "at",
                "$d.values",
                0
              ]
            ]
          ]
        },
        false
      ],
      [
        "exists",
        [
          "enclosing",
          "$d",
          "function"
        ]
      ]
    ],
    "let": [
      [
        "field",
        [
          "memberOf",
          [
            "savedFrom",
            "$d"
          ]
        ]
      ],
      [
        "saved",
        [
          "savedName",
          "$d"
        ]
      ],
      [
        "assigned",
        [
          "filter",
          [
            "ownDescendants",
            [
              "enclosing",
              "$d",
              "function"
            ]
          ],
          "a",
          [
            "and",
            [
              "=",
              "$a.kind",
              "assignment"
            ],
            [
              "tree.selfField",
              [
                "at",
                "$a.targets",
                0
              ]
            ],
            [
              "=",
              [
                "memberOf",
                [
                  "at",
                  "$a.targets",
                  0
                ]
              ],
              "$field"
            ],
            [
              ">",
              "$a.line",
              "$d.line"
            ]
          ]
        ]
      ]
    ],
    "having": [
      "some",
      "$assigned",
      "back",
      [
        "and",
        [
          "restores",
          "$back",
          "$saved"
        ],
        [
          "some",
          "$assigned",
          "w",
          [
            "and",
            [
              "<",
              "$w.line",
              "$back.line"
            ],
            [
              "not",
              [
                "restores",
                "$w",
                "$saved"
              ]
            ]
          ]
        ],
        [
          "not",
          [
            "some",
            [
              "ownDescendants",
              [
                "enclosing",
                "$d",
                "function"
              ]
            ],
            "x",
            [
              "and",
              [
                ">",
                "$x.line",
                "$d.line"
              ],
              [
                "<",
                "$x.line",
                "$back.line"
              ],
              [
                "or",
                [
                  "=",
                  "$x.kind",
                  "yield"
                ],
                [
                  "and",
                  [
                    "=",
                    "$x.kind",
                    "call"
                  ],
                  [
                    "=",
                    "$x.callee.kind",
                    "reference"
                  ],
                  [
                    "some",
                    [
                      "list",
                      [
                        "declarationOf",
                        "$x.callee"
                      ]
                    ],
                    "q",
                    [
                      "=",
                      "$q.parent.kind",
                      "parameter"
                    ]
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    "emit": [
      "enclosing",
      "$d",
      "function"
    ]
  }
}
