{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "csharp",
    "go",
    "php",
    "python",
    "typescript"
  ],
  "sin": {
    "name": "scratch-state-restore",
    "aliases": [
      "ScratchStateRestoreDetector",
      "ScratchStateRestore",
      "python-scratch-state-restore"
    ],
    "skill": "php/type-honesty",
    "description": "Scratch state on `$this` — a method that saves one of its own fields to a local and restores it (`$prev = $this->scope; … $this->scope = $prev`), the field really a per-call input",
    "rule": "Pass a per-call value as a parameter; don't save-and-restore one of your own fields as scratch state."
  },
  "definitions": {
    "memberOf": {
      "args": [
        "x"
      ],
      "expr": "$x.member.name"
    },
    "restores": {
      "args": [
        "a",
        "n"
      ],
      "expr": [
        "names",
        [
          "at",
          "$a.values",
          0
        ],
        "$n"
      ]
    },
    "names": {
      "args": [
        "x",
        "n"
      ],
      "expr": [
        "and",
        [
          "=",
          "$x.kind",
          "reference"
        ],
        [
          "=",
          "$x.name",
          "$n"
        ]
      ]
    }
  },
  "find": {
    "select": "declarator",
    "as": "d",
    "where": [
      "and",
      [
        "tree.selfField",
        "$d.initializer"
      ],
      [
        "exists",
        [
          "enclosing",
          "$d",
          "function"
        ]
      ]
    ],
    "let": [
      [
        "field",
        "$d.initializer.member.name"
      ],
      [
        "saved",
        "$d.binding.name"
      ],
      [
        "assigned",
        [
          "filter",
          [
            "ownDescendants",
            [
              "enclosing",
              "$d",
              "function"
            ]
          ],
          "a",
          [
            "and",
            [
              "=",
              "$a.kind",
              "assignment"
            ],
            [
              "tree.selfField",
              [
                "at",
                "$a.targets",
                0
              ]
            ],
            [
              "=",
              [
                "memberOf",
                [
                  "at",
                  "$a.targets",
                  0
                ]
              ],
              "$field"
            ],
            [
              ">",
              "$a.line",
              "$d.line"
            ]
          ]
        ]
      ]
    ],
    "having": [
      "some",
      "$assigned",
      "back",
      [
        "and",
        [
          "restores",
          "$back",
          "$saved"
        ],
        [
          "some",
          "$assigned",
          "w",
          [
            "and",
            [
              "<",
              "$w.line",
              "$back.line"
            ],
            [
              "not",
              [
                "restores",
                "$w",
                "$saved"
              ]
            ]
          ]
        ]
      ]
    ],
    "emit": [
      "enclosing",
      "$d",
      "function"
    ]
  }
}
