{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "csharp",
    "go",
    "php",
    "python",
    "typescript"
  ],
  "sin": {
    "name": "unused-private-member",
    "aliases": [
      "UnusedPrivateMemberDetector",
      "UnusedPrivateMember"
    ],
    "skill": "php/type-honesty",
    "description": "A private method nothing in its class calls, or a private property nothing in its class reads: dead code the class still carries.",
    "rule": "A class carries only what it uses; a private member nothing reads is dead and is deleted.",
    "suggestion": "Delete the member, or call it from where it was meant to be used.",
    "reporting": {
      "crossFile": true
    }
  },
  "definitions": {
    "hidden": {
      "args": [
        "m"
      ],
      "expr": [
        "or",
        [
          "some",
          "$m.modifiers",
          "x",
          [
            "=",
            "$x",
            "private"
          ]
        ],
        [
          "in",
          "$m.effective.visibility",
          "private",
          "package"
        ]
      ]
    },
    "overwritten": {
      "args": [
        "r"
      ],
      "expr": [
        "some",
        [
          "list",
          [
            "enclosing",
            "$r",
            "assignment",
            "function"
          ]
        ],
        "a",
        [
          "and",
          [
            "=",
            "$a.kind",
            "assignment"
          ],
          [
            "in",
            "$a.mode",
            "assign",
            "define"
          ],
          [
            "some",
            "$a.targets",
            "t",
            [
              "within",
              "$r",
              "$t"
            ]
          ]
        ]
      ]
    }
  },
  "find": {
    "select": [
      "function",
      "declarator"
    ],
    "as": "m",
    "where": [
      "case",
      "$m.kind",
      {
        "function": [
          "and",
          [
            "hidden",
            "$m"
          ],
          [
            "!=",
            "$m.form",
            "constructor"
          ],
          [
            "=",
            [
              "count",
              "$m.obligations"
            ],
            0
          ],
          [
            "or",
            [
              "exists",
              [
                "enclosing",
                "$m",
                "type"
              ]
            ],
            [
              "exists",
              "$m.receiver"
            ]
          ]
        ],
        "declarator": [
          "and",
          [
            "=",
            "$m.parent.kind",
            "field"
          ],
          [
            "some",
            "$m.parent.modifiers",
            "x",
            [
              "=",
              "$x",
              "private"
            ]
          ]
        ]
      },
      false
    ],
    "let": [
      [
        "named",
        [
          "case",
          "$m.kind",
          {
            "declarator": "$m.binding"
          },
          "$m"
        ]
      ]
    ],
    "having": [
      "and",
      [
        "=",
        [
          "count",
          [
            "filter",
            [
              "referrers",
              "$named"
            ],
            "r",
            [
              "not",
              [
                "overwritten",
                "$r"
              ]
            ]
          ]
        ],
        0
      ],
      [
        "none",
        [
          "ownDescendants",
          [
            "last",
            [
              "ownAncestors",
              "$m"
            ]
          ],
          "literal"
        ],
        "l",
        [
          "=",
          "$l.value",
          "$named.name"
        ]
      ]
    ],
    "emit": "$m"
  }
}
