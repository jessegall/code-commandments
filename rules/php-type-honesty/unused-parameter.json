{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "csharp",
    "go",
    "php",
    "python",
    "typescript"
  ],
  "sin": {
    "name": "unused-parameter",
    "aliases": [
      "UnusedParameterDetector",
      "UnusedParameter"
    ],
    "skill": "php/type-honesty",
    "description": "A parameter of a method no subclass can override that its body never reads: every caller must pass a value nothing uses.",
    "rule": "A signature asks only for what its body uses; a parameter no override can need and nothing reads is dead.",
    "suggestion": "Remove the parameter and the argument at each call site, or use it where it was meant to be used."
  },
  "find": {
    "select": "parameter",
    "as": "p",
    "where": [
      "and",
      [
        "=",
        "$p.parent.kind",
        "function"
      ],
      [
        "exists",
        "$p.binding"
      ],
      [
        "not",
        [
          "reads",
          "$p.binding.name",
          "fixture-marker"
        ]
      ],
      [
        "not",
        [
          "startsWith",
          "$p.binding.name",
          "_"
        ]
      ],
      [
        "=",
        [
          "count",
          "$p.parent.obligations"
        ],
        0
      ],
      [
        "exists",
        "$p.parent.body"
      ],
      [
        ">",
        [
          "count",
          "$p.parent.parameters"
        ],
        1
      ],
      [
        "none",
        "$p.parent.modifiers",
        "m",
        [
          "in",
          "$m",
          "virtual",
          "abstract"
        ]
      ],
      [
        "=",
        [
          "count",
          "$p.modifiers"
        ],
        0
      ],
      [
        "!=",
        "$p.role",
        "receiver"
      ]
    ],
    "having": [
      "and",
      [
        "none",
        [
          "descendants",
          "$p.parent.body"
        ],
        "x",
        [
          "and",
          [
            "=",
            "$x.kind",
            "reference"
          ],
          [
            "=",
            "$x.name",
            "$p.binding.name"
          ]
        ]
      ],
      [
        "some",
        "$p.parent.parameters",
        "q",
        [
          "and",
          [
            "!=",
            "$q",
            "$p"
          ],
          [
            "exists",
            "$q.binding"
          ],
          [
            "some",
            [
              "descendants",
              "$p.parent.body"
            ],
            "x",
            [
              "and",
              [
                "=",
                "$x.kind",
                "reference"
              ],
              [
                "=",
                "$x.name",
                "$q.binding.name"
              ]
            ]
          ]
        ]
      ],
      [
        "or",
        [
          "some",
          "$p.parent.modifiers",
          "m",
          [
            "=",
            "$m",
            "private"
          ]
        ],
        [
          "not",
          [
            "exists",
            "$owner"
          ]
        ],
        [
          "and",
          [
            "=",
            [
              "count",
              "$owner.bases"
            ],
            0
          ],
          [
            "=",
            [
              "count",
              "$owner.interfaces"
            ],
            0
          ]
        ],
        [
          "=",
          "$owner.form",
          "enum"
        ],
        [
          "and",
          [
            "some",
            "$owner.modifiers",
            "m",
            [
              "=",
              "$m",
              "final"
            ]
          ],
          [
            "every",
            "$owner.bases",
            "b",
            [
              "exists",
              [
                "typeDeclaration",
                "$b.refers"
              ]
            ]
          ],
          [
            "every",
            "$owner.interfaces",
            "b",
            [
              "exists",
              [
                "typeDeclaration",
                "$b.refers"
              ]
            ]
          ]
        ]
      ],
      [
        "none",
        [
          "descendants",
          "$p.parent.body"
        ],
        "x",
        [
          "and",
          [
            "=",
            "$x.kind",
            "call"
          ],
          [
            "in",
            "$x.callee.name",
            "compact",
            "func_get_args",
            "get_defined_vars"
          ]
        ]
      ],
      [
        "none",
        [
          "referrers",
          "$p.parent"
        ],
        "u",
        [
          "and",
          [
            "not",
            [
              "in",
              "$u.kind",
              "call",
              "construction"
            ]
          ],
          [
            "not",
            [
              "=",
              [
                "case",
                "$u.parent.kind",
                {
                  "access": "$u.parent.role"
                },
                "$u.role"
              ],
              "callee"
            ]
          ]
        ]
      ]
    ],
    "emit": "$p",
    "let": [
      [
        "owner",
        [
          "enclosing",
          "$p",
          "type"
        ]
      ]
    ]
  }
}
