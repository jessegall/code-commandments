{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "csharp",
    "go",
    "php",
    "python",
    "typescript"
  ],
  "sin": {
    "name": "filled-parameter",
    "aliases": [
      "FilledParameterDetector",
      "FilledParameter",
      "csharp-filled-parameter",
      "python-filled-parameter"
    ],
    "skill": "php/type-honesty",
    "description": "a `void` method that writes a property of an object it was handed, whose caller then reads what it handed over — the signature says the object goes in and nothing says it comes out changed",
    "rule": "A method that works something out gives it back: return the value, and let the caller decide where it goes.",
    "suggestion": "Return what the method works out and let the caller assign it, or ask the object to change itself, so the signature says what happens."
  },
  "definitions": {
    "targetKind": {
      "args": [
        "a"
      ],
      "expr": [
        "tree.kindOf",
        [
          "at",
          "$a.targets",
          0
        ]
      ]
    },
    "subjectKind": {
      "args": [
        "a"
      ],
      "expr": [
        "subjectKindOf",
        [
          "at",
          "$a.targets",
          0
        ]
      ]
    },
    "subjectKindOf": {
      "args": [
        "x"
      ],
      "expr": "$x.subject.kind"
    },
    "readsAfter": {
      "args": [
        "c",
        "v",
        "m"
      ],
      "expr": [
        "and",
        [
          "=",
          "$v.kind",
          "reference"
        ],
        [
          "some",
          [
            "ownDescendants",
            [
              "enclosing",
              "$c",
              "function"
            ]
          ],
          "x",
          [
            "or",
            [
              "and",
              [
                "=",
                "$x.kind",
                "access"
              ],
              [
                "=",
                "$x.member.name",
                "$m"
              ],
              [
                "=",
                "$x.subject.kind",
                "reference"
              ],
              [
                "=",
                "$x.subject.name",
                "$v.name"
              ],
              [
                ">",
                "$x.line",
                "$c.line"
              ]
            ],
            [
              "and",
              [
                "=",
                "$x.kind",
                "reference"
              ],
              [
                "=",
                "$x.name",
                "$v.name"
              ],
              [
                "in",
                "$x.parent.kind",
                "return",
                "argument"
              ],
              [
                ">",
                "$x.line",
                "$c.line"
              ]
            ]
          ]
        ]
      ]
    }
  },
  "find": {
    "select": "assignment",
    "as": "a",
    "where": [
      "and",
      [
        "=",
        [
          "targetKind",
          "$a"
        ],
        "access"
      ],
      [
        "=",
        [
          "subjectKind",
          "$a"
        ],
        "reference"
      ]
    ],
    "let": [
      [
        "target",
        [
          "at",
          "$a.targets",
          0
        ]
      ],
      [
        "function",
        [
          "enclosing",
          "$a",
          "function"
        ]
      ],
      [
        "parameter",
        [
          "at",
          [
            "filter",
            "$function.parameters",
            "p",
            [
              "=",
              "$p.binding.name",
              "$target.subject.name"
            ]
          ],
          0
        ]
      ]
    ],
    "having": [
      "and",
      [
        "exists",
        "$parameter"
      ],
      [
        "tree.own",
        "$function"
      ],
      [
        "none",
        [
          "ownDescendants",
          "$function.body"
        ],
        "r",
        [
          "and",
          [
            "=",
            "$r.kind",
            "return"
          ],
          [
            ">",
            [
              "count",
              "$r.values"
            ],
            0
          ]
        ]
      ],
      [
        "some",
        [
          "tree.callsOf",
          "$function"
        ],
        "c",
        [
          "readsAfter",
          "$c",
          [
            "tree.valueAt",
            "$c",
            [
              "position",
              "$parameter"
            ]
          ],
          "$target.member.name"
        ]
      ]
    ],
    "emit": "$function"
  }
}
