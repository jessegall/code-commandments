{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "php"
  ],
  "definitions": {
    "typesIn": {
      "args": [
        "x"
      ],
      "expr": [
        "flatten",
        [
          "list",
          [
            "heldTypes",
            "$x"
          ],
          [
            "flatten",
            [
              "map",
              [
                "filter",
                [
                  "flatten",
                  [
                    "list",
                    [
                      "list",
                      "$x"
                    ],
                    [
                      "outsideArguments",
                      "$x"
                    ]
                  ]
                ],
                "d",
                [
                  "and",
                  [
                    "=",
                    "$d.kind",
                    "reference"
                  ],
                  [
                    "exists",
                    [
                      "assignedOnce",
                      "$d"
                    ]
                  ]
                ]
              ],
              "d",
              [
                "heldTypes",
                [
                  "assignedOnce",
                  "$d"
                ]
              ]
            ]
          ]
        ]
      ]
    },
    "declaredTypes": {
      "args": [
        "f"
      ],
      "expr": [
        "map",
        [
          "filter",
          [
            "flatten",
            [
              "list",
              [
                "list",
                "$f.returnType"
              ],
              [
                "descendants",
                "$f.returnType",
                "type-expression"
              ]
            ]
          ],
          "t",
          [
            "and",
            [
              "exists",
              "$t"
            ],
            [
              "=",
              "$t.form",
              "named"
            ],
            [
              "proven",
              [
                "nonempty",
                "$t.refers"
              ]
            ]
          ]
        ],
        "t",
        "$t.refers"
      ]
    },
    "heldTypes": {
      "args": [
        "x"
      ],
      "expr": [
        "map",
        [
          "filter",
          [
            "flatten",
            [
              "list",
              [
                "list",
                "$x"
              ],
              [
                "outsideArguments",
                "$x"
              ]
            ]
          ],
          "d",
          [
            "or",
            [
              "proven",
              [
                "nonempty",
                "$d.resolved.name"
              ]
            ],
            [
              "and",
              [
                "=",
                "$d.kind",
                "reference"
              ],
              [
                "=",
                "$d.role",
                "subject"
              ],
              [
                "=",
                "$d.parent.form",
                "static"
              ],
              [
                "nonempty",
                "$d.refers"
              ]
            ]
          ]
        ],
        "d",
        [
          "case",
          [
            "proven",
            [
              "nonempty",
              "$d.resolved.name"
            ]
          ],
          {
            "true": "$d.resolved.name"
          },
          "$d.refers"
        ]
      ]
    },
    "publicMethod": {
      "args": [
        "f"
      ],
      "expr": [
        "and",
        [
          "exists",
          "$f"
        ],
        [
          "=",
          "$f.form",
          "method"
        ],
        [
          "none",
          "$f.modifiers",
          "m",
          [
            "in",
            "$m",
            "private",
            "protected"
          ]
        ]
      ]
    },
    "inController": {
      "args": [
        "f"
      ],
      "expr": [
        "some",
        [
          "list",
          [
            "enclosing",
            "$f",
            "type"
          ]
        ],
        "t",
        [
          "and",
          [
            "exists",
            "$t"
          ],
          [
            "assignable",
            "$t",
            "controller"
          ]
        ]
      ]
    },
    "outsideArguments": {
      "args": [
        "x"
      ],
      "expr": [
        "filter",
        [
          "ownDescendants",
          "$x"
        ],
        "d",
        [
          "none",
          [
            "ancestors",
            "$d"
          ],
          "a",
          [
            "and",
            [
              "=",
              "$a.kind",
              "argument"
            ],
            [
              "within",
              "$a",
              "$x"
            ],
            [
              "not",
              [
                "laravel.renders",
                "$a.parent"
              ]
            ]
          ]
        ]
      ]
    }
  },
  "relation": {
    "from": "return",
    "as": "r",
    "pipeline": [
      {
        "project": {
          "ret": "$r",
          "fn": [
            "enclosing",
            "$r",
            "function"
          ]
        }
      },
      {
        "where": [
          "publicMethod",
          "$fn"
        ]
      },
      {
        "join": "laravel-route-actions",
        "on": {
          "action": "$fn.symbol"
        },
        "as": "routed"
      },
      {
        "where": [
          "or",
          [
            "exists",
            "$routed"
          ],
          [
            "inController",
            "$fn"
          ]
        ]
      },
      {
        "expand": [
          "distinct",
          [
            "append",
            [
              "flatten",
              [
                "map",
                "$ret.values",
                "v",
                [
                  "typesIn",
                  "$v"
                ]
              ]
            ],
            [
              "declaredTypes",
              "$fn"
            ]
          ]
        ]
      },
      {
        "project": {
          "type": "$row"
        }
      }
    ]
  }
}
