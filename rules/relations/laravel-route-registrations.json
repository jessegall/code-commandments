{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "php"
  ],
  "definitions": {
    "classConstant": {
      "args": [
        "e"
      ],
      "expr": [
        "case",
        [
          "and",
          [
            "=",
            "$e.kind",
            "access"
          ],
          [
            "=",
            "$e.member.name",
            "class"
          ]
        ],
        {
          "true": "$e.subject.refers"
        },
        ""
      ]
    },
    "entryValue": {
      "args": [
        "entry"
      ],
      "expr": "$entry.value"
    },
    "methodName": {
      "args": [
        "e"
      ],
      "expr": [
        "case",
        [
          "literalIs",
          "$e",
          "string"
        ],
        {
          "true": "$e.value"
        },
        ""
      ]
    },
    "joined": {
      "args": [
        "class",
        "method"
      ],
      "expr": [
        "case",
        [
          "and",
          [
            "nonempty",
            "$class"
          ],
          [
            "nonempty",
            "$method"
          ]
        ],
        {
          "true": [
            "concat",
            "$class",
            "::",
            "$method"
          ]
        },
        ""
      ]
    },
    "arrayAction": {
      "args": [
        "v"
      ],
      "expr": [
        "case",
        [
          ">=",
          [
            "count",
            "$v.entries"
          ],
          2
        ],
        {
          "true": [
            "joined",
            [
              "classConstant",
              [
                "entryValue",
                [
                  "at",
                  "$v.entries",
                  0
                ]
              ]
            ],
            [
              "methodName",
              [
                "entryValue",
                [
                  "at",
                  "$v.entries",
                  1
                ]
              ]
            ]
          ]
        },
        ""
      ]
    },
    "action": {
      "args": [
        "v"
      ],
      "expr": [
        "case",
        "$v.kind",
        {
          "collection": [
            "coalesce",
            [
              "usesAction",
              "$v"
            ],
            [
              "arrayAction",
              "$v"
            ]
          ],
          "access": [
            "joined",
            [
              "classConstant",
              "$v"
            ],
            "__invoke"
          ],
          "literal": [
            "case",
            [
              "literalIs",
              "$v",
              "string"
            ],
            {
              "true": [
                "case",
                [
                  "contains",
                  "$v.value",
                  "@"
                ],
                {
                  "true": "$v.value"
                },
                ""
              ]
            },
            ""
          ]
        },
        ""
      ]
    },
    "usesAction": {
      "args": [
        "v"
      ],
      "expr": [
        "first",
        [
          "map",
          [
            "filter",
            "$v.entries",
            "e",
            [
              "and",
              [
                "literalEquals",
                "$e.key",
                "uses"
              ],
              [
                "literalIs",
                "$e.value",
                "string"
              ]
            ]
          ],
          "e",
          "$e.value.value"
        ]
      ]
    },
    "namespaceOf": {
      "args": [
        "c"
      ],
      "expr": [
        "join",
        [
          "map",
          [
            "laravel.groupsAround",
            "$c"
          ],
          "g",
          [
            "coalesce",
            [
              "laravel.keyedLiteral",
              "$g",
              "namespace"
            ],
            ""
          ]
        ],
        "\\"
      ]
    }
  },
  "relation": {
    "from": "call",
    "as": "c",
    "pipeline": [
      {
        "where": [
          "and",
          [
            "=",
            "$c.callee.kind",
            "access"
          ],
          [
            "in",
            "$c.callee.member.name",
            "get",
            "post",
            "put",
            "patch",
            "delete",
            "options",
            "match",
            "any"
          ],
          [
            "reportable",
            "$c"
          ]
        ]
      },
      {
        "project": {
          "anchor": "$c",
          "verb": "$c.callee.member.name",
          "actions": [
            "map",
            [
              "filter",
              [
                "map",
                "$c.arguments",
                "a",
                [
                  "action",
                  "$a.value"
                ]
              ],
              "x",
              [
                "nonempty",
                "$x"
              ]
            ],
            "x",
            [
              "case",
              [
                "contains",
                "$x",
                "@"
              ],
              {
                "true": [
                  "concat",
                  [
                    "namespaceOf",
                    "$c"
                  ],
                  "|",
                  "$x"
                ]
              },
              "$x"
            ]
          ]
        }
      },
      {
        "where": [
          "nonempty",
          "$actions"
        ]
      }
    ]
  }
}
