{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "php"
  ],
  "definitions": {
    "typesIn": {
      "args": [
        "x"
      ],
      "expr": [
        "filter",
        [
          "map",
          [
            "flatten",
            [
              "list",
              [
                "list",
                "$x"
              ],
              [
                "ownDescendants",
                "$x"
              ]
            ]
          ],
          "d",
          [
            "case",
            [
              "nonempty",
              "$d.resolved.name"
            ],
            {
              "true": "$d.resolved.name"
            },
            [
              "case",
              [
                "and",
                [
                  "=",
                  "$d.kind",
                  "reference"
                ],
                [
                  "=",
                  "$d.role",
                  "subject"
                ],
                [
                  "=",
                  "$d.parent.form",
                  "static"
                ]
              ],
              {
                "true": "$d.refers"
              },
              ""
            ]
          ]
        ],
        "n",
        [
          "nonempty",
          "$n"
        ]
      ]
    }
  },
  "relation": {
    "from": "call",
    "as": "c",
    "pipeline": [
      {
        "where": [
          "laravel.renders",
          "$c"
        ]
      },
      {
        "expand": [
          "flatten",
          [
            "map",
            "$c.arguments",
            "a",
            [
              "typesIn",
              "$a.value"
            ]
          ]
        ]
      },
      {
        "project": {
          "type": "$row"
        }
      }
    ]
  }
}
