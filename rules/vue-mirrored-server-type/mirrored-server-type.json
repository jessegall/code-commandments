{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "vue",
    "typescript"
  ],
  "sin": {
    "name": "mirrored-server-type",
    "aliases": [
      "MirroredServerTypeDetector",
      "MirroredServerType"
    ],
    "skill": "vue/mirrored-server-type",
    "description": "A hand-written TypeScript type mirrors a backend `Data` class one-to-one — two sources of truth for one contract that drift the moment the server shape changes",
    "rule": "Let the server own the shape: mark the `Data` class `#[TypeScript]`, generate the type, and import the generated one. Never hand-maintain a copy of a server contract.",
    "requires": {
      "name": "spatie/laravel-typescript-transformer",
      "ecosystem": "composer"
    },
    "reporting": {
      "crossFile": true
    }
  },
  "find": {
    "select": [
      "type",
      "alias"
    ],
    "as": "t",
    "where": [
      "and",
      [
        "in",
        "$t.file.language",
        "typescript",
        "vue"
      ],
      [
        "or",
        [
          "and",
          [
            "=",
            "$t.kind",
            "type"
          ],
          [
            "=",
            "$t.form",
            "interface"
          ]
        ],
        [
          "=",
          "$t.kind",
          "alias"
        ]
      ]
    ],
    "let": [
      [
        "names",
        [
          "typescript.fieldNames",
          "$t"
        ]
      ],
      [
        "namespace",
        [
          "typescript.namespaceOf",
          "$t"
        ]
      ]
    ],
    "having": [
      "and",
      [
        ">=",
        [
          "count",
          "$names"
        ],
        "$param.fields"
      ],
      [
        "not",
        [
          "some",
          [
            "rowsOf",
            "typescript-generated-outputs"
          ],
          "o",
          [
            "startsWith",
            "$t.file.path",
            [
              "field",
              "$o",
              "path"
            ]
          ]
        ]
      ],
      [
        "not",
        [
          "some",
          [
            "rowsOf",
            "spatie-data-contracts"
          ],
          "c",
          [
            "and",
            [
              "nonempty",
              "$namespace"
            ],
            [
              "=",
              [
                "field",
                "$c",
                "name"
              ],
              "$t.name"
            ],
            [
              "=",
              [
                "field",
                "$c",
                "namespace"
              ],
              "$namespace"
            ]
          ]
        ]
      ],
      [
        "some",
        [
          "rowsOf",
          "spatie-data-contracts"
        ],
        "c",
        [
          "mirrors",
          "$c",
          "$t.name",
          "$names",
          "$param.overlap"
        ]
      ]
    ],
    "emit": "$t"
  },
  "definitions": {
    "canon": {
      "args": [
        "x"
      ],
      "expr": [
        "lower",
        [
          "replace",
          [
            "replace",
            "$x",
            "_",
            ""
          ],
          "-",
          ""
        ]
      ]
    },
    "canonSet": {
      "args": [
        "l"
      ],
      "expr": [
        "distinct",
        [
          "map",
          "$l",
          "x",
          [
            "canon",
            "$x"
          ]
        ]
      ]
    },
    "field": {
      "args": [
        "c",
        "n"
      ],
      "expr": [
        "get",
        "$c",
        "$n"
      ]
    },
    "mirrors": {
      "args": [
        "c",
        "name",
        "names",
        "overlap"
      ],
      "expr": [
        "and",
        [
          "=",
          [
            "canon",
            "$name"
          ],
          [
            "canon",
            [
              "field",
              "$c",
              "name"
            ]
          ]
        ],
        [
          ">=",
          [
            "divide",
            [
              "count",
              [
                "intersect",
                [
                  "canonSet",
                  [
                    "field",
                    "$c",
                    "fields"
                  ]
                ],
                [
                  "canonSet",
                  "$names"
                ]
              ]
            ],
            [
              "count",
              [
                "difference",
                [
                  "union",
                  [
                    "canonSet",
                    [
                      "field",
                      "$c",
                      "fields"
                    ]
                  ],
                  [
                    "canonSet",
                    "$names"
                  ]
                ],
                [
                  "difference",
                  [
                    "canonSet",
                    [
                      "field",
                      "$c",
                      "optional"
                    ]
                  ],
                  [
                    "canonSet",
                    "$names"
                  ]
                ]
              ]
            ]
          ],
          "$overlap"
        ]
      ]
    }
  },
  "parameters": {
    "fields": {
      "type": "number",
      "default": 3,
      "description": "How many members a hand-written type has at least before it can be a copy of a server type."
    },
    "overlap": {
      "type": "number",
      "default": 0.8,
      "description": "How much of its fields a type shares with a server type, from 0 to 1, before it is a copy."
    }
  }
}
