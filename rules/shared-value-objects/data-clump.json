{
  "$schema": "commandments:generic-rule/v2",
  "engine": [
    "php",
    "python",
    "csharp",
    "typescript",
    "go"
  ],
  "sin": {
    "name": "data-clump",
    "aliases": [
      "DataClump"
    ],
    "skill": "shared/value-objects",
    "description": "The same group of scalar parameters appears on different types",
    "rule": "Pass a value that owns the group of fields.",
    "suggestion": "Introduce a value object for the group and pass it in their place."
  },
  "definitions": {
    "scalar": {
      "args": [
        "p"
      ],
      "expr": [
        "or",
        [
          "and",
          [
            "=",
            "$p.declaredType.form",
            "keyword"
          ],
          [
            "in",
            "$p.declaredType.name",
            "int",
            "integer",
            "float",
            "double",
            "decimal",
            "string",
            "str",
            "bool",
            "boolean",
            "number",
            "bigint",
            "long",
            "short",
            "byte",
            "char",
            "uint",
            "int8",
            "int16",
            "int32",
            "int64",
            "uint8",
            "uint16",
            "uint32",
            "uint64",
            "float32",
            "float64",
            "rune"
          ]
        ],
        [
          "in",
          [
            "typeCategory",
            [
              "typeOf",
              "$p"
            ]
          ],
          "text",
          "integer",
          "float",
          "boolean"
        ]
      ]
    },
    "namedConstructor": {
      "args": [
        "f"
      ],
      "expr": [
        "and",
        [
          "is",
          "$f.parent",
          "type"
        ],
        [
          "some",
          "$f.modifiers",
          "m",
          [
            "=",
            "$m",
            "static"
          ]
        ],
        [
          "or",
          [
            "=",
            "$f.returnType.refers",
            "$f.parent.symbol"
          ],
          [
            "in",
            "$f.returnType.name",
            "self",
            "static",
            "Self"
          ]
        ]
      ]
    },
    "ownerOrFile": {
      "args": [
        "f"
      ],
      "expr": [
        "case",
        [
          "exists",
          [
            "enclosing",
            "$f",
            "type"
          ]
        ],
        {
          "true": [
            "symbolOf",
            [
              "enclosing",
              "$f",
              "type"
            ]
          ]
        },
        "$f.file.path"
      ]
    },
    "scalarName": {
      "args": [
        "p"
      ],
      "expr": [
        "coalesce",
        "$p.declaredType.name",
        "$p.declaredType.refers",
        [
          "typeCategory",
          [
            "typeOf",
            "$p"
          ]
        ]
      ]
    },
    "outsideSupertype": {
      "args": [
        "f"
      ],
      "expr": [
        "some",
        [
          "list",
          [
            "enclosing",
            "$f",
            "type"
          ]
        ],
        "t",
        [
          "and",
          [
            "exists",
            "$t"
          ],
          [
            "some",
            [
              "flatten",
              [
                "list",
                "$t.bases",
                "$t.interfaces"
              ]
            ],
            "b",
            [
              "not",
              [
                "exists",
                [
                  "typeDeclaration",
                  "$b.refers"
                ]
              ]
            ]
          ]
        ]
      ]
    }
  },
  "find": {
    "from": "function",
    "as": "f",
    "pipeline": [
      {
        "reject": [
          "or",
          [
            "=",
            "$f.form",
            "constructor"
          ],
          [
            "has",
            [
              "functionRole",
              "$f"
            ],
            "override"
          ],
          [
            "namedConstructor",
            "$f"
          ],
          [
            "outsideSupertype",
            "$f"
          ],
          "$f.file.test"
        ]
      },
      {
        "project": {
          "anchor": "$f",
          "owner": [
            "ownerOrFile",
            "$f"
          ],
          "key": [
            "sort",
            [
              "map",
              [
                "filter",
                "$f.parameters",
                "p",
                [
                  "and",
                  [
                    "exists",
                    "$p.declaredType"
                  ],
                  [
                    "scalar",
                    "$p"
                  ],
                  [
                    "nonempty",
                    "$p.binding.name"
                  ]
                ]
              ],
              "p",
              [
                "pair",
                [
                  "scalarName",
                  "$p"
                ],
                "$p.binding.name"
              ]
            ]
          ]
        }
      },
      {
        "where": [
          ">=",
          [
            "count",
            "$key"
          ],
          3
        ]
      },
      {
        "groupBy": "$key"
      },
      {
        "having": [
          ">=",
          [
            "distinctCount",
            "$rows.owner"
          ],
          2
        ]
      },
      {
        "expand": "$rows"
      },
      {
        "emit": "$row.anchor"
      }
    ]
  }
}
