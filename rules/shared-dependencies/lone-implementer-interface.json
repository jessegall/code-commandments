{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "csharp",
    "go",
    "php",
    "python",
    "typescript"
  ],
  "sin": {
    "name": "lone-implementer-interface",
    "aliases": [
      "LoneImplementerInterfaceDetector",
      "LoneImplementerInterface"
    ],
    "skill": "shared/dependencies",
    "description": "An interface has only one local implementation",
    "rule": "Use the implementation directly unless the interface is a boundary.",
    "suggestion": "Use the implementation directly unless the interface is a boundary.",
    "reporting": {
      "crossFile": true
    }
  },
  "parameters": {
    "publicContracts": {
      "type": "list",
      "default": [],
      "description": "The types the project publishes as contracts, from configure's public contracts."
    },
    "contractRegistrars": {
      "type": "list",
      "default": [],
      "description": "The methods a project registers its public contracts through, Class::method, from public_contract_registrars: an interface handed to one is a published contract."
    }
  },
  "definitions": {
    "module": {
      "args": [
        "n"
      ],
      "expr": "$n.file.module"
    },
    "registered": {
      "args": [
        "r"
      ],
      "expr": [
        "some",
        [
          "ownAncestors",
          "$r"
        ],
        "a",
        [
          "and",
          [
            "=",
            "$a.kind",
            "call"
          ],
          [
            "has",
            "$param.contractRegistrars",
            [
              "concat",
              "$a.target.type",
              "::",
              "$a.target.name"
            ]
          ]
        ]
      ]
    }
  },
  "find": {
    "select": "type",
    "as": "t",
    "where": [
      "and",
      [
        "in",
        "$t.form",
        "interface",
        "protocol"
      ],
      [
        "not",
        "$t.file.test"
      ],
      [
        "some",
        "$t.writtenMembers",
        "m",
        [
          "=",
          "$m.kind",
          "function"
        ]
      ],
      [
        "none",
        "$param.publicContracts",
        "p",
        [
          "=",
          "$p",
          "$t.symbol"
        ]
      ],
      [
        "none",
        [
          "referrers",
          "$t"
        ],
        "r",
        [
          "proven",
          [
            "registered",
            "$r"
          ]
        ]
      ]
    ],
    "let": [
      [
        "concrete",
        [
          "filter",
          [
            "subtypes",
            "$t"
          ],
          "i",
          [
            "not",
            [
              "in",
              "$i.form",
              "interface",
              "protocol"
            ]
          ]
        ]
      ],
      [
        "implementing",
        [
          "filter",
          "$concrete",
          "i",
          [
            "none",
            "$concrete",
            "j",
            [
              "and",
              [
                "!=",
                "$j.symbol",
                "$i.symbol"
              ],
              [
                "isSubtype",
                "$i",
                "$j.symbol"
              ]
            ]
          ]
        ]
      ]
    ],
    "having": [
      "and",
      [
        "=",
        [
          "count",
          "$implementing"
        ],
        1
      ],
      [
        "every",
        "$implementing",
        "i",
        [
          "not",
          "$i.file.test"
        ]
      ],
      [
        "every",
        "$implementing",
        "i",
        [
          "or",
          [
            "withinModule",
            [
              "module",
              "$i"
            ],
            [
              "module",
              "$t"
            ]
          ],
          [
            "withinModule",
            [
              "module",
              "$t"
            ],
            [
              "module",
              "$i"
            ]
          ]
        ]
      ],
      [
        "every",
        [
          "filter",
          [
            "referrers",
            "$t"
          ],
          "r",
          [
            "not",
            "$r.file.test"
          ]
        ],
        "r",
        [
          "or",
          [
            "withinModule",
            [
              "module",
              "$r"
            ],
            [
              "module",
              "$t"
            ]
          ],
          [
            "withinModule",
            [
              "module",
              "$t"
            ],
            [
              "module",
              "$r"
            ]
          ]
        ]
      ]
    ],
    "emit": "$t"
  }
}
