{
  "$schema": "commandments:generic-rule/v2",
  "engine": [
    "csharp",
    "go",
    "php",
    "python",
    "typescript"
  ],
  "sin": {
    "name": "namespace-dependency",
    "aliases": [
      "NamespaceDependencyDetector",
      "NamespaceDependency",
      "csharp-namespace-dependency",
      "python-namespace-dependency"
    ],
    "skill": "shared/dependencies",
    "description": "a declared layer references a layer it may not use (the arrow points back up)",
    "rule": "Reference only DOWN the declared stack \u2014 a layer may use the layers it declared in `mayUse`, and nothing else that is declared.",
    "suggestion": "invert the arrow: take the value/contract the low layer needs, and let the high layer supply it",
    "reporting": {
      "crossFile": true
    }
  },
  "parameters": {
    "layers": {
      "type": "map",
      "default": {},
      "description": "Each declared layer and the layers it may use, set by configure's layer step: {\"layer\": [\"App\\\\Ui\\\\Shared\", [\"App\\\\Ui\\\\Elements\"]]}."
    }
  },
  "definitions": {
    "declaredLayer": {
      "args": [
        "module"
      ],
      "expr": [
        "last",
        [
          "sort",
          [
            "filter",
            [
              "keys",
              "$param.layers"
            ],
            "l",
            [
              "withinModule",
              "$module",
              "$l"
            ]
          ]
        ]
      ]
    }
  },
  "find": {
    "from": "imports",
    "as": "i",
    "pipeline": [
      {
        "where": [
          "and",
          [
            "not",
            "$i.test"
          ],
          "$i.held",
          [
            ">",
            [
              "count",
              [
                "keys",
                "$param.layers"
              ]
            ],
            0
          ]
        ]
      },
      {
        "project": {
          "anchor": "$i.anchor",
          "layer": [
            "declaredLayer",
            "$i.from"
          ],
          "to": "$i.to"
        }
      },
      {
        "where": [
          "and",
          [
            "nonempty",
            "$layer"
          ],
          [
            "nonempty",
            [
              "declaredLayer",
              "$to"
            ]
          ],
          [
            "not",
            [
              "withinModule",
              "$to",
              "$layer"
            ]
          ],
          [
            "none",
            [
              "get",
              "$param.layers",
              "$layer"
            ],
            "allowed",
            [
              "withinModule",
              "$to",
              "$allowed"
            ]
          ]
        ]
      },
      {
        "emit": "$anchor"
      }
    ]
  }
}
