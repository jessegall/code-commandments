{
  "$schema": "commandments:generic-rule/v2",
  "engine": [
    "csharp",
    "php",
    "python",
    "typescript"
  ],
  "sin": {
    "name": "constructor-side-effect",
    "aliases": [
      "ConstructorSideEffectDetector",
      "ConstructorSideEffect",
      "csharp-constructor-side-effect",
      "python-constructor-side-effect"
    ],
    "skill": "shared/fix-at-the-source",
    "description": "A constructor that performs a side effect on a collaborator and throws away the result, so simply creating the object changes something outside it.",
    "rule": "Let a constructor establish what the object IS; never let building one change anything outside it.",
    "suggestion": "Keep the collaborator as a field and act on it from the method that someone actually calls."
  },
  "find": {
    "select": "call",
    "as": "c",
    "where": [
      "and",
      [
        "=",
        "$c.parent.kind",
        "expression-statement"
      ],
      [
        "=",
        "$c.callee.kind",
        "access"
      ]
    ],
    "let": [
      [
        "constructor",
        [
          "enclosing",
          "$c",
          "function"
        ]
      ],
      [
        "receiver",
        "$c.callee.subject"
      ]
    ],
    "having": [
      "and",
      [
        "=",
        "$constructor.form",
        "constructor"
      ],
      [
        "or",
        [
          "and",
          [
            "=",
            "$receiver.kind",
            "access"
          ],
          [
            "isSelf",
            "$receiver.subject"
          ]
        ],
        [
          "and",
          [
            "=",
            "$receiver.kind",
            "reference"
          ],
          [
            "=",
            "$receiver.form",
            "name"
          ],
          [
            "some",
            "$constructor.parameters",
            "p",
            [
              "=",
              "$p.binding.name",
              "$receiver.name"
            ]
          ]
        ],
        [
          "and",
          [
            "=",
            "$receiver.kind",
            "call"
          ],
          [
            "=",
            "$receiver.callee.kind",
            "access"
          ],
          [
            "=",
            "$receiver.callee.subject.kind",
            "access"
          ],
          [
            "isSelf",
            "$receiver.callee.subject.subject"
          ]
        ],
        [
          "and",
          [
            "=",
            "$receiver.kind",
            "call"
          ],
          [
            "=",
            "$receiver.callee.kind",
            "access"
          ],
          [
            "=",
            "$receiver.callee.subject.kind",
            "reference"
          ],
          [
            "=",
            "$receiver.callee.subject.form",
            "name"
          ],
          [
            "some",
            "$constructor.parameters",
            "p",
            [
              "=",
              "$p.binding.name",
              "$receiver.callee.subject.name"
            ]
          ]
        ]
      ],
      [
        "not",
        [
          "proven",
          [
            "hasEffect",
            "$c",
            "mutates-receiver"
          ]
        ]
      ],
      [
        "not",
        [
          "and",
          [
            "=",
            "$receiver.kind",
            "access"
          ],
          [
            "builtHere",
            "$constructor",
            "$receiver.member.name"
          ]
        ]
      ],
      [
        "not",
        [
          "and",
          [
            "=",
            "$receiver.kind",
            "call"
          ],
          [
            "=",
            "$receiver.callee.subject.kind",
            "access"
          ],
          [
            "builtHere",
            "$constructor",
            "$receiver.callee.subject.member.name"
          ]
        ]
      ]
    ],
    "emit": "$c"
  },
  "definitions": {
    "builtHere": {
      "args": [
        "constructor",
        "member"
      ],
      "expr": [
        "some",
        "$constructor.body.statements",
        "s",
        [
          "and",
          [
            "=",
            "$s.kind",
            "expression-statement"
          ],
          [
            "=",
            "$s.expression.kind",
            "assignment"
          ],
          [
            "tree.selfField",
            [
              "at",
              "$s.expression.targets",
              0
            ]
          ],
          [
            "=",
            [
              "at",
              [
                "map",
                "$s.expression.targets",
                "t",
                "$t.member.name"
              ],
              0
            ],
            "$member"
          ],
          [
            "!=",
            [
              "at",
              [
                "map",
                "$s.expression.values",
                "v",
                "$v.kind"
              ],
              0
            ],
            "reference"
          ]
        ]
      ]
    }
  }
