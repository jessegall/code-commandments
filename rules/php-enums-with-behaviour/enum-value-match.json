{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "php",
    "python"
  ],
  "sin": {
    "name": "enum-value-match",
    "aliases": [
      "EnumValueMatchDetector",
      "EnumValueMatch",
      "python-enum-value-match"
    ],
    "skill": "php/enums-with-behaviour",
    "description": "A `match`/`switch` over an enum's `->value` at the call site — logic that belongs on the enum but lives elsewhere instead.",
    "rule": "Put per-case behaviour on the enum; never `match`/`switch` over its `->value` at a call site.",
    "suggestion": "A method on the backed enum (`$x->label()`, `$x->isPaid()`)."
  },
  "find": {
    "select": "dispatch",
    "as": "d",
    "where": [
      "exists",
      "$d.subject"
    ],
    "let": [
      [
        "labelled",
        [
          "filter",
          "$d.arms",
          "a",
          [
            ">",
            [
              "count",
              "$a.patterns"
            ],
            0
          ]
        ]
      ]
    ],
    "having": [
      "and",
      [
        "or",
        [
          "valueRead",
          "$d.subject"
        ],
        [
          "and",
          [
            ">",
            [
              "count",
              "$labelled"
            ],
            0
          ],
          [
            "every",
            "$labelled",
            "a",
            [
              "every",
              "$a.patterns",
              "x",
              [
                "caseValue",
                "$x.value"
              ]
            ]
          ]
        ]
      ],
      [
        "not",
        [
          "proven",
          [
            "=",
            [
              "tree.formOf",
              [
                "enclosing",
                "$d",
                "type"
              ]
            ],
            "enum"
          ]
        ]
      ]
    ],
    "emit": "$d"
  },
  "definitions": {
    "caseValue": {
      "args": [
        "x"
      ],
      "expr": [
        "proven",
        [
          "and",
          [
            "=",
            "$x.kind",
            "access"
          ],
          [
            "=",
            "$x.member.name",
            "value"
          ],
          [
            "=",
            [
              "tree.kindOf",
              [
                "declarationOf",
                "$x.subject"
              ]
            ],
            "enum-case"
          ]
        ]
      ]
    },
    "valueRead": {
      "args": [
        "x"
      ],
      "expr": [
        "proven",
        [
          "and",
          [
            "=",
            "$x.kind",
            "access"
          ],
          [
            "=",
            "$x.member.name",
            "value"
          ]
        ]
      ]
    }
  }
}
