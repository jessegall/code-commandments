{
  "$schema": "commandments:neutral-rule/v2",
  "engine": [
    "go"
  ],
  "sin": {
    "name": "comment-not-on-a-type",
    "description": "A comment anywhere but above a type: inline, above a function, above a const, inside a body.",
    "skill": "comments-only-on-types"
  },
  "find": {
    "select": "comment",
    "as": "c",
    "where": [
      "not",
      [
        "or",
        [
          "and",
          [
            "exists",
            "$c.documents"
          ],
          [
            "in",
            "$c.documents.kind",
            "type",
            "alias",
            "file",
            "module"
          ]
        ],
        [
          "and",
          [
            "exists",
            "$c.documents"
          ],
          [
            "some",
            [
              "children",
              "$c.documents"
            ],
            "k",
            [
              "=",
              "$k.kind",
              "type"
            ]
          ]
        ],
        [
          "startsWith",
          "$c.raw",
          "//go:"
        ],
        [
          "contains",
          "$c.raw",
          "Code generated"
        ],
        [
          "reads",
          "$c.text",
          "fixture-marker"
        ]
      ]
    ],
    "emit": "$c.location"
  }
}
