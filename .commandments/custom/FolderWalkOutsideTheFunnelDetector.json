{
  "$schema": "commandments:generic-rule/v2",
  "engine": [
    "go",
    "csharp",
    "php",
    "python"
  ],
  "sin": {
    "name": "folder-walk-outside-the-funnel",
    "description": "A call that lists a folder or walks it anywhere but the one funnel, package walk.",
    "skill": "one-folder-funnel"
  },
  "definitions": {
    "listsAFolder": {
      "args": [
        "c"
      ],
      "expr": [
        "or",
        [
          "matchesText",
          "$c.target.symbol",
          "^(path/filepath\\.Walk\\w*|io/fs\\.(WalkDir|ReadDir)|os\\.ReadDir|github\\.com/jessegall/code-commandments/listing\\.Of)$"
        ],
        [
          "matchesText",
          "$c.target.symbol",
          "(^|\\.)System\\.IO\\.Directory(Info)?\\.(Enumerate\\w*|Get\\w+s)\\b"
        ],
        [
          "matchesText",
          "$c.target.symbol",
          "^\\\\?(scandir|glob|opendir|readdir)$"
        ],
        [
          "matchesText",
          "$c.target.symbol",
          "^(os\\.(walk|fwalk|listdir|scandir)|glob\\.i?glob|shutil\\.copytree)$"
        ],
        [
          "and",
          [
            "=",
            "$c.kind",
            "construction"
          ],
          [
            "matchesText",
            "$c.target.type",
            "(^|\\\\)(\\w*DirectoryIterator|FilesystemIterator|GlobIterator)$"
          ]
        ]
      ]
    },
    "isTheFunnel": {
      "args": [
        "c"
      ],
      "expr": [
        "or",
        [
          "matchesText",
          "$c.file.path",
          "/(walk|listing|catalog|skill|scripts|story|fixture)/"
        ],
        [
          "matchesText",
          "$c.file.path",
          "/(bridge/bundle|cli/(warm|agents|library|doc|folder|untrack|parity)|detectors/paritytest)/"
        ],
        [
          "matchesText",
          "$c.file.path",
          "/(rule/vocabulary\\.go|bridge/roslyn/References\\.cs|bridge/php/src/(TreeCache|Declaration)\\.php|bridge/mypy/kept\\.py)$"
        ]
      ]
    }
  },
  "find": {
    "select": [
      "call",
      "construction"
    ],
    "as": "c",
    "where": [
      "and",
      [
        "listsAFolder",
        "$c"
      ],
      [
        "not",
        "$c.file.test"
      ],
      [
        "not",
        [
          "isTheFunnel",
          "$c"
        ]
      ]
    ],
    "emit": "$c"
  }
}
